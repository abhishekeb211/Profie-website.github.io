---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="404 — Page Not Found | Abhishek S. Raut"
  description="The requested page could not be located on the systems atlas."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <div class="not-found-container">
    <div class="not-found-card">
      <div class="error-code">404</div>
      <h1 class="error-title">Route Not Found</h1>
      <p class="error-desc">
        The requested system path does not exist or has been relocated within the Systems Atlas architecture.
      </p>

      <div class="error-actions">
        <a href={`${base}/`} class="btn btn-primary">
          Return to Home →
        </a>
        <a href={`${base}/projects/`} class="btn btn-secondary">
          Browse Systems Atlas
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.not-found-container {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-8) var(--space-6);
}

.not-found-card {
  max-width: 500px;
  text-align: center;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-10) var(--space-8);
  box-shadow: var(--shadow-md);
}

.error-code {
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 900;
  font-family: var(--font-mono);
  color: var(--color-primary);
  line-height: 1;
  margin-bottom: var(--space-2);
}

.error-title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-text);
  margin: 0 0 var(--space-3);
}

.error-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin: 0 0 var(--space-6);
}

.error-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  justify-content: center;
}

.btn {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-5);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: all var(--duration-fast);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: 1px solid var(--color-primary);
}

.btn-primary:hover {
  background: var(--color-primary-hover);
}

.btn-secondary {
  background: var(--color-surface-raised);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.btn-secondary:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
</style>
