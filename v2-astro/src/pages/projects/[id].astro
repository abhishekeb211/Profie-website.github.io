---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ProjectShowcaseContainer from '../../components/ProjectShowcaseContainer.astro';
import { getShowcaseForProject } from '../../data/showcaseRegistry';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.data.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const { data } = project;
const showcaseData = getShowcaseForProject(data.id);
---

<BaseLayout
  title={`${data.title} — Case Study | Abhishek S. Raut`}
  description={data.tagline}
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <article class="case-study-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}/projects/`}>Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <!-- Case Study Header -->
    <header class="case-study-header">
      <div class="meta-pills">
        <span class="stage-pill" data-stage={data.stage}>{data.stage}</span>
        <span class="domain-pill">{data.domain}</span>
        <span class="verified-pill">Verified: {data.verification_date}</span>
      </div>

      <h1 class="case-title">{data.title}</h1>
      <p class="case-tagline">{data.tagline}</p>

      <div class="role-stack-bar">
        <div class="role-box">
          <span class="label">My Role</span>
          <span class="value">{data.role}</span>
        </div>
        <div class="stack-box">
          <span class="label">Technologies</span>
          <div class="tech-pills">
            {data.stack.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </div>
      </div>

      {showcaseData.heroImage && (
        <div class="case-study-hero-frame">
          <img
            src={showcaseData.heroImage}
            alt={`${data.title} Architecture Visual Synthesis`}
            class="case-study-hero-img"
            loading="eager"
          />
          <div class="case-study-hero-backdrop">
            <span class="hero-forensic-tag">Forensic AI Architecture · {data.id}</span>
          </div>
        </div>
      )}
    </header>

    <!-- Key Metrics Grid -->
    {data.metrics && data.metrics.length > 0 && (
      <section class="metrics-section" aria-labelledby="metrics-heading">
        <h2 id="metrics-heading" class="sr-only">Key Verifiable Metrics</h2>
        <div class="metrics-grid">
          {data.metrics.map((metric) => (
            <div class="metric-card">
              <div class="metric-value">
                {metric.value}
                {metric.unit && <span class="metric-unit">{metric.unit}</span>}
              </div>
              <div class="metric-label">{metric.label}</div>
              <div class="metric-source">Source: {metric.source}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Architecture & Constraints Summary -->
    <section class="summary-section">
      <div class="summary-card">
        <h3>Architecture Overview</h3>
        <p>{data.architecture_overview}</p>
      </div>

      {data.constraints && data.constraints.length > 0 && (
        <div class="summary-card constraints-card">
          <h3>Operating Constraints</h3>
          <ul>
            {data.constraints.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <!-- Interactive Project Showcase Container (MVP, C4 Schematics, Deep Architecture Flow) -->
    <ProjectShowcaseContainer data={showcaseData} />

    <!-- Rich MDX Narrative Content -->
    <section class="prose-body">
      <Content />
    </section>

    <!-- Outbound Links & CTAs -->
    <footer class="case-study-footer">
      {data.github && (
        <a href={data.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          View Repository on GitHub ↗
        </a>
      )}
      <a href={`${base}/projects/`} class="btn btn-secondary">
        ← Back to All Projects
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
.case-study-container {
  width: 100%;
  max-width: min(95vw, 1440px);
  margin: 0 auto;
  padding: var(--space-4) var(--space-4) var(--space-10);
}

.breadcrumb-nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-6);
}

.breadcrumb-nav [aria-current="page"] {
  min-width: 0;
  overflow-wrap: anywhere;
}

.breadcrumb-nav a {
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.breadcrumb-nav a:hover {
  color: var(--color-primary);
}

.case-study-header {
  margin-bottom: var(--space-8);
}

.meta-pills {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.stage-pill {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-primary);
}

.domain-pill, .verified-pill {
  font-size: var(--text-xs);
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
}

.case-title {
  font-size: var(--text-3xl);
  font-weight: 800;
  color: var(--color-text);
  margin: 0 0 var(--space-2);
  line-height: 1.2;
}

.case-tagline {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  margin: 0 0 var(--space-6);
  line-height: 1.5;
}

.role-stack-bar {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  padding: var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

@media (min-width: 640px) {
  .role-stack-bar {
    grid-template-columns: auto 1fr;
    align-items: center;
  }
}

.role-box, .stack-box {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.role-box .label, .stack-box .label {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-secondary);
  text-transform: uppercase;
}

.role-box .value {
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text);
}

.tech-pills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.tech-tag {
  font-size: 11px;
  font-family: var(--font-mono);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 2px 8px;
  color: var(--color-text);
}

.case-study-hero-frame {
  position: relative;
  width: 100%;
  height: 280px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: var(--space-6);
  border: 1px solid var(--color-border);
  background: var(--color-surface-sunken);
  box-shadow: var(--shadow-md);
}

@media (min-width: 768px) {
  .case-study-hero-frame {
    height: 380px;
  }
}

.case-study-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.case-study-hero-backdrop {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.05) 0%, rgba(15, 23, 42, 0.8) 100%);
  display: flex;
  align-items: flex-end;
  padding: var(--space-4) var(--space-6);
}

.hero-forensic-tag {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: #38bdf8;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(8px);
  padding: 4px 12px;
  border-radius: 9999px;
  border: 1px solid rgba(56, 189, 248, 0.4);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.metrics-section {
  margin-bottom: var(--space-8);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-4);
}

.metric-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.metric-value {
  font-size: var(--text-3xl);
  font-weight: 800;
  color: var(--color-primary);
  font-family: var(--font-mono);
  line-height: 1;
}

.metric-unit {
  font-size: var(--text-lg);
  font-weight: 600;
  margin-left: 2px;
}

.metric-label {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.metric-source {
  font-size: 11px;
  color: var(--color-text-secondary);
}

.summary-section {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

@media (min-width: 640px) {
  .summary-section {
    grid-template-columns: 1fr 1fr;
  }
}

.summary-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
}

.summary-card h3 {
  margin: 0 0 var(--space-2);
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-text);
}

.summary-card p, .summary-card ul {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.summary-card ul {
  padding-left: var(--space-4);
}

.prose-body {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--color-text);
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-8);
  margin-bottom: var(--space-12);
}

.prose-body :global(h2) {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-text);
  margin: var(--space-8) 0 var(--space-3);
}

.prose-body :global(p) {
  margin-bottom: var(--space-4);
  color: var(--color-text-secondary);
}

.prose-body :global(ul), .prose-body :global(ol) {
  padding-left: var(--space-6);
  margin-bottom: var(--space-4);
  color: var(--color-text-secondary);
}

.prose-body :global(li) {
  margin-bottom: var(--space-2);
}

.case-study-footer {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  align-items: center;
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-8);
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-6);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: 1px solid var(--color-primary);
}

.btn-primary:hover {
  background: var(--color-primary-hover);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.btn-secondary:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
</style>

