---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SystemsAtlasGraph from '../../components/SystemsAtlasGraph.astro';
import { getShowcaseForProject } from '../../data/showcaseRegistry';
import AnimatedProjectSVG from '../../components/AnimatedProjectSVG.astro';
import ArchitectureExplorerModal from '../../components/ArchitectureExplorerModal.astro';

const projects = await getCollection('projects');
const base = import.meta.env.BASE_URL;

// Extract unique domains for filtering
const domains = ['All', ...new Set(projects.map((p) => p.data.domain))];

const svgVariantMap: Record<string, 'codeagent' | 'samanvay' | 'swasthya' | 'zerotrust' | 'cli-terminal'> = {
  'codeagent': 'codeagent',
  'vulrag-security': 'codeagent',
  'agentic-browser-defense': 'zerotrust',
  'hierarchical-ids': 'zerotrust',
  'swasthya-health-network': 'swasthya',
  'blockchain-ehr-bcfl': 'swasthya',
  'supper-ide': 'cli-terminal',
  'operon-extension': 'cli-terminal',
  'mc-ctvit-eeg-transformer': 'samanvay',
  'sanjaya-ai': 'samanvay'
};
---

<BaseLayout
  title="Systems & Research Projects — Abhishek S. Raut"
  description="Verified case studies and technical architectures in Agentic AI, Edge Computing, Runtime Governance, and Software Security."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <div class="projects-index-container">
    <header class="page-header">
      <div class="badge-pill">
        <span>Systems Atlas · Evidence-First Case Studies</span>
      </div>
      <h1 class="page-title">Systems & Architecture</h1>
      <p class="page-subtitle">
        Explore production prototypes, research engines, and verified agentic systems built with strict state guarantees.
      </p>
    </header>

    <!-- Forensic Audit Highlights Banner -->
    <div class="projects-audit-banner" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(30, 41, 59, 0.2) 100%); border: 1px solid var(--color-primary); border-radius: var(--radius-lg); padding: var(--space-6); margin-bottom: var(--space-8); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
      <div>
        <div class="badge-pill" style="margin-bottom: var(--space-2);">
          <span class="status-indicator"></span>
          <span>Forensic Audit Verified // 708 / 712 Live Passing Tests (99.4%)</span>
        </div>
        <h2 style="font-size: var(--text-lg); font-weight: 700; color: var(--color-text); margin: var(--space-1) 0;">
          Comprehensive Portfolio Forensic Master Report
        </h2>
        <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin: 0; max-width: 680px;">
          Exhaustive multi-project audit across 70 repositories (86,727 files, 59.4 GB). 20 flagship systems audited across 6 engineering pillars with 99.44% automated test pass rate.
        </p>
      </div>
      <a href={`${base}/COMPREHENSIVE_PORTFOLIO_FORENSIC_MASTER_REPORT.pdf`} target="_blank" rel="noopener noreferrer" style="background: var(--color-primary); color: var(--color-on-primary); border: 1px solid var(--color-primary); text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-full); font-weight: 600; font-size: var(--text-xs); white-space: nowrap; display: inline-block;">
        Download Master Report (79p PDF) ↗
      </a>
    </div>

    <!-- Client-safe domain filter pills -->
    <p class="filter-status" id="filter-status" aria-live="polite"></p>
    <div class="filter-bar" role="group" aria-label="Filter projects by domain">
      {domains.map((domain, index) => (
        <button
          type="button"
          class={`filter-btn ${index === 0 ? 'active' : ''}`}
          data-filter={domain === 'All' ? '*' : domain}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {domain}
        </button>
      ))}
    </div>

    <!-- Project Cards Grid -->
    <div class="projects-grid" id="projects-grid">
      {projects.map((project) => {
        const { data } = project;
        const showcase = getShowcaseForProject(data.id);
        const heroImage = showcase?.heroImage;
        const svgVariant = svgVariantMap[data.id];
        return (
          <article class="project-card" data-domain={data.domain}>
            {svgVariant ? (
              <a href={`${base}/projects/${data.id}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
                <div class="card-thumb-wrap card-svg-wrap">
                  <AnimatedProjectSVG variant={svgVariant} title={`${data.title} Architecture Flow`} />
                  <div class="card-thumb-overlay">
                    <span class="card-thumb-badge">Live Architecture DAG</span>
                  </div>
                </div>
              </a>
            ) : heroImage ? (
              <a href={`${base}/projects/${data.id}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
                <div class="card-thumb-wrap">
                  <img
                    src={heroImage}
                    alt=""
                    loading="lazy"
                    class="card-thumb-img"
                  />
                  <div class="card-thumb-overlay">
                    <span class="card-thumb-badge">System Blueprint</span>
                  </div>
                </div>
              </a>
            ) : null}
            <div class="card-header">
              <div class="card-pills">
                <span class="stage-tag">{data.stage}</span>
                <span class="domain-tag">{data.domain}</span>
              </div>
              <span class="verified-indicator">Verified</span>
            </div>

            <h2 class="card-title">
              <a href={`${base}/projects/${data.id}/`}>{data.title}</a>
            </h2>

            <p class="card-tagline">{data.tagline}</p>

            {data.metrics && data.metrics.length > 0 && (
              <div class="card-metrics-preview">
                <div class="metric-highlight">
                  <span class="highlight-val">
                    {data.metrics[0].value}{data.metrics[0].unit || ''}
                  </span>
                  <span class="highlight-lbl">{data.metrics[0].label}</span>
                </div>
              </div>
            )}

            <div class="card-stack">
              {data.stack.slice(0, 4).map((tech) => (
                <span class="tech-chip">{tech}</span>
              ))}
              {data.stack.length > 4 && (
                <span class="tech-chip-more">+{data.stack.length - 4}</span>
              )}
            </div>

            <div class="card-footer">
              <a href={`${base}/projects/${data.id}/`} class="card-link">
                Case Study →
              </a>
              <button
                type="button"
                class="arch-explore-trigger"
                data-project-id={data.id}
                data-project-title={data.title}
                data-project-tagline={data.tagline}
                data-project-url={`${base}/projects/${data.id}/`}
                data-dossier-id={showcase?.deepArchitecture.dossierId || 'DOS-AUDITED'}
                data-pass-rate={showcase?.deepArchitecture.testPassRate || '100% Passed'}
                data-docker-services={JSON.stringify(showcase?.deepArchitecture.dockerServices || ['service-core', 'service-api'])}
                aria-label={`Inspect ${data.title} Architecture Flow`}
              >
                Architecture ⊕
              </button>
            </div>
          </article>
        );
      })}
    </div>

    <p class="filter-empty" id="filter-empty" hidden>No case studies in this domain.</p>

    <!-- Interactive Architecture Explorer Modal -->
    <ArchitectureExplorerModal />

    <section class="catalog-atlas" aria-labelledby="catalog-atlas-title">
      <h2 id="catalog-atlas-title" class="catalog-atlas-title">Systems map</h2>
      <p class="catalog-atlas-desc">The same systems, arranged by how they depend on each other.</p>
      <SystemsAtlasGraph />
    </section>
  </div>
</BaseLayout>

<script>
  function setupProjectFilters() {
    const grid = document.getElementById('projects-grid');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const status = document.getElementById('filter-status');
    const empty = document.getElementById('filter-empty');
    if (!grid || grid.dataset.filtersBound === '1' || !filterBtns.length || !status) return;
    grid.dataset.filtersBound = '1';

    const apply = (filter: string, label: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === '*' || card.dataset.domain === filter;
        card.hidden = !match;
        if (match) shown += 1;
      });
      status.textContent = shown === 1
        ? `Showing 1 case study${filter === '*' ? '' : ` in ${label}`}`
        : `Showing ${shown} case studies${filter === '*' ? '' : ` in ${label}`}`;
      if (empty) empty.hidden = shown !== 0;
    };

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        apply(btn.dataset.filter || '*', btn.textContent?.trim() || 'this domain');
      });
    });

    const active = document.querySelector<HTMLButtonElement>('.filter-btn.active');
    apply(active?.dataset.filter || '*', active?.textContent?.trim() || 'All');
  }

  document.addEventListener('astro:page-load', setupProjectFilters);
  setupProjectFilters();
</script>

<style>
.projects-index-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--space-8) var(--space-6) var(--space-16);
}

.page-header {
  margin-bottom: var(--space-8);
  text-align: center;
}

.badge-pill {
  display: inline-flex;
  padding: var(--space-1) var(--space-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-primary);
  margin-bottom: var(--space-3);
}

.page-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  color: var(--color-text);
  margin: 0 0 var(--space-3);
}

.page-subtitle {
  max-width: 650px;
  margin: 0 auto;
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.filter-status {
  margin: 0 0 var(--space-3);
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2);
  margin-bottom: var(--space-8);
}

.filter-empty {
  margin: var(--space-6) 0 0;
  text-align: center;
  color: var(--color-text-secondary);
}

.catalog-atlas {
  margin-top: var(--space-16);
}

.catalog-atlas-title {
  margin: 0 0 var(--space-2);
  font-size: var(--text-2xl);
  color: var(--color-text);
}

.catalog-atlas-desc {
  margin: 0 0 var(--space-4);
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
}

.filter-btn {
  min-height: 40px;
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-xs);
  font-weight: 600;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
}

.filter-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.filter-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-on-primary);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: var(--space-6);
}

.projects-grid > * {
  min-width: 0;
}

.project-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: transform var(--duration-fast), border-color var(--duration-fast), box-shadow var(--duration-fast);
}

.project-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
}

.card-thumb-link {
  display: block;
  text-decoration: none;
  margin: calc(var(--space-6) * -1) calc(var(--space-6) * -1) var(--space-4) calc(var(--space-6) * -1);
  border-top-left-radius: calc(var(--radius-lg) - 1px);
  border-top-right-radius: calc(var(--radius-lg) - 1px);
  overflow: hidden;
}

.card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 160px;
  overflow: hidden;
  background: var(--color-surface-sunken);
}

.card-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform var(--duration-normal) var(--ease-default);
}

.project-card:hover .card-thumb-img {
  transform: scale(1.05);
}

.card-thumb-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.0) 25%, rgba(15, 23, 42, 0.8) 100%);
  display: flex;
  align-items: flex-end;
  padding: var(--space-2) var(--space-4);
}

.card-thumb-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #38bdf8;
  background: rgba(15, 23, 42, 0.85);
  padding: 2px 8px;
  border-radius: 9999px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.card-pills {
  display: flex;
  gap: var(--space-2);
  align-items: center;
}

.stage-tag {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-primary);
}

.domain-tag {
  font-size: 11px;
  color: var(--color-text-secondary);
}

.verified-indicator {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-success);
}

.project-card[hidden] {
  display: none !important;
}

.card-title {
  font-size: var(--text-xl);
  font-weight: 700;
  margin: 0 0 var(--space-2);
}

.card-title a {
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.card-title a:hover {
  color: var(--color-primary);
}

.card-tagline {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin: 0 0 var(--space-4);
  flex-grow: 1;
}

.card-metrics-preview {
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: var(--space-2) var(--space-3);
  margin-bottom: var(--space-4);
}

.metric-highlight {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}

.highlight-val {
  font-size: var(--text-base);
  font-weight: 800;
  font-family: var(--font-mono);
  color: var(--color-primary);
}

.highlight-lbl {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.card-stack {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-bottom: var(--space-6);
}

.tech-chip {
  font-size: 11px;
  font-family: var(--font-mono);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 2px 6px;
  color: var(--color-text-secondary);
}

.tech-chip-more {
  font-size: 11px;
  color: var(--color-text-secondary);
  align-self: center;
}

.card-footer {
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-4);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
}

.arch-explore-trigger {
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #38bdf8;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-default),
              border-color var(--duration-fast) var(--ease-default),
              color var(--duration-fast) var(--ease-default);
}

.arch-explore-trigger:hover {
  background: rgba(56, 189, 248, 0.2);
  border-color: #38bdf8;
  color: #fff;
}

.card-link {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
  transition: gap var(--duration-fast);
}

.card-link:hover {
  text-decoration: underline;
}
</style>

<script>
  function setupProjectTriggers() {
    document.querySelectorAll<HTMLButtonElement>('.arch-explore-trigger').forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        e.preventDefault();
        const data = {
          id: btn.getAttribute('data-project-id'),
          title: btn.getAttribute('data-project-title'),
          tagline: btn.getAttribute('data-project-tagline'),
          url: btn.getAttribute('data-project-url'),
          dossierId: btn.getAttribute('data-dossier-id'),
          passRate: btn.getAttribute('data-pass-rate'),
          dockerServices: JSON.parse(btn.getAttribute('data-docker-services') || '[]')
        };
        if (typeof (window as any).openArchitectureExplorer === 'function') {
          (window as any).openArchitectureExplorer(data);
        } else if (data.url) {
          window.location.href = data.url;
        }
      };
    });
  }
  setupProjectTriggers();
  document.addEventListener('astro:page-load', setupProjectTriggers);
</script>

