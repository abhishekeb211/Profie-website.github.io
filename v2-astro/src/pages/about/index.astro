---
// src/pages/about/index.astro — Biography, Personal Journey & Career
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import profile from '../../data/profile.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeHref = `${base}/resume.pdf`;
---

<BaseLayout
  title="About Abhishek S. Raut — AI Research Engineer & Systems Architect"
  description="Biography, personal motivation, institutional leadership at PCCOE Pune, and career journey of Abhishek S. Raut."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <main class="about-main-page">
    <div class="container-content">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">About</span>
      </nav>

      <!-- Biography Header -->
      <header class="about-header" data-reveal>
        <div class="badge-pill">
          <span class="status-indicator"></span>
          <span>Pune, India · AI Research Engineer &amp; PCCOE Faculty</span>
        </div>
        <h1 class="page-title">{profile.identity.name}</h1>
        <p class="role-subtitle">AI Research Engineer · Systems Architect · Student Mentor</p>

        <div class="header-action-row">
          <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Download Resume (PDF) ↗
          </a>
          <a href={`${base}/evidence/`} class="btn btn-secondary">
            Review Technical Evidence →
          </a>
        </div>
      </header>

      <!-- Section 1: Who I Am & Why I Build -->
      <section class="bio-section" data-reveal data-reveal-delay="1">
        <h2>Biography &amp; Who I Am</h2>
        <div class="bio-body">
          <p>
            I am an <strong>AI Research Engineer</strong>, systems architect, and educator based in Pune, India. I serve as faculty and researcher at Pimpri Chinchwad College of Engineering (PCCOE Pune), where I direct applied research in reliable artificial intelligence, sovereign local model routing, and edge telematics.
          </p>
          <p>
            I believe engineering is fundamentally about building systems that serve people with predictable guarantees. Beyond authoring code, I serve as Faculty In-charge of the <strong>PCCOE Coding Club</strong>, guiding over 500 active student developers, and the <strong>Institute Motorsports Club</strong>, advising telemetry and vehicle data acquisition.
          </p>
        </div>
      </section>

      <!-- Section 2: Why I Build -->
      <section class="bio-section" data-reveal data-reveal-delay="1">
        <h2>Engineering Philosophy &amp; Why I Build</h2>
        <div class="bio-body">
          <p>
            My motivation is not simply making AI more powerful. I want to understand how it can be made <strong>reliable, private, and human-centered enough to operate in the real world</strong>. Modern foundation models are impressive in benchmarks, but when deployed into production, they often introduce unpredictable regressions, opaque security vectors, and fragile third-party cloud dependencies.
          </p>
          <p>
            My work focuses on <strong>sovereign edge intelligence</strong>: building autonomous closed-loop program repair (CodeAgent/VulRAG), host-side zero-trust mediation proxies (Agentic Browser Defense), and deterministic sub-millisecond vehicular telemetry ingestion (VehicleGPT C++20). Across 70 audited repositories (86,727 files, 59.4 GB), every novel architecture I design is supported by reproducible empirical evidence: 708 automated test passes (99.44% pass rate) and open-source verification harnesses.
          </p>
        </div>
      </section>

      <!-- Section 3: What I Work On (4 Domains) -->
      <section class="domains-section" data-reveal data-reveal-delay="2">
        <h2>What I Work On</h2>
        <div class="about-domains-grid">
          <div class="domain-card domain-card-security interactive-card">
            <span class="domain-icon">🛡️</span>
            <h4>Software Security</h4>
            <p>Autonomous tools that find and repair code vulnerabilities locally, protecting proprietary code without sending IP to external clouds.</p>
          </div>
          <div class="domain-card domain-card-health interactive-card">
            <span class="domain-icon">🏥</span>
            <h4>Digital Healthcare</h4>
            <p>Clinical decision-support and triage tools for frontline healthcare workers across 20+ village centers in rural Maharashtra.</p>
          </div>
          <div class="domain-card domain-card-mobility interactive-card">
            <span class="domain-icon">🚗</span>
            <h4>Connected Mobility</h4>
            <p>Deterministic edge systems processing 100k+ vehicle sensor messages per second under a strict 12W power ceiling with zero data loss.</p>
          </div>
          <div class="domain-card domain-card-edu interactive-card">
            <span class="domain-icon">🎓</span>
            <h4>Engineering Education</h4>
            <p>Mentoring the next generation of engineers through competitive programming, hackathons, and research publication guidance.</p>
          </div>
        </div>
      </section>

      <!-- Section 4: Leadership & Institutional Impact -->
      <section class="leadership-section" data-reveal data-reveal-delay="2">
        <h2>Institutional Leadership &amp; Community Mentorship</h2>
        <div class="leadership-cards">
          <div class="lead-card interactive-card">
            <div class="lead-header">
              <h3>Faculty In-charge · PCCOE Coding Club</h3>
              <span class="lead-badge badge-teal">500+ Engineers</span>
            </div>
            <p>
              Directing technical mentorship, algorithm training, hackathon strategy, and open-source contributions for over 500 active student developers. Students have placed in national competitions including Smart India Hackathon and competitive programming circuits.
            </p>
          </div>

          <div class="lead-card interactive-card">
            <div class="lead-header">
              <h3>Faculty In-charge · Institute Motorsports Club</h3>
              <span class="lead-badge badge-amber">Avionics &amp; Telemetry</span>
            </div>
            <p>
              Advising student automotive engineers on deterministic telemetry data acquisition (CAN bus protocol), sensor logging pipelines, and race strategy analytics for competitive electric and combustion vehicles.
            </p>
          </div>

          <div class="lead-card interactive-card">
            <div class="lead-header">
              <h3>Academic Pedagogy &amp; Practical Labs</h3>
              <span class="lead-badge badge-blue">Theory &amp; Practice</span>
            </div>
            <p>
              Lecturing in Theory of Computation (TOC), formal grammars, Turing machines, Data Exploration &amp; Analytics, and Full Stack Distributed Engineering at PCCOE Pune.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Career Progression Timeline -->
      <section class="timeline-section" data-reveal data-reveal-delay="2">
        <h2>Career Milestones &amp; Journey</h2>
        <div class="about-timeline">
          <div class="timeline-item">
            <div class="item-year">2023–Present</div>
            <div class="item-content">
              <h4>AI Research Engineer &amp; Innovation Lead</h4>
              <span class="item-org">PCCOE Pune</span>
              <p>Directing multi-agent closed-loop repair research, sovereign local LLMs, and real-time vehicular telematics.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="item-year">2022–Present</div>
            <div class="item-content">
              <h4>Faculty In-charge</h4>
              <span class="item-org">PCCOE Coding Club</span>
              <p>Mentoring 500+ student developers across algorithm optimization, hackathon systems, and AI platforms.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="item-year">2021–Present</div>
            <div class="item-content">
              <h4>Faculty In-charge</h4>
              <span class="item-org">Institute-Level Motorsports Club</span>
              <p>Advising high-speed sensor acquisition, CAN network telemetry, and electronic vehicle control.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 6: Purposeful Collaboration & Contact -->
      <section class="contact-section" data-reveal data-reveal-delay="3">
        <div class="contact-box interactive-card">
          <span class="section-tag badge-cyan">Connect</span>
          <h2>Direct Collaboration &amp; Inquiries</h2>
          <p>Open for applied AI research partnerships, systems architecture consultations, and institutional mentorship.</p>
          <div class="contact-links">
            <a href={`mailto:${profile.identity.email}`} class="btn btn-primary">
              <Icon name="mail" />
              {profile.identity.email}
            </a>
            <a href={profile.identity.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <Icon name="linkedin" />
              LinkedIn Profile ↗
            </a>
            <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <Icon name="github" />
              GitHub Profile ↗
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer slot="footer" class="site-footer">
    <div class="container-content footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut · Systems &amp; AI Engineering</p>
      <div class="footer-links">
        <a href="#top">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .about-main-page {
    padding: var(--space-6) 0 var(--space-16);
    min-height: calc(100vh - 80px);
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-primary);
  }

  .about-header {
    margin-bottom: var(--space-8);
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.02em;
  }

  .role-subtitle {
    font-size: var(--text-base);
    color: var(--color-primary);
    font-family: var(--font-mono);
    margin: 0 0 var(--space-5) 0;
  }

  .header-action-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Bio Sections */
  .bio-section {
    margin-bottom: var(--space-8);
  }

  .bio-section h2,
  .domains-section h2,
  .leadership-section h2,
  .timeline-section h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .bio-body p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .bio-body strong {
    color: var(--color-text);
  }

  /* What I Work On Domains Grid */
  .domains-section {
    margin-bottom: var(--space-8);
  }

  .about-domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-4);
  }

  .domain-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-fast) var(--ease-default), border-color var(--duration-fast), box-shadow var(--duration-fast);
  }

  .domain-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .domain-card-security { border-top: 3px solid var(--domain-security); }
  .domain-card-security:hover { border-color: var(--domain-security); box-shadow: 0 10px 24px -4px var(--domain-security-glow); }
  .domain-card-security h4 { color: var(--domain-security); }

  .domain-card-health { border-top: 3px solid var(--domain-health); }
  .domain-card-health:hover { border-color: var(--domain-health); box-shadow: 0 10px 24px -4px var(--domain-health-glow); }
  .domain-card-health h4 { color: var(--domain-health); }

  .domain-card-mobility { border-top: 3px solid var(--domain-mobility); }
  .domain-card-mobility:hover { border-color: var(--domain-mobility); box-shadow: 0 10px 24px -4px var(--domain-mobility-glow); }
  .domain-card-mobility h4 { color: var(--domain-mobility); }

  .domain-card-edu { border-top: 3px solid var(--domain-edu); }
  .domain-card-edu:hover { border-color: var(--domain-edu); box-shadow: 0 10px 24px -4px var(--domain-edu-glow); }
  .domain-card-edu h4 { color: var(--domain-edu); }

  .domain-icon {
    font-size: 24px;
    margin-bottom: var(--space-2);
  }

  .domain-card h4 {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-1) 0;
  }

  .domain-card p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Leadership Cards */
  .leadership-section {
    margin-bottom: var(--space-8);
  }

  .leadership-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lead-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition: transform var(--duration-fast) var(--ease-default), border-color var(--duration-fast), box-shadow var(--duration-fast);
  }

  .lead-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .lead-card:nth-child(1) { border-top: 3px solid var(--domain-edu); }
  .lead-card:nth-child(1):hover { border-color: var(--domain-edu); box-shadow: 0 10px 24px -4px var(--domain-edu-glow); }

  .lead-card:nth-child(2) { border-top: 3px solid var(--domain-mobility); }
  .lead-card:nth-child(2):hover { border-color: var(--domain-mobility); box-shadow: 0 10px 24px -4px var(--domain-mobility-glow); }

  .lead-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .lead-header h3 {
    font-size: var(--text-base);
    color: var(--color-text);
    margin: 0;
  }

  .lead-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .lead-card p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Timeline */
  .timeline-section {
    margin-bottom: var(--space-8);
  }

  .about-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-5);
    margin-left: var(--space-2);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: calc(var(--space-5) * -1 - 6px);
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-bg);
  }

  .timeline-item:nth-child(1)::before { background: var(--domain-security); box-shadow: 0 0 10px var(--domain-security-glow); }
  .timeline-item:nth-child(1) .item-year { color: var(--domain-security); }

  .timeline-item:nth-child(2)::before { background: var(--domain-edu); box-shadow: 0 0 10px var(--domain-edu-glow); }
  .timeline-item:nth-child(2) .item-year { color: var(--domain-edu); }

  .timeline-item:nth-child(3)::before { background: var(--domain-mobility); box-shadow: 0 0 10px var(--domain-mobility-glow); }
  .timeline-item:nth-child(3) .item-year { color: var(--domain-mobility); }

  .timeline-item:nth-child(4)::before { background: var(--domain-health); box-shadow: 0 0 10px var(--domain-health-glow); }
  .timeline-item:nth-child(4) .item-year { color: var(--domain-health); }

  .timeline-item:nth-child(5)::before { background: var(--domain-systems); box-shadow: 0 0 10px var(--domain-systems-glow); }
  .timeline-item:nth-child(5) .item-year { color: var(--domain-systems); }

  .item-year {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  .item-content h4 {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0 0 2px 0;
  }

  .item-org {
    display: inline-block;
    font-size: 11px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .item-content p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Contact Box */
  .contact-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    text-align: center;
  }

  .contact-box h2 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0;
    color: var(--color-text);
  }

  .contact-box p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Badges & Buttons */
  .badge-teal {
    background: rgba(20, 184, 166, 0.12);
    color: #14b8a6;
    border: 1px solid rgba(20, 184, 166, 0.3);
  }

  .badge-amber {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .badge-blue {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border: 1px solid var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
  }

  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-6) 0;
    background: var(--color-surface);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-links a {
    color: var(--color-primary);
    text-decoration: none;
  }
</style>
