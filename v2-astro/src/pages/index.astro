---
// src/pages/index.astro — AI Architect persona
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EvidenceStrip from '../components/EvidenceStrip.astro';
import Hero3DScene from '../components/Hero3DScene.astro';
import HeroAgenticGraph from '../components/HeroAgenticGraph.astro';
import ScrollArchitectureLine from '../components/ScrollArchitectureLine.astro';
import ArchitectureExplorerModal from '../components/ArchitectureExplorerModal.astro';
import TelemetryMetrics from '../components/TelemetryMetrics.astro';
import CapabilityConstellation from '../components/CapabilityConstellation.astro';
import NeuralHUDTicker from '../components/NeuralHUDTicker.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const allProjects = projectEntries.map(e => e.data);

// Curated Top 4 Flagship Systems for the Home Experience
const flagshipIds = ['codeagent', 'vehiclegpt', 'agentic-browser-defense', 'mc-ctvit-eeg-transformer'];
const flagshipProjects = flagshipIds
  .map(id => allProjects.find(p => p.id === id))
  .filter(Boolean);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Abhishek S. Raut — AI Research Engineer & Systems Architect"
  description="Architecting reliable, trustworthy, and verifiable AI systems. Sovereign code remediation, deterministic edge telemetry, host-side agent mediation, and decoupled neural attention."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <!-- Scroll-Driven Pipeline Line (Visual Backbone) -->
  <ScrollArchitectureLine />

  <!-- High-Tech Live Telemetry Ticker -->
  <NeuralHUDTicker />

  <!-- Hero Section -->
  <section id="about" class="section hero-section">
    <!-- Ambient Canvas for Hacker Grid Visualization -->
    <canvas id="ambient-canvas"></canvas>

    <div class="container hero-grid">
      <div class="hero-content" data-reveal>
        <div class="badge-pill">
          <span class="status-indicator"></span>
          <span>Pune, India · Trustworthy AI Systems</span>
        </div>

        <h1 class="hero-title">
          Building Reliable<br/>
          <span class="text-gradient">AI Systems</span>
        </h1>
        
        <p class="hero-subtitle">
          AI Research Engineer // Secure Intelligence & Agentic Loops
        </p>

        <p class="hero-bio">
          Architecting trustworthy, agentic, and edge AI systems bridging research rigor with production guarantees. Specializing in deterministic vehicular telemetry, host-side runtime mediation, and decoupled neural attention. Faculty In-charge of the PCCOE Coding Club and Institute Motorsports Club.
        </p>

        <div class="hero-actions">
          <a href={`${base}/projects/`} class="btn btn-primary">
            Explore 19 Systems →
          </a>
          <a href={`${base}/evidence/`} class="btn btn-secondary">
            Inspect Evidence (708 Checks) ↗
          </a>
          <a href={`${base}/lab/`} class="btn btn-ghost">
            Systems Lab ⚡
          </a>
        </div>

        <!-- Living Visual Telemetry Metrics -->
        <div data-reveal data-reveal-delay="2">
          <TelemetryMetrics variant="hero" />
        </div>
      </div>

      <div class="hero-image-wrap" data-reveal data-reveal-delay="1">
        <!-- Professional Transparent Studio Portrait with Adaptive Glow -->
        <div class="portrait-container interactive-card">
          <picture>
            <source srcset={`${base}/images/abhishek-portrait.webp`} type="image/webp" />
            <img 
              src={`${base}/images/abhishek-portrait.png`} 
              alt="Abhishek S. Raut — AI Research Engineer" 
              class="portrait-img"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="portrait-badge">
            <span class="portrait-badge-title">Trustworthy AI</span>
            <span class="portrait-badge-sub">Edge & Cloud Architect</span>
          </div>
        </div>

        <!-- Signature Living Agentic-AI Architecture DAG -->
        <HeroAgenticGraph />
      </div>
    </div>

    <!-- 3D Interactive Agentic Loop State Machine -->
    <div class="hero-3d-stage" data-reveal data-reveal-delay="2">
      <Hero3DScene />
    </div>
  </section>

  <!-- Slim High-Credibility Evidence Strip -->
  <EvidenceStrip />

  <!-- Featured Work: Top 4 Flagships -->
  <section id="projects" class="section section-projects">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-teal">Flagship Implementations</span>
        <h2 class="section-title">Production & Research Systems</h2>
        <p class="section-desc">
          Four signature architectures spanning autonomous program repair, deterministic edge telemetry, host-side runtime mediation, and decoupled neural attention.
        </p>
      </div>

      <div class="projects-grid">
        {flagshipProjects.map((proj, idx) => (
          <div data-reveal data-reveal-delay={String((idx % 2) + 1)}>
            <ProjectCard project={proj} />
          </div>
        ))}
      </div>

      <div class="projects-actions" data-reveal style="text-align: center; margin-top: var(--space-8);">
        <a href={`${base}/projects/`} class="btn btn-secondary btn-large">
          Explore All 19 Systems & Architecture Dossiers →
        </a>
      </div>
    </div>
  </section>

  <!-- Dual Teaser Section: AI Systems Lab & Systems Atlas -->
  <section class="section section-teasers">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-cyan">Architecture & Exploration</span>
        <h2 class="section-title">Interactive Systems Cockpit & Topology</h2>
        <p class="section-desc">
          Test core architectural innovations live in your browser, or traverse multi-system dependency graphs across all 19 production and research platforms.
        </p>
      </div>

      <div class="teaser-grid" data-reveal data-reveal-delay="1">
        <!-- Teaser 1: AI Engineering Lab -->
        <div class="teaser-card interactive-card">
          <div class="teaser-card-badge badge-teal">Live Micro-Simulators</div>
          <h3 class="teaser-card-title">AI Engineering Lab</h3>
          <p class="teaser-card-desc">
            Directly test deterministic CAN ring buffers (106,934 fps), evaluate 8-tuple HMAC token gating (0.0377 ms), calculate quad-branch EEG tensor reductions (99.9%), and simulate angle-aware satellite gap healing.
          </p>
          <ul class="teaser-feature-list">
            <li><span>VehicleGPT:</span> C++20 SCHED_FIFO 0.24ms jitter ring buffer</li>
            <li><span>Agent Defense:</span> Zero-replay 8-tuple cryptographic gating</li>
            <li><span>MC-CTViT:</span> 99.95% FLOP reduction decoupled attention</li>
          </ul>
          <a href={`${base}/lab/`} class="btn btn-primary teaser-btn">
            Launch Interactive Cockpit →
          </a>
        </div>

        <!-- Teaser 2: Systems Atlas -->
        <div class="teaser-card interactive-card">
          <div class="teaser-card-badge badge-blue">Interactive Topology</div>
          <h3 class="teaser-card-title">Systems Atlas Constellation</h3>
          <p class="teaser-card-desc">
            Interactive knowledge graph mapping dependencies, shared memory middleware, and security governance boundaries across Abhishek's entire multi-system R&D ecosystem.
          </p>
          <ul class="teaser-feature-list">
            <li><span>Cluster Mapping:</span> Agentic, Security, Neural, and Edge clusters</li>
            <li><span>Dependency Graph:</span> Inter-system pipelines & memory middleware</li>
            <li><span>Lineage Inspection:</span> Hardware constraints & verification dossiers</li>
          </ul>
          <a href={`${base}/atlas/`} class="btn btn-secondary teaser-btn">
            Explore Systems Atlas Graph →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability Constellation Section -->
  <section class="section section-constellation">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-violet">Engineering Topology</span>
        <h2 class="section-title">Core Technical Disciplines</h2>
        <p class="section-desc">
          Full-stack architectural coverage from bare-metal kernel drivers to distributed multi-agent consensus.
        </p>
      </div>

      <div data-reveal data-reveal-delay="1">
        <CapabilityConstellation />
      </div>
    </div>
  </section>

  <!-- Leadership & Experience -->
  <section id="experience" class="section section-experience">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-violet">Leadership & Impact</span>
        <h2 class="section-title">Roles & Institutional Contributions</h2>
      </div>

      <div class="experience-timeline" data-timeline-container>
        <div class="timeline-spine-track" aria-hidden="true">
          <div class="timeline-spine-fill" id="timeline-spine-fill"></div>
        </div>

        <div class="experience-list">
          <div class="exp-card interactive-card" data-reveal data-reveal-delay="1">
            <div class="exp-timeline-node" aria-hidden="true">
              <span class="timeline-dot"></span>
              <span class="timeline-year">2023–Pres</span>
            </div>
            <div class="exp-content-box">
              <div class="exp-header">
                <h3>AI Research Engineer</h3>
                <span class="exp-org badge-blue">PCCOE Pune</span>
              </div>
              <p class="exp-desc">
                Directing engineering research in autonomous code patching, multimodal reasoning models, and local LLM edge applications. Teaching Data Exploration and Full Stack Engineering.
              </p>
            </div>
          </div>

          <div class="exp-card interactive-card" data-reveal data-reveal-delay="2">
            <div class="exp-timeline-node" aria-hidden="true">
              <span class="timeline-dot"></span>
              <span class="timeline-year">2022–Pres</span>
            </div>
            <div class="exp-content-box">
              <div class="exp-header">
                <h3>Faculty In-charge</h3>
                <span class="exp-org badge-teal">PCCOE Coding Club</span>
              </div>
              <p class="exp-desc">
                Mentoring over 500+ student developers across algorithm optimization, hackathon systems, AI projects, and national technical challenges.
              </p>
            </div>
          </div>

          <div class="exp-card interactive-card" data-reveal data-reveal-delay="3">
            <div class="exp-timeline-node" aria-hidden="true">
              <span class="timeline-dot"></span>
              <span class="timeline-year">2021–Pres</span>
            </div>
            <div class="exp-content-box">
              <div class="exp-header">
                <h3>Faculty In-charge</h3>
                <span class="exp-org badge-amber">Institute-Level Motorsports Club</span>
              </div>
              <p class="exp-desc">
                Advising the institute motorsports team on telemetry systems, engineering strategy, and competitive vehicle design initiatives.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="experience-actions" data-reveal style="text-align: center; margin-top: var(--space-8);">
        <a href={`${base}/about/`} class="btn btn-secondary">
          Read Full Biography & Engineering Philosophy →
        </a>
      </div>
    </div>
  </section>

  <!-- Editorial Collaboration Banner -->
  <section id="contact" class="section section-contact">
    <div class="container">
      <div class="contact-box interactive-card" data-reveal>
        <span class="section-tag badge-amber">Connect</span>
        <h2>Engineering + Education + Community = Impact</h2>
        <p>Interested in trustworthy AI systems, research initiatives, or tech mentorship?</p>
        <div class="contact-links">
          <a href={`mailto:${profile.identity.email}`} class="btn btn-primary">
            <Icon name="mail" />
            {profile.identity.email}
          </a>
          <a href={profile.identity.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="linkedin" />
            LinkedIn Profile ↗
          </a>
          <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="github" />
            GitHub Profile ↗
          </a>
          <a href={`${base}/about/`} class="btn btn-ghost">
            About Abhishek →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Architecture Explorer Modal -->
  <ArchitectureExplorerModal />

  <footer slot="footer" class="site-footer">
    <div class="container footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut · Systems & AI Engineering</p>
      <div class="footer-links">
        <a href={`${base}/projects/`}>Systems</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/lab/`}>Lab</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/atlas/`}>Atlas</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/evidence/`}>Evidence</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/about/`}>About</a>
        <span aria-hidden="true">·</span>
        <a href="#about">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
.container {
  width: 100%;
  max-width: min(96vw, 1720px);
  margin: 0 auto;
  padding: 0 var(--space-4);
  position: relative;
  z-index: 2;
}

.section {
  padding: var(--space-10) 0;
  position: relative;
}

/* Hero */
.hero-section {
  padding-top: var(--space-6);
  padding-bottom: var(--space-8);
  background: var(--hero-bg-gradient);
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-6);
  align-items: center;
}

@media (min-width: 860px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
  }
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.status-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
}

.hero-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-3) 0;
  color: var(--color-text);
}

.text-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--accent-violet) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

:root[data-theme="hacker"] .text-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-success) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: var(--text-lg);
  color: var(--color-primary);
  font-weight: 600;
  font-family: var(--font-mono);
  margin: 0 0 var(--space-4) 0;
}

.hero-bio {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 680px;
  line-height: 1.6;
  margin-bottom: var(--space-6);
}

.hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-8);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-sm);
  font-weight: 600;
  border-radius: var(--radius-md);
  text-decoration: none;
  cursor: pointer;
  transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast), box-shadow var(--duration-fast);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: 1px solid var(--color-primary);
}

.btn-primary:hover {
  background: var(--color-primary-hover);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.btn-secondary:hover {
  border-color: var(--color-primary);
}

.btn-ghost {
  background: transparent;
  color: var(--color-text);
  border: 1px solid transparent;
}

.btn-ghost:hover {
  border-color: var(--color-border);
}

.btn-large {
  padding: var(--space-4) var(--space-8);
  font-size: var(--text-base);
}

/* Portrait & 3D Stage */
.hero-image-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.hero-3d-stage {
  width: 100%;
  max-width: min(96vw, 1720px);
  margin: var(--space-4) auto 0 auto;
  padding: 0 var(--space-4);
}

.portrait-container {
  position: relative;
  width: 100%;
  max-width: 340px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--color-border);
  background: radial-gradient(circle at 50% 35%, var(--color-surface-raised) 0%, var(--color-surface) 80%);
  box-shadow: var(--shadow-lg), 0 0 30px rgb(37 99 235 / 0.08);
  aspect-ratio: 4 / 5;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

:root[data-theme="dark"] .portrait-container,
:root[data-theme="hacker"] .portrait-container {
  background: radial-gradient(circle at 50% 30%, rgb(30 51 40 / 0.6) 0%, #080D0B 85%);
  box-shadow: var(--shadow-lg), 0 0 35px rgb(34 197 94 / 0.12);
  border-color: var(--color-border);
}

.portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  filter: drop-shadow(0 12px 24px rgb(0 0 0 / 0.22));
  transition: transform var(--duration-base) var(--ease-out);
}

.portrait-container:hover .portrait-img {
  transform: scale(1.03);
}

.portrait-badge {
  position: absolute;
  bottom: var(--space-3);
  left: var(--space-3);
  right: var(--space-3);
  background: rgb(15 23 42 / 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid rgb(255 255 255 / 0.15);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.portrait-badge-title {
  font-size: var(--text-xs);
  font-weight: 700;
}

.portrait-badge-sub {
  font-size: 11px;
  color: rgb(255 255 255 / 0.75);
}

/* Sections */
.section-header {
  margin-bottom: var(--space-6);
}

.section-tag {
  display: inline-block;
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 700;
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-2);
}

.section-title {
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-text);
  margin: var(--space-1) 0 var(--space-2) 0;
}

.section-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: 900px;
  line-height: 1.6;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  gap: var(--space-6);
}

.projects-grid > * {
  min-width: 0;
}

/* Teaser Section */
.section-teasers {
  background: var(--color-surface-sunken);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.teaser-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  gap: var(--space-6);
}

.teaser-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  transition: transform var(--duration-fast) var(--ease-default), border-color var(--duration-fast) var(--ease-default), box-shadow var(--duration-fast) var(--ease-default);
}

.teaser-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-border-hover);
  box-shadow: var(--shadow-lg);
}

.teaser-card-badge {
  align-self: flex-start;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-3);
}

.teaser-card-title {
  font-size: var(--text-xl);
  font-weight: 800;
  color: var(--color-text);
  margin: 0 0 var(--space-2) 0;
}

.teaser-card-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin: 0 0 var(--space-4) 0;
}

.teaser-feature-list {
  list-style: none;
  padding: 0;
  margin: 0 0 var(--space-6) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.teaser-feature-list li {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  display: flex;
  gap: var(--space-2);
}

.teaser-feature-list li span {
  font-weight: 700;
  color: var(--color-primary);
}

.teaser-btn {
  margin-top: auto;
  align-self: flex-start;
}

/* Experience Timeline */
.experience-timeline {
  position: relative;
  padding-left: var(--space-8);
}

.timeline-spine-track {
  position: absolute;
  top: 15px;
  bottom: 25px;
  left: 10px;
  width: 2px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.timeline-spine-fill {
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, #38bdf8 0%, #10b981 50%, #f59e0b 100%);
  transform-origin: top;
  transform: scaleY(0.4);
  transition: transform 0.4s ease-out;
}

.experience-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.exp-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  position: relative;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.25s ease,
              box-shadow 0.25s ease;
}

.exp-card:hover {
  transform: translateX(4px);
  border-color: var(--color-border-hover);
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
}

.exp-timeline-node {
  position: absolute;
  left: -28px;
  top: 24px;
  display: flex;
  align-items: center;
}

.timeline-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2px solid #38bdf8;
  box-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.exp-card:hover .timeline-dot {
  transform: scale(1.3);
  border-color: #10b981;
}

.timeline-year {
  display: none;
}

@media (max-width: 640px) {
  .experience-timeline {
    padding-left: var(--space-6);
  }
  .timeline-spine-track {
    left: 4px;
  }
  .exp-timeline-node {
