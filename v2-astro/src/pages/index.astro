---
// src/pages/index.astro — AI Architect persona
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Abhishek S. Raut — AI Research Engineer"
  description="AI Research Engineer at PCCOE Pune. Building trustworthy AI systems, local agentic architectures, and mentoring 500+ developers."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <!-- Hero Section -->
  <section id="about" class="section hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="badge-pill">
          <span class="status-indicator"></span>
          <span>Pune, India · Trustworthy AI</span>
        </div>
        <h1 class="hero-title">{profile.identity.name}</h1>
        <p class="hero-subtitle">{profile.identity.title}</p>
        <p class="hero-bio">
          AI Research Engineer and Faculty In-charge at PCCOE Pune. Specializing in autonomous agentic loops, local LLM orchestration (Llama 3.2), and privacy-preserving inference models. Faculty In-charge of the PCCOE Coding Club and Institute Motorsports Club.
        </p>

        <!-- Metrics Row -->
        <div class="metrics-row">
          {profile.metrics.map(m => (
            <div class="metric-card">
              <span class="metric-value">{m.value}{m.unit}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
          <div class="metric-card">
            <span class="metric-value">2</span>
            <span class="metric-label">Clubs Led</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">View Projects ↓</a>
          <a href="#contact" class="btn btn-secondary">Get in Touch</a>
        </div>
      </div>

      <div class="hero-image-wrap">
        <div class="portrait-container">
          <img 
            src={`${base}/images/Me%20Suit%20with%20white%20bg1.png`} 
            alt="Abhishek S. Raut — AI Research Engineer" 
            class="portrait-img"
            width="380"
            height="460"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="section section-projects">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Featured Work</span>
        <h2 class="section-title">Production & Research Systems</h2>
        <p class="section-desc">Key systems deployed across agentic architectures, healthcare, and air-gapped terminal developer tooling.</p>
      </div>

      <div class="projects-grid">
        {projects.map(proj => (
          <ProjectCard project={proj} />
        ))}
      </div>
    </div>
  </section>

  <!-- Experience & Leadership Section -->
  <section id="experience" class="section section-experience">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Leadership & Experience</span>
        <h2 class="section-title">Roles & Institutional Contributions</h2>
      </div>

      <div class="experience-list">
        <div class="exp-card">
          <div class="exp-header">
            <h3>AI Research Engineer</h3>
            <span class="exp-org">PCCOE Pune</span>
          </div>
          <p class="exp-desc">
            Directing engineering research in autonomous code patching, multimodal reasoning models, and local LLM edge applications. Teaching Data Exploration and Full Stack Engineering.
          </p>
        </div>

        <div class="exp-card">
          <div class="exp-header">
            <h3>Faculty In-charge</h3>
            <span class="exp-org">PCCOE Coding Club</span>
          </div>
          <p class="exp-desc">
            Mentoring over 500+ student developers across algorithm optimization, hackathon systems, AI projects, and national technical challenges.
          </p>
        </div>

        <div class="exp-card">
          <div class="exp-header">
            <h3>Faculty In-charge</h3>
            <span class="exp-org">Institute-Level Motorsports Club</span>
          </div>
          <p class="exp-desc">
            Advising the institute motorsports team on telemetry systems, engineering strategy, and competitive vehicle design initiatives.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section section-contact">
    <div class="container">
      <div class="contact-box">
        <h2>Let's Collaborate</h2>
        <p>Interested in trustworthy AI systems, research initiatives, or tech mentorship?</p>
        <div class="contact-links">
          <a href={`mailto:${profile.identity.email}`} class="btn btn-primary">
            📧 {profile.identity.email}
          </a>
          <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            GitHub Profile ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer slot="footer" class="site-footer">
    <div class="container footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut. Built with Astro & View Transitions.</p>
      <div class="footer-links">
        <a href="#about">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-6);
}

.section {
  padding: var(--space-16) 0;
}

/* Hero */
.hero-section {
  padding-top: var(--space-16);
  background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  align-items: center;
}

@media (min-width: 860px) {
  .hero-grid {
    grid-template-columns: 1.2fr 0.8fr;
  }
}

.hero-image-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}

.portrait-container {
  position: relative;
  width: 100%;
  max-width: 340px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 2px solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-lg);
  aspect-ratio: 4 / 5;
}

.portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.status-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
}

.hero-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.hero-subtitle {
  font-size: var(--text-xl);
  color: var(--color-primary);
  font-weight: 600;
  margin: 0 0 var(--space-4) 0;
}

.hero-bio {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 700px;
  line-height: 1.6;
  margin-bottom: var(--space-8);
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: var(--space-4);
  max-width: 600px;
  margin-bottom: var(--space-8);
}

.metric-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  text-align: center;
}

.metric-value {
  display: block;
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-primary);
}

.metric-label {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.hero-actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-sm);
  font-weight: 600;
  border-radius: var(--radius-md);
  text-decoration: none;
  cursor: pointer;
  transition: all var(--duration-fast);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: 1px solid var(--color-primary);
}

.btn-primary:hover {
  background: var(--color-primary-hover);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.btn-secondary:hover {
  border-color: var(--color-primary);
}

/* Sections */
.section-header {
  margin-bottom: var(--space-10);
}

.section-tag {
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-primary);
  font-weight: 700;
}

.section-title {
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-text);
  margin: var(--space-1) 0 var(--space-2) 0;
}

.section-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  max-width: 600px;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: var(--space-6);
}

/* Experience */
.experience-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.exp-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
}

.exp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.exp-header h3 {
  font-size: var(--text-lg);
  margin: 0;
  color: var(--color-text);
}

.exp-org {
  font-size: var(--text-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.exp-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin: 0;
  line-height: 1.5;
}

/* Contact */
.contact-box {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-12);
  text-align: center;
}

.contact-box h2 {
  font-size: var(--text-2xl);
  margin-bottom: var(--space-2);
  color: var(--color-text);
}

.contact-box p {
  color: var(--color-text-secondary);
  margin-bottom: var(--space-6);
}

.contact-links {
  display: flex;
  justify-content: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

/* Footer */
.site-footer {
  border-top: 1px solid var(--color-border);
  padding: var(--space-8) 0;
  background: var(--color-surface);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-links a {
  color: var(--color-primary);
  text-decoration: none;
}
</style>
