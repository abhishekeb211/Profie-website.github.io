---
// src/pages/index.astro — AI Architect persona (Human-Centered & Universally Accessible)
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EvidenceStrip from '../components/EvidenceStrip.astro';
import Hero3DScene from '../components/Hero3DScene.astro';
import HeroAgenticGraph from '../components/HeroAgenticGraph.astro';
import ScrollArchitectureLine from '../components/ScrollArchitectureLine.astro';
import ArchitectureExplorerModal from '../components/ArchitectureExplorerModal.astro';
import CapabilityConstellation from '../components/CapabilityConstellation.astro';
import NeuralHUDTicker from '../components/NeuralHUDTicker.astro';
import WorkflowPipeline from '../components/WorkflowPipeline.astro';
import ImpactVectorPlate from '../components/ImpactVectorPlate.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const allProjects = projectEntries.map(e => e.data);

// Curated Top 4 Flagship Systems for the Home Experience
const flagshipIds = ['codeagent', 'vehiclegpt', 'agentic-browser-defense', 'mc-ctvit-eeg-transformer'];
const flagshipProjects = flagshipIds
  .map(id => allProjects.find(p => p.id === id))
  .filter(Boolean);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Abhishek S. Raut — AI Research Engineer & Systems Architect"
  description="Building AI that works in the real world. Secure, reliable, and human-centered AI systems for software, healthcare, vehicles, and education."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <!-- Scroll-Driven Pipeline Line (Visual Backbone) -->
  <ScrollArchitectureLine />

  <!-- Hero Section: Human Mission & Story-Driven Architecture -->
  <section id="about" class="section hero-section">
    <!-- Ambient Canvas for Grid Visualization -->
    <canvas id="ambient-canvas"></canvas>
    <!-- Prismatic Ambient Aurora Mesh Backdrop -->
    <div class="hero-ambient-mesh" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-content" data-reveal>
        <div class="badge-pill">
          <span class="status-indicator"></span>
          <span>Pune, India · AI Research Engineer &amp; Educator</span>
        </div>

        <h1 class="hero-title">
          Building AI That<br/>
          <span class="text-gradient-prismatic">Works in the Real World</span>
        </h1>
        
        <p class="hero-subtitle">
          Secure · Reliable · Human-Centered AI
        </p>

        <p class="hero-bio">
          I build artificial intelligence systems designed for real-world constraints—where privacy, safety, and reliability cannot be compromised. My work spans automated software security, rural clinical diagnostics, real-time vehicular telemetry, and academic mentorship. Faculty In-charge of the PCCOE Coding Club and Institute Motorsports Club.
        </p>

        <div class="hero-actions">
          <a href={`${base}/projects/`} class="btn btn-primary">
            Explore My Work →
          </a>
          <a href={`${base}/about/`} class="btn btn-secondary">
            About Abhishek
          </a>
          <a href={`${base}/evidence/`} class="btn btn-ghost" title="Review 708 automated checks & empirical benchmarks">
            Technical Evidence ↗
          </a>
        </div>

        <!-- Four Human Credibility Pillars (2-Tone Domain-Coded Chips) -->
        <div class="hero-audience-chips" data-reveal data-reveal-delay="2">
          <span class="aud-chip chip-security">🛡️ Software Security</span>
          <span class="aud-chip chip-health">🏥 Digital Health</span>
          <span class="aud-chip chip-mobility">🚗 Connected Mobility</span>
          <span class="aud-chip chip-edu">🎓 500+ Students Mentored</span>
        </div>
      </div>

      <div class="hero-image-wrap" data-reveal data-reveal-delay="1">
        <!-- Professional Transparent Studio Portrait with Adaptive Glow -->
        <div class="portrait-container interactive-card">
          <picture>
            <source srcset={`${base}/images/abhishek-portrait.webp`} type="image/webp" />
            <img 
              src={`${base}/images/abhishek-portrait.png`} 
              alt="Abhishek S. Raut — AI Research Engineer & Systems Architect" 
              class="portrait-img"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="portrait-badge">
            <span class="portrait-badge-title">Abhishek S. Raut</span>
            <span class="portrait-badge-sub">AI Research Engineer · PCCOE Faculty</span>
          </div>
        </div>

        <!-- Story-Driven Living Architecture DAG: Problem -> AI -> Knowledge/Tools -> Safety -> Result -->
        <HeroAgenticGraph />
      </div>
    </div>

    <!-- 3D Interactive Agentic Loop State Machine -->
    <div class="hero-3d-stage" data-reveal data-reveal-delay="2">
      <Hero3DScene />
    </div>
  </section>

  <!-- Demoted Subtle Real-World Impact Ticker (Desktop only) -->
  <NeuralHUDTicker />

  <!-- Trust & Impact Summary Strip -->
  <EvidenceStrip />

  <!-- Where My Work Creates Impact (4 High-Level Visual Pillars) -->
  <section id="impact" class="section section-impact">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-cyan">Real-World Domains</span>
        <h2 class="section-title">Where My Work Creates Impact</h2>
        <p class="section-desc">
          Bridging mathematical research and human needs across software defense, public healthcare, intelligent vehicles, and student empowerment.
        </p>
      </div>

      <div class="impact-grid" data-reveal data-reveal-delay="1">
        <!-- Pillar 1: Software Security -->
        <div class="impact-card impact-card-security interactive-card">
          <div class="impact-plate-container">
            <ImpactVectorPlate variant="security" />
          </div>
          <span class="impact-domain">Software Security</span>
          <h3 class="impact-card-title">Fixing Vulnerabilities Before Code Ships</h3>
          <p class="impact-card-desc">
            Autonomous systems that find and repair security flaws completely offline, keeping proprietary source code safe from cloud leaks and cyber attacks.
          </p>
          <ul class="impact-stats">
            <li><strong>100%</strong> Private offline analysis</li>
            <li><strong>0 bytes</strong> Code sent to third-party clouds</li>
          </ul>
          <a href={`${base}/projects/codeagent/`} class="impact-link">Explore Security Systems →</a>
        </div>

        <!-- Pillar 2: Healthcare Access -->
        <div class="impact-card impact-card-health interactive-card">
          <div class="impact-plate-container">
            <ImpactVectorPlate variant="health" />
          </div>
          <span class="impact-domain">Digital Healthcare</span>
          <h3 class="impact-card-title">Frontline Care for Rural Communities</h3>
          <p class="impact-card-desc">
            Assisting community health workers across 20+ village centers with maternal tracking, offline clinical triage, and private medical record coordination.
          </p>
          <ul class="impact-stats">
            <li><strong>236</strong> Statutory health duties digitized</li>
            <li><strong>5-Tier</strong> Clinical tele-triage funnel</li>
          </ul>
          <a href={`${base}/projects/swasthya-health-network/`} class="impact-link">Explore Healthcare Work →</a>
        </div>

        <!-- Pillar 3: Smart Mobility -->
        <div class="impact-card impact-card-mobility interactive-card">
          <div class="impact-plate-container">
            <ImpactVectorPlate variant="mobility" />
          </div>
          <span class="impact-domain">Smart Mobility</span>
          <h3 class="impact-card-title">Intelligence Inside Connected Vehicles</h3>
          <p class="impact-card-desc">
            Deterministic real-time systems processing over 100,000 vehicle sensor signals per second on compact low-power chips without frame loss.
          </p>
          <ul class="impact-stats">
            <li><strong>100k+</strong> Sensor frames/sec zero loss</li>
            <li><strong>12W</strong> Low-power automotive envelope</li>
          </ul>
          <a href={`${base}/projects/vehiclegpt/`} class="impact-link">Explore Mobility Systems →</a>
        </div>

        <!-- Pillar 4: Engineering Education -->
        <div class="impact-card impact-card-edu interactive-card">
          <div class="impact-plate-container">
            <ImpactVectorPlate variant="education" />
          </div>
          <span class="impact-domain">Engineering Education</span>
          <h3 class="impact-card-title">Inspiring 500+ Engineers to Build</h3>
          <p class="impact-card-desc">
            Practical mentorship, algorithm training, and competitive guidance for student developers through the PCCOE Coding Club and Institute Motorsports Club.
          </p>
          <ul class="impact-stats">
            <li><strong>500+</strong> Active student developers</li>
            <li><strong>National</strong> Hackathon placement records</li>
          </ul>
          <a href={`${base}/about/`} class="impact-link">Read Mentorship Story →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work: Top 4 Flagships with Public Titles & Human Outcomes -->
  <section id="projects" class="section section-projects">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-teal">Featured Work</span>
        <h2 class="section-title">Production &amp; Research Systems</h2>
        <p class="section-desc">
          Four signature platforms built for real-world reliability, evaluated through automated testing and empirical benchmarks.
        </p>
      </div>

      <div class="projects-grid">
        {flagshipProjects.map((proj, idx) => (
          <div data-reveal data-reveal-delay={String((idx % 2) + 1)}>
            <ProjectCard project={proj} />
          </div>
        ))}
      </div>

      <div class="projects-actions" data-reveal style="text-align: center; margin-top: var(--space-8);">
        <a href={`${base}/projects/`} class="btn btn-secondary btn-large">
          Explore All 20 Production &amp; Research Systems →
        </a>
      </div>
    </div>
  </section>

  <!-- How I Work: Research to Real-World Impact Pipeline -->
  <section class="section section-workflow">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-teal">The Engineering Journey</span>
        <h2 class="section-title">From Research to Real-World Impact</h2>
        <p class="section-desc">
          Every system follows a disciplined progression—from theoretical inquiry to verified field deployment.
        </p>
      </div>

      <div data-reveal data-reveal-delay="1">
        <WorkflowPipeline />
      </div>
    </div>
  </section>

  <!-- Deep Exploration Teasers: AI Systems Lab & Systems Atlas -->
  <section class="section section-teasers">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-cyan">Interactive Systems</span>
        <h2 class="section-title">Simulate &amp; Inspect the Architecture</h2>
        <p class="section-desc">
          Test core architectural innovations live in your browser, or explore the multi-system dependency constellation.
        </p>
      </div>

      <div class="teaser-grid" data-reveal data-reveal-delay="1">
        <!-- Teaser 1: AI Engineering Lab -->
        <div class="teaser-card interactive-card">
          <div class="teaser-card-badge badge-teal">Live Micro-Simulators</div>
          <h3 class="teaser-card-title">AI Engineering Lab</h3>
          <p class="teaser-card-desc">
            Directly test deterministic CAN ring buffers (106,934 fps), evaluate 8-tuple HMAC token gating (0.0377 ms), calculate quad-branch EEG tensor reductions (99.9%), and simulate angle-aware satellite gap healing.
          </p>
          <ul class="teaser-feature-list">
            <li><span>VehicleGPT:</span> C++20 SCHED_FIFO 0.24ms jitter ring buffer</li>
            <li><span>Agent Defense:</span> Zero-replay 8-tuple cryptographic gating</li>
            <li><span>MC-CTViT:</span> 99.95% FLOP reduction decoupled attention</li>
          </ul>
          <a href={`${base}/lab/`} class="btn btn-primary teaser-btn">
            Launch Interactive Cockpit →
          </a>
        </div>

        <!-- Teaser 2: Systems Atlas -->
        <div class="teaser-card interactive-card">
          <div class="teaser-card-badge badge-blue">Interactive Topology</div>
          <h3 class="teaser-card-title">Systems Atlas Constellation</h3>
          <p class="teaser-card-desc">
            Interactive knowledge graph mapping dependencies, shared memory middleware, and security governance boundaries across Abhishek's entire multi-system R&D ecosystem.
          </p>
          <ul class="teaser-feature-list">
            <li><span>Cluster Mapping:</span> Agentic, Security, Neural, and Edge clusters</li>
            <li><span>Dependency Graph:</span> Inter-system pipelines &amp; memory middleware</li>
            <li><span>Lineage Inspection:</span> Hardware constraints &amp; verification dossiers</li>
          </ul>
          <a href={`${base}/atlas/`} class="btn btn-secondary teaser-btn">
            Explore Systems Atlas Graph →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who I Work With -->
  <section class="section section-collaborators">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-blue">Collaboration</span>
        <h2 class="section-title">Who I Work With</h2>
        <p class="section-desc">
          Partnering across industry, academia, and student communities to build trustworthy systems.
        </p>
      </div>

      <div class="collab-grid" data-reveal data-reveal-delay="1">
        <div class="collab-card interactive-card">
          <div class="collab-badge badge-blue">Industry &amp; Founders</div>
          <h4>AI Systems &amp; Applied R&amp;D</h4>
          <p>Architecting secure local intelligence, private knowledge search, and real-time edge telemetry prototypes for enterprise deployment.</p>
        </div>
        <div class="collab-card interactive-card">
          <div class="collab-badge badge-teal">Academia &amp; Labs</div>
          <h4>Joint Research &amp; Publications</h4>
          <p>Collaborating on peer-reviewed research in affective computing, post-quantum security, and decentralized learning.</p>
        </div>
        <div class="collab-card interactive-card">
          <div class="collab-badge badge-amber">Student Developers</div>
          <h4>Mentorship &amp; Hackathon Teams</h4>
          <p>Guiding student engineers through algorithm mastery, open-source contribution, and national technical competitions.</p>
        </div>
        <div class="collab-card interactive-card">
          <div class="collab-badge badge-violet">Public Institutions</div>
          <h4>Digital Health &amp; Disaster Relief</h4>
          <p>Designing robust platforms for rural public health workflows and satellite disaster routing (ISRO BAH 2026).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability Constellation Section -->
  <section class="section section-constellation">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-violet">Engineering Topology</span>
        <h2 class="section-title">Core Technical Disciplines</h2>
        <p class="section-desc">
          Full-stack architectural coverage from bare-metal kernel drivers to distributed multi-agent consensus.
        </p>
      </div>

      <div data-reveal data-reveal-delay="1">
        <CapabilityConstellation />
      </div>
    </div>
  </section>

  <!-- Featured Achievements & Recognition -->
  <section class="section section-achievements">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-amber">Milestones</span>
        <h2 class="section-title">Featured Achievements</h2>
        <p class="section-desc">
          Key milestones across national hackathons, research innovation, and student engineering outcomes.
        </p>
      </div>

      <div class="achievements-grid" data-reveal data-reveal-delay="1">
        <div class="achievement-card interactive-card">
          <span class="achieve-icon">🏆</span>
          <h4>National Hackathon Leadership</h4>
          <p>Guided PCCOE teams to competitive placements in national challenges including Smart India Hackathon (SIH Swasthya).</p>
        </div>
        <div class="achievement-card interactive-card">
          <span class="achieve-icon">🛰️</span>
          <h4>Space &amp; Disaster AI Innovation</h4>
          <p>Engineered topological road gap healing for disaster flood routing recognized in ISRO BAH 2026 initiatives.</p>
        </div>
        <div class="achievement-card interactive-card">
          <span class="achieve-icon">📦</span>
          <h4>Sovereign Open-Source Systems</h4>
          <p>Created 20 production and research systems with 708 automated tests verified across 70 repositories (59.4 GB).</p>
        </div>
        <div class="achievement-card interactive-card">
          <span class="achieve-icon">👥</span>
          <h4>500+ Engineers Mentored</h4>
          <p>Faculty In-charge of the PCCOE Coding Club and Motorsports Club, driving student career placements and competitive programming.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership & Experience -->
  <section id="experience" class="section section-experience">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-violet">Leadership &amp; Impact</span>
        <h2 class="section-title">Roles &amp; Institutional Contributions</h2>
      </div>

      <div class="experience-timeline" data-timeline-container>
        <div class="timeline-spine-track" aria-hidden="true">
          <div class="timeline-spine-fill" id="timeline-spine-fill"></div>
        </div>

        <div class="experience-list">
          <div class="exp-card interactive-card" data-reveal data-reveal-delay="1">
            <div class="exp-timeline-node" aria-hidden="true">
              <span class="timeline-dot"></span>
              <span class="timeline-year">2023–Pres</span>
            </div>
            <div class="exp-content-box">
              <div class="exp-header">
                <h3>AI Research Engineer</h3>
                <span class="exp-org badge-blue">PCCOE Pune</span>
              </div>
              <p class="exp-desc">
                Directing engineering research in autonomous code patching, multimodal reasoning models, and local LLM edge applications. Teaching Data Exploration and Full Stack Engineering.
              </p>
            </div>
          </div>

          <div class="exp-card interactive-card" data-reveal data-reveal-delay="2">
            <div class="exp-timeline-node" aria-hidden="true">
              <span class="timeline-dot"></span>
              <span class="timeline-year">2022–Pres</span>
            </div>
            <div class="exp-content-box">
              <div class="exp-header">
                <h3>Faculty In-charge</h3>
                <span class="exp-org badge-teal">PCCOE Coding Club</span>
              </div>
              <p class="exp-desc">
                Mentoring over 500+ student developers across algorithm optimization, hackathon systems, AI projects, and national technical challenges.
              </p>
            </div>
          </div>

          <div class="exp-card interactive-card" data-reveal data-reveal-delay="3">
            <div class="exp-timeline-node" aria-hidden="true">
              <span class="timeline-dot"></span>
              <span class="timeline-year">2021–Pres</span>
            </div>
            <div class="exp-content-box">
              <div class="exp-header">
                <h3>Faculty In-charge</h3>
                <span class="exp-org badge-amber">Institute-Level Motorsports Club</span>
              </div>
              <p class="exp-desc">
                Advising the institute motorsports team on telemetry systems, engineering strategy, and competitive vehicle design initiatives.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="experience-actions" data-reveal style="text-align: center; margin-top: var(--space-8);">
        <a href={`${base}/about/`} class="btn btn-secondary">
          Read Full Biography &amp; Engineering Philosophy →
        </a>
      </div>
    </div>
  </section>

  <!-- Purposeful Collaboration & Contact -->
  <section id="contact" class="section section-contact">
    <div class="container">
      <div class="contact-box interactive-card" data-reveal>
        <span class="section-tag badge-amber">Connect</span>
        <h2>Let's Build Something Meaningful Together</h2>
        <p class="contact-sub">Choose a pathway that matches your goals, or start a direct conversation.</p>
        
        <div class="contact-pathways-grid">
          <div class="pathway-card">
            <h4>Research Collaboration</h4>
            <p>Joint papers, theoretical derivations, grant proposals, and affective computing.</p>
          </div>
          <div class="pathway-card">
            <h4>Industry Projects</h4>
            <p>AI architecture advisement, sovereign edge intelligence, and telemetry systems.</p>
          </div>
          <div class="pathway-card">
            <h4>Mentorship &amp; Talks</h4>
            <p>Student hackathon coaching, technical workshops, and engineering guest lectures.</p>
          </div>
        </div>

        <div class="contact-links">
          <a href={`mailto:${profile.identity.email}`} class="btn btn-primary btn-large">
            <Icon name="mail" />
            {profile.identity.email}
          </a>
          <a href={profile.identity.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="linkedin" />
            LinkedIn Profile ↗
          </a>
          <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="github" />
            GitHub Profile ↗
          </a>
          <a href={`${base}/about/`} class="btn btn-ghost">
            About Abhishek →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Architecture Explorer Modal -->
  <ArchitectureExplorerModal />

  <footer slot="footer" class="site-footer">
    <div class="container footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut · Systems &amp; AI Engineering</p>
      <div class="footer-links">
        <a href={`${base}/projects/`}>Systems</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/lab/`}>Lab</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/atlas/`}>Atlas</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/evidence/`}>Evidence</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/about/`}>About</a>
        <span aria-hidden="true">·</span>
        <a href="#about">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
.container {
  width: 100%;
  max-width: min(96vw, 1720px);
  margin: 0 auto;
  padding: 0 var(--space-4);
  position: relative;
  z-index: 2;
}

.section {
  padding: var(--space-10) 0;
  position: relative;
}

/* Hero */
.hero-section {
  padding-top: var(--space-6);
  padding-bottom: var(--space-8);
  background: var(--hero-bg-gradient);
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-6);
  align-items: center;
}

@media (min-width: 860px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
  }
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.status-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
}

.hero-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-3) 0;
  color: var(--color-text);
}

.text-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--accent-violet) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

:root[data-theme="hacker"] .text-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-success) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: var(--text-lg);
  color: var(--color-primary);
  font-weight: 600;
  font-family: var(--font-mono);
  margin: 0 0 var(--space-4) 0;
}

.hero-bio {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 680px;
  line-height: 1.6;
  margin-bottom: var(--space-6);
}

.hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-6);
}

.hero-audience-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.aud-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-xs);
  font-weight: 600;
  padding: 5px 14px;
