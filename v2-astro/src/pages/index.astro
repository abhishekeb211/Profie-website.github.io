---
// src/pages/index.astro — AI Architect persona
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SystemsAtlasGraph from '../components/SystemsAtlasGraph.astro';
import Hero3DScene from '../components/Hero3DScene.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const projects = projectEntries.map(e => e.data);
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Abhishek S. Raut — AI Research Engineer & Innovation Lead"
  description="Building reliable, trustworthy AI systems. Research-driven architecture, secure intelligence, and scalable deployments."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <!-- Hero Section -->
  <section id="about" class="section hero-section">
    <!-- Ambient Canvas for Hacker Grid Visualization -->
    <canvas id="ambient-canvas"></canvas>

    <div class="container hero-grid">
      <div class="hero-content" data-reveal>
        <div class="badge-pill">
          <span class="status-indicator"></span>
          <span>Pune, India · Trustworthy AI Systems</span>
        </div>

        <h1 class="hero-title">
          Building Reliable<br/>
          <span class="text-gradient">AI Systems</span>
        </h1>
        
        <p class="hero-subtitle">
          AI Research Engineer // Secure Intelligence & Agentic Loops
        </p>

        <p class="hero-bio">
          Bridging research, real-world innovation, and education to build human-centric, trustworthy, and scalable AI solutions. Faculty In-charge of the PCCOE Coding Club and Institute Motorsports Club.
        </p>

        <div class="hero-actions">
          <a href={`${base}/COMPREHENSIVE_PORTFOLIO_FORENSIC_MASTER_REPORT.pdf`} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Forensic Master Report (79p PDF) ↗
          </a>
          <a href={`${base}/projects/`} class="btn btn-secondary">
            Explore 19 Case Studies →
          </a>
          <a href="#forensic-audit" class="btn btn-ghost">
            Empirical Audit Hub ↓
          </a>
        </div>

        <!-- 4 Verified Metrics with Count-up Attributes -->
        <div class="metrics-row" data-reveal data-reveal-delay="2">
          <div class="metric-card interactive-card badge-blue">
            <span class="metric-value" data-count-target="708" data-count-suffix="/712">708/712</span>
            <span class="metric-label">Passing Tests (99.4%)</span>
          </div>

          <div class="metric-card interactive-card badge-teal">
            <span class="metric-value" data-count-target="20" data-count-suffix="">20</span>
            <span class="metric-label">Flagship Systems</span>
          </div>

          <div class="metric-card interactive-card badge-violet">
            <span class="metric-value" data-count-target="70" data-count-suffix="">70</span>
            <span class="metric-label">Audited Repositories</span>
          </div>

          <div class="metric-card interactive-card badge-amber">
            <span class="metric-value" data-count-target="500" data-count-suffix="+">500+</span>
            <span class="metric-label">Students Mentored</span>
          </div>
        </div>
      </div>

      <div class="hero-image-wrap" data-reveal data-reveal-delay="1">
        <!-- Professional Transparent Studio Portrait with Adaptive Glow -->
        <div class="portrait-container interactive-card">
          <picture>
            <source srcset={`${base}/images/abhishek-portrait.webp`} type="image/webp" />
            <img 
              src={`${base}/images/abhishek-portrait.png`} 
              alt="Abhishek S. Raut — AI Research Engineer" 
              class="portrait-img"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="portrait-badge">
            <span class="portrait-badge-title">Trustworthy AI</span>
            <span class="portrait-badge-sub">Edge & Cloud Architect</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3D Interactive Agentic Loop State Machine -->
    <div class="hero-3d-stage" data-reveal data-reveal-delay="2">
      <Hero3DScene />
    </div>
  </section>

  <!-- Systems Atlas Architecture Graph Section -->
  <section id="atlas-graph" class="section section-atlas">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-blue">Interactive Architecture</span>
        <h2 class="section-title">Systems Atlas Constellation</h2>
        <p class="section-desc">
          Interactive knowledge graph mapping dependencies, memory middleware, and security governance across R&D streams. Click or tap any node to inspect system differentiators and case studies.
        </p>
      </div>

      <div data-reveal data-reveal-delay="1">
        <SystemsAtlasGraph />
      </div>
    </div>
  </section>

  <!-- Forensic Audit & Verification Hub Section -->
  <section id="forensic-audit" class="section section-audit">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-amber">Doctoral-Grade Portfolio Forensics</span>
        <h2 class="section-title">Empirical Evidence & Grand R&D Innovations</h2>
        <p class="section-desc">
          Authoritative ecosystem audit across 70 repositories (86,727 files, 59.4 GB). Verified via 708 live passing tests, 45 traceability entries, and 16 deep project dossiers.
        </p>
      </div>

      <!-- Audit Headline Cards -->
      <div class="audit-headline-grid" data-reveal data-reveal-delay="1">
        <div class="audit-stat-card interactive-card">
          <div class="audit-stat-badge badge-teal">Disposition</div>
          <div class="audit-stat-val">APPROVED</div>
          <div class="audit-stat-lbl">Defense Ready // Formal Audit Passed</div>
        </div>
        <div class="audit-stat-card interactive-card">
          <div class="audit-stat-badge badge-blue">Live Verification</div>
          <div class="audit-stat-val" data-count-target="708" data-count-suffix="/712">708 / 712</div>
          <div class="audit-stat-lbl">99.44% Automated Test Pass Rate</div>
        </div>
        <div class="audit-stat-card interactive-card">
          <div class="audit-stat-badge badge-violet">Ecosystem Footprint</div>
          <div class="audit-stat-val">70 Repos</div>
          <div class="audit-stat-lbl">86,727 Files · 59.4 GB Audited</div>
        </div>
        <div class="audit-stat-card interactive-card">
          <div class="audit-stat-badge badge-amber">Traceability Mapped</div>
          <div class="audit-stat-val">45 Entries</div>
          <div class="audit-stat-lbl">100% Traceability Audit Journal</div>
        </div>
      </div>

      <!-- Download Banner Card -->
      <div class="audit-download-banner interactive-card" data-reveal data-reveal-delay="2">
        <div class="audit-banner-content">
          <div class="badge-pill">
            <span class="status-indicator"></span>
            <span>Master Forensic Artifact // 79-Page Comprehensive Monograph</span>
          </div>
          <h3 class="audit-banner-title">Comprehensive Portfolio Forensic Master Report</h3>
          <p class="audit-banner-desc">
            Exhaustive multi-project deep forensics, feature extractions, four-axis advantage deductions, live empirical test verifications across 20 flagship systems, and 3-year strategic technology horizons (2026–2029).
          </p>
          <div class="audit-meta-row">
            <span class="meta-tag">79 Pages</span>
            <span class="meta-tag">1.06 MB PDF</span>
            <span class="meta-tag">Nov 7, 2026</span>
            <span class="meta-tag">APPROVED & DEFENSE READY</span>
          </div>
        </div>
        <div class="audit-banner-action">
          <a href={`${base}/COMPREHENSIVE_PORTFOLIO_FORENSIC_MASTER_REPORT.pdf`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">
            Download Master Report (PDF) ↗
          </a>
        </div>
      </div>

      <!-- Six Grand Architectural Innovations -->
      <div class="innovations-block" data-reveal data-reveal-delay="2">
        <div class="sub-header">
          <span class="section-tag badge-blue">Theoretical Novelties</span>
          <h3 class="subsection-title">Six Grand Architectural Breakthroughs</h3>
        </div>
        <div class="innovations-grid">
          <div class="innovation-card interactive-card">
            <div class="innovation-header">
              <span class="innovation-num">01</span>
              <span class="innovation-pillar badge-blue">Pillar 1: AI/ML</span>
            </div>
            <h4>MC-CTViT Decoupled Attention</h4>
            <p>Decouples spatial scalp topology from temporal dynamics, reducing attention memory complexity by <strong>99.9%</strong> over joint quadratic tensors while preserving electrode spatial geometries.</p>
          </div>
          <div class="innovation-card interactive-card">
            <div class="innovation-header">
              <span class="innovation-num">02</span>
              <span class="innovation-pillar badge-teal">Pillar 1: Agentic Security</span>
            </div>
            <h4>Host-Side L2/L3 Mediation Proxy</h4>
            <p>8-tuple HMAC-SHA256 capability tokens with 0.0377 ms verification, neutralizing prompt injection and tool hijacking with <strong>0.0% replay attack success</strong>.</p>
          </div>
          <div class="innovation-card interactive-card">
            <div class="innovation-header">
              <span class="innovation-num">03</span>
              <span class="innovation-pillar badge-violet">Pillar 1: Information Retrieval</span>
            </div>
            <h4>Tri-Isolated RAG Data Planes</h4>
            <p>Segregates confidential data into <code>org_vault</code>, <code>trusted_corpus</code>, and <code>rd_sandbox</code> with mathematical mutual information bounds preventing side-channel leaks.</p>
          </div>
          <div class="innovation-card interactive-card">
            <div class="innovation-header">
              <span class="innovation-num">04</span>
              <span class="innovation-pillar badge-amber">Pillar 6: Geospatial AI</span>
            </div>
            <h4>Directional Angle-Aware Gap Healing</h4>
            <p>Reconstructs continuous road topologies from occluded satellite rasters via angle-penalized DSU/MST graphs for disaster flood routing (ISRO BAH 2026).</p>
          </div>
          <div class="innovation-card interactive-card">
            <div class="innovation-header">
              <span class="innovation-num">05</span>
              <span class="innovation-pillar badge-teal">Pillar 2: Cybersecurity</span>
            </div>
            <h4>Sovereign Closed-Loop Program Repair</h4>
            <p>Multi-analyzer static consensus (Semgrep, Bandit, YARA) with local Ollama models and Tree-sitter AST validation for zero-cloud vulnerability remediation.</p>
          </div>
          <div class="innovation-card interactive-card">
            <div class="innovation-header">
              <span class="innovation-num">06</span>
              <span class="innovation-pillar badge-blue">Pillar 3: Healthcare & Blockchain</span>
            </div>
            <h4>Byzantine-Resilient PoCC Consensus</h4>
            <p>Enforces Lipschitz continuity bounds on gradient updates in decentralized healthcare federated learning, mathematically rejecting poisoned weights before block commit.</p>
          </div>
        </div>
      </div>

      <!-- Six Audited Engineering Pillars -->
      <div class="pillars-summary-block" data-reveal data-reveal-delay="3">
        <div class="sub-header">
          <span class="section-tag badge-violet">Ecosystem Registry</span>
          <h3 class="subsection-title">Six Audited Engineering Pillars</h3>
        </div>
        <div class="pillars-grid">
          <div class="pillar-row-card interactive-card">
            <div class="pillar-row-header">
              <span class="pillar-tag badge-blue">Pillar 1</span>
              <h4>AI/ML & Agentic Systems</h4>
              <span class="tier-badge tier-3">Tier 3 Production</span>
            </div>
            <p>MC-CTViT EEG Transformer (16/16 tests), TrustWise AdaptiveRag (195/197 tests), Agentic Browser Defense (6/6 tests, 0.0377ms), VehicleGPT Edge.</p>
          </div>

          <div class="pillar-row-card interactive-card">
            <div class="pillar-row-header">
              <span class="pillar-tag badge-teal">Pillar 2</span>
              <h4>Cybersecurity & Cryptography</h4>
              <span class="tier-badge tier-3">Tier 3 Production</span>
            </div>
            <p>VulRAG Local Security (multi-engine APR, PRISMA SLR), Hierarchical IDS (44/44 tests, sub-10µs gating), Post-Quantum Lattice Cryptography (NIST PQC).</p>
          </div>

          <div class="pillar-row-card interactive-card">
            <div class="pillar-row-header">
              <span class="pillar-tag badge-violet">Pillar 3</span>
              <h4>Healthcare & Decentralized Identity</h4>
              <span class="tier-badge tier-3">Tier 3 Platform</span>
            </div>
            <p>SIH Swasthya (236 statutory NHM duties, 5-tier clinical referral funnel), Blockchain-EHR & BCFL-PoCC (Solidity, IPFS, Hyperledger Fabric).</p>
          </div>

          <div class="pillar-row-card interactive-card">
            <div class="pillar-row-header">
              <span class="pillar-tag badge-amber">Pillar 4</span>
              <h4>Developer Tooling & Autonomous IDEs</h4>
              <span class="tier-badge tier-3">Tier 3 Production</span>
            </div>
            <p>Supper-IDE AMAWS v6.0 (55/55 tests in 5.87s, 80% low-cost model routing), Operon-ext (307/308 tests, Open VSX extension, visual diff review).</p>
          </div>

          <div class="pillar-row-card interactive-card">
            <div class="pillar-row-header">
              <span class="pillar-tag badge-blue">Pillar 5</span>
              <h4>Enterprise Web & Scalable Platforms</h4>
              <span class="tier-badge tier-3">Tier 3 Production</span>
            </div>
            <p>Abhishek Website (Astro v2 Islands, WebGL 3D canvas, offline PWA), Flipkart ML Anomaly Engine, Greencycle Circular Economy Platform.</p>
          </div>

          <div class="pillar-row-card interactive-card">
            <div class="pillar-row-header">
              <span class="pillar-tag badge-teal">Pillar 6</span>
              <h4>Scientific Computing & Space R&D</h4>
              <span class="tier-badge tier-3">Tier 3 Production</span>
            </div>
            <p>ISRO Route Resilience (85/86 tests, satellite flood routing, angle-aware MST), Engineering Knowledge RAG-X (SQLite FTS5 BM25, 80% RAM bounded units).</p>
          </div>
        </div>
      </div>

      <!-- 3-Year Strategic Technology Roadmap (2026–2029) -->
      <div class="roadmap-block" data-reveal data-reveal-delay="3" style="margin-top: var(--space-12);">
        <div class="sub-header">
          <span class="section-tag badge-amber">Strategic Horizons</span>
          <h3 class="subsection-title">3-Year Strategic Technology Roadmap (2026–2029)</h3>
          <p class="section-desc" style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-2);">
            Phased translation of research breakthroughs into enterprise production and national public health deployments.
          </p>
        </div>
        <div class="roadmap-grid">
          <div class="roadmap-card interactive-card">
            <span class="roadmap-phase badge-blue">2026 · Phase 1</span>
            <h4>Foundation Hardening & Consortia Pilots</h4>
            <ul class="roadmap-list">
              <li><strong>SIH Swasthya:</strong> Pilot deployment across 20 Sub-Centers in Maharashtra with offline sync.</li>
              <li><strong>Agentic Browser Defense:</strong> Open-source Host-Side Mediation Proxy as standard Anthropic MCP security plugin.</li>
              <li><strong>MC-CTViT:</strong> Publish doctoral affective computing benchmark paper with full black-box DEAP/SEED holdout metrics.</li>
            </ul>
          </div>

          <div class="roadmap-card interactive-card">
            <span class="roadmap-phase badge-teal">2027 · Phase 2</span>
            <h4>Enterprise Commercialization & Sensor Fusion</h4>
            <ul class="roadmap-list">
              <li><strong>VulRAG:</strong> Package into sovereign on-prem enterprise security appliance for defense contractors.</li>
              <li><strong>ISRO Route Resilience:</strong> Integrate Sentinel-1 SAR radar fusion for cloud/flood multi-sensor recovery.</li>
              <li><strong>TrustWise AdaptiveRag:</strong> Transition into multi-tenant enterprise intelligence platform.</li>
            </ul>
          </div>

          <div class="roadmap-card interactive-card">
            <span class="roadmap-phase badge-violet">2028–2029 · Phase 3</span>
            <h4>Sovereign Autonomy & National Scale</h4>
            <ul class="roadmap-list">
              <li><strong>Hardware Security:</strong> Implement Hardware Enclave (Nitro/SGX) cryptographic capability tokens for agents.</li>
              <li><strong>Public Health Scale:</strong> Connect Swasthya to national ABDM health backbone, scaling to 10,000+ frontline workers.</li>
              <li><strong>Post-Quantum Trust:</strong> Deploy Lattice Key Encapsulation (ML-KEM) across decentralized healthcare ledgers.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work / Projects Section -->
  <section id="projects" class="section section-projects">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-teal">Featured Work</span>
        <h2 class="section-title">Production & Research Systems</h2>
        <p class="section-desc">Auditable agentic loops, privacy-first local foundation models, and decentralized clinical triage.</p>
      </div>

      <div class="projects-grid">
        {projects.map((proj, idx) => (
          <div data-reveal data-reveal-delay={String((idx % 3) + 1)}>
            <ProjectCard project={proj} />
          </div>
        ))}
      </div>

      <div class="projects-actions" data-reveal style="text-align: center; margin-top: var(--space-8);">
        <a href={`${base}/projects/`} class="btn btn-secondary">
          Explore All Case Studies & Architecture Specs →
        </a>
      </div>
    </div>
  </section>

  <!-- Leadership & Experience -->
  <section id="experience" class="section section-experience">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag badge-violet">Leadership & Impact</span>
        <h2 class="section-title">Roles & Institutional Contributions</h2>
      </div>

      <div class="experience-list">
        <div class="exp-card interactive-card" data-reveal data-reveal-delay="1">
          <div class="exp-header">
            <h3>AI Research Engineer</h3>
            <span class="exp-org badge-blue">PCCOE Pune</span>
          </div>
          <p class="exp-desc">
            Directing engineering research in autonomous code patching, multimodal reasoning models, and local LLM edge applications. Teaching Data Exploration and Full Stack Engineering.
          </p>
        </div>

        <div class="exp-card interactive-card" data-reveal data-reveal-delay="2">
          <div class="exp-header">
            <h3>Faculty In-charge</h3>
            <span class="exp-org badge-teal">PCCOE Coding Club</span>
          </div>
          <p class="exp-desc">
            Mentoring over 500+ student developers across algorithm optimization, hackathon systems, AI projects, and national technical challenges.
          </p>
        </div>

        <div class="exp-card interactive-card" data-reveal data-reveal-delay="3">
          <div class="exp-header">
            <h3>Faculty In-charge</h3>
            <span class="exp-org badge-amber">Institute-Level Motorsports Club</span>
          </div>
          <p class="exp-desc">
            Advising the institute motorsports team on telemetry systems, engineering strategy, and competitive vehicle design initiatives.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Collaboration Banner -->
  <section id="contact" class="section section-contact">
    <div class="container">
      <div class="contact-box interactive-card" data-reveal>
        <span class="section-tag badge-amber">Connect</span>
        <h2>Engineering + Education + Community = Impact</h2>
        <p>Interested in trustworthy AI systems, research initiatives, or tech mentorship?</p>
        <div class="contact-links">
          <a href={`mailto:${profile.identity.email}`} class="btn btn-primary">
            <Icon name="mail" />
            {profile.identity.email}
          </a>
          <a href={profile.identity.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="linkedin" />
            LinkedIn Profile ↗
          </a>
          <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="github" />
            GitHub Profile ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer slot="footer" class="site-footer">
    <div class="container footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut · Systems & AI Engineering</p>
      <div class="footer-links">
        <a href="#about">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-6);
  position: relative;
  z-index: 2;
}

.section {
  padding: var(--space-16) 0;
  position: relative;
}

/* Hero */
.hero-section {
  padding-top: var(--space-20);
  background: var(--hero-bg-gradient);
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-10);
  align-items: center;
}

@media (min-width: 860px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
  }
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.status-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
}

.hero-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-3) 0;
  color: var(--color-text);
}

.text-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--accent-violet) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

:root[data-theme="hacker"] .text-gradient {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-success) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: var(--text-lg);
  color: var(--color-primary);
  font-weight: 600;
  font-family: var(--font-mono);
  margin: 0 0 var(--space-4) 0;
}

.hero-bio {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 680px;
  line-height: 1.6;
  margin-bottom: var(--space-6);
}

.hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-8);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-sm);
  font-weight: 600;
  border-radius: var(--radius-md);
  text-decoration: none;
  cursor: pointer;
  transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast), box-shadow var(--duration-fast);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border: 1px solid var(--color-primary);
}

.btn-primary:hover {
  background: var(--color-primary-hover);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.btn-secondary:hover {
  border-color: var(--color-primary);
}

.btn-ghost {
  background: transparent;
  color: var(--color-text);
  border: 1px solid transparent;
}

.btn-ghost:hover {
  border-color: var(--color-border);
}

/* Metrics Row */
.metrics-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: var(--space-4);
  max-width: 640px;
  min-width: 0;
  width: 100%;
}

.metric-card {
  border-radius: var(--radius-md);
  padding: var(--space-4);
  text-align: center;
}

.metric-value {
  display: block;
