---
// src/pages/lab/index.astro — Dedicated AI Systems Engineering Lab
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import NeuralWorkstationCockpit from '../../components/NeuralWorkstationCockpit.astro';
import Icon from '../../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="AI Engineering Lab — Interactive Micro-Simulators | Abhishek S. Raut"
  description="Test and verify Abhishek's core architectural innovations live in the browser: VehicleGPT CAN bus ring buffers, 8-tuple HMAC capability gating, MC-CTViT EEG tensor reductions, and topological satellite gap healing."
  persona="architect"
>
  <Header slot="header" activePersona="architect" />

  <main class="lab-main-page">
    <div class="container-wide">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">AI Engineering Lab</span>
      </nav>

      <!-- Lab Header -->
      <div class="lab-header" data-reveal>
        <div class="badge-pill">
          <span class="status-indicator"></span>
          <span>Interactive Micro-Simulators // Live Client-Side Runtime</span>
        </div>
        <h1 class="page-title">AI Engineering Lab</h1>
        <p class="page-subtitle">
          Interactive browser simulations derived from real system architectures. Test and verify deterministic edge ingestion, cryptographic token mediation, quad-branch attention scaling, and angle-aware graph continuity live.
        </p>

        <!-- Transparency Disclosure: Measured vs Simulated -->
        <div class="methodology-card interactive-card">
          <div class="disclosure-col">
            <span class="disclosure-tag badge-green">✓ What is Empirically Measured</span>
            <p>
              Physical hardware-in-the-loop test benches, C++20 <code>SCHED_FIFO</code> Linux kernel latencies (0.24ms), 106,934 fps CAN frame throughput under 12W, and 708 passing CI test artifacts.
            </p>
          </div>
          <div class="disclosure-divider" aria-hidden="true"></div>
          <div class="disclosure-col">
            <span class="disclosure-tag badge-cyan">⚡ What is Simulated Here</span>
            <p>
              In-browser client-side emulators executing algorithmic state transitions, 8-tuple token hashing, quadratic attention FLOP curve comparisons, and DSU/MST graph reconnection.
            </p>
          </div>
        </div>
      </div>

      <!-- Main Simulators Cockpit Component -->
      <section class="lab-stage" data-reveal data-reveal-delay="1">
        <NeuralWorkstationCockpit />
      </section>

      <!-- Bottom Navigation Links -->
      <div class="lab-footer-nav" data-reveal data-reveal-delay="2">
        <div class="nav-card interactive-card">
          <h4>Inspect Systems Atlas</h4>
          <p>Explore inter-project dependencies, shared memory middleware, and security governance.</p>
          <a href={`${base}/atlas/`}>Open Systems Atlas →</a>
        </div>
        <div class="nav-card interactive-card">
          <h4>Review Forensic Evidence</h4>
          <p>Examine 708 passing automated tests, 70 repository audit records, and benchmark hashes.</p>
          <a href={`${base}/evidence/`}>View Evidence Hub ↗</a>
        </div>
      </div>
    </div>
  </main>

  <footer slot="footer" class="site-footer">
    <div class="container-wide footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut · Systems & AI Engineering</p>
      <div class="footer-links">
        <a href="#top">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .lab-main-page {
    padding: var(--space-6) 0 var(--space-16);
    min-height: calc(100vh - 80px);
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-primary);
  }

  .lab-header {
    margin-bottom: var(--space-6);
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 860px;
    line-height: 1.6;
    margin: 0 0 var(--space-6) 0;
  }

  /* Disclosure Card */
  .methodology-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .methodology-card {
      grid-template-columns: 1fr 1px 1fr;
      align-items: center;
    }
    .disclosure-divider {
      background: var(--color-border);
      height: 100%;
      width: 1px;
    }
  }

  .disclosure-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  .disclosure-col p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .disclosure-col code {
    font-family: var(--font-mono);
    color: var(--color-primary);
    background: rgba(56, 189, 248, 0.1);
    padding: 1px 4px;
    border-radius: 3px;
  }

  .badge-green {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .badge-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .lab-stage {
    margin-bottom: var(--space-8);
  }

  /* Footer Navigation */
  .lab-footer-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .nav-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .nav-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .nav-card h4 {
    font-size: var(--text-base);
    color: var(--color-text);
    margin: 0;
  }

  .nav-card p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.5;
  }

  .nav-card a {
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    margin-top: auto;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-6) 0;
    background: var(--color-surface);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-links a {
    color: var(--color-primary);
    text-decoration: none;
  }
</style>
