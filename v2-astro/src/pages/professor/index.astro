---
// src/pages/professor/index.astro — Professor / Educator Persona
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import profile from '../../data/profile.json';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Abhishek S. Raut — Educator & Faculty In-charge"
  description="Educator, Researcher & Faculty In-charge at PCCOE Pune. Mentoring 500+ student developers across AI, Systems, and Motorsports."
  persona="professor"
>
  <Header slot="header" activePersona="professor" />

  <section class="section hero-section">
    <div class="container">
      <div class="badge-pill">
        <span>Pune, India · PCCOE Faculty</span>
      </div>
      <h1 class="hero-title">{profile.identity.name}</h1>
      <p class="hero-subtitle">Educator · Researcher · Faculty In-charge</p>
      <p class="hero-bio">
        Dedicated to engineering pedagogy, applied AI innovation, and competitive student mentorship. Faculty In-charge of the PCCOE Coding Club and the Institute-Level Motorsports Club.
      </p>

      <div class="metrics-row">
        <div class="metric-card">
          <span class="metric-value">500+</span>
          <span class="metric-label">Students Mentored</span>
        </div>
        <div class="metric-card">
          <span class="metric-value">2</span>
          <span class="metric-label">Clubs Led</span>
        </div>
        <div class="metric-card">
          <span class="metric-value">3+</span>
          <span class="metric-label">Core Courses Taught</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Courses & Pedagogy -->
  <section class="section section-courses">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Teaching & Academics</span>
        <h2 class="section-title">Courses & Practical Labs</h2>
      </div>

      <div class="grid-cards">
        <div class="card">
          <h3>Theory of Computation (TOC)</h3>
          <p>Automata theory, formal grammars, computability, Turing machines, and complexity fundamentals.</p>
        </div>
        <div class="card">
          <h3>Data Exploration & Analytics Lab</h3>
          <p>Statistical reasoning, exploratory data pipelines, hypothesis testing, and exploratory visual analysis.</p>
        </div>
        <div class="card">
          <h3>Full Stack Development Lab</h3>
          <p>Modern frontend systems, REST/GraphQL APIs, distributed persistence, and cloud container deployment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Student Clubs & Mentorship -->
  <section class="section section-clubs">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Leadership</span>
        <h2 class="section-title">Institutional Leadership & Student Clubs</h2>
      </div>

      <div class="clubs-list">
        <div class="card">
          <div class="card-head">
            <h3>PCCOE Coding Club</h3>
            <span class="badge">Faculty In-charge</span>
          </div>
          <p>
            Mentoring 500+ active students in competitive programming (ICPC, Codeforces), hackathons (Smart India Hackathon, GSoC), open-source contributions, and AI systems development.
          </p>
        </div>

        <div class="card">
          <div class="card-head">
            <h3>Institute-Level Motorsports Club</h3>
            <span class="badge">Faculty In-charge</span>
          </div>
          <p>
            Guiding student engineers in mechanical-electrical integration, onboard telemetry data acquisition, real-time sensor analytics, and competitive engineering strategy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Supervision -->
  <section class="section section-research">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Research & Inquiry</span>
        <h2 class="section-title">Active Investigation Tracks</h2>
      </div>

      <div class="grid-cards">
        <div class="card">
          <h3>Agentic Code Correction</h3>
          <p>Investigating autonomous reasoning systems for static vulnerability discovery and AST-guided auto-remediation.</p>
        </div>
        <div class="card">
          <h3>Cross-Modal Fact Verification</h3>
          <p>Multimodal transformers and graph-augmented verification for trustworthiness assessment in public data feeds.</p>
        </div>
        <div class="card">
          <h3>Edge Model Optimization</h3>
          <p>Quantization and air-gapped inference efficiency for resource-constrained client devices and pods.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact & Collaboration -->
  <section id="contact" class="section section-contact">
    <div class="container">
      <div class="card" style="text-align: center; padding: var(--space-12);">
        <span class="badge" style="margin-bottom: var(--space-2); display: inline-block;">Academic Inquiries & Research</span>
        <h2 style="font-size: var(--text-2xl); margin: var(--space-2) 0; color: var(--color-text);">Faculty Office & Collaboration</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 600px; margin-left: auto; margin-right: auto;">
          For academic mentorship, club advisory, or collaborative research publications at PCCOE Pune:
        </p>
        <div style="display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap;">
          <a href={`mailto:${profile.identity.email}`} style="display: inline-flex; align-items: center; padding: var(--space-3) var(--space-6); font-size: var(--text-sm); font-weight: 600; border-radius: var(--radius-md); text-decoration: none; background: var(--color-primary); color: var(--color-on-primary);">
            📧 {profile.identity.email}
          </a>
          <a href={profile.identity.linkedin} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; padding: var(--space-3) var(--space-6); font-size: var(--text-sm); font-weight: 600; border-radius: var(--radius-md); text-decoration: none; background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border);">
            💼 LinkedIn Profile ↗
          </a>
          <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; padding: var(--space-3) var(--space-6); font-size: var(--text-sm); font-weight: 600; border-radius: var(--radius-md); text-decoration: none; background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border);">
            💻 GitHub Profile ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer slot="footer" class="site-footer">
    <div class="container footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut. Professor & Faculty Persona.</p>
      <div class="footer-links">
        <a href="#about">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-6);
}

.section {
  padding: var(--space-16) 0;
}

.hero-section {
  padding-top: var(--space-20);
  background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
}

.badge-pill {
  display: inline-block;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.hero-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.hero-subtitle {
  font-size: var(--text-xl);
  color: var(--color-primary);
  font-weight: 600;
  margin: 0 0 var(--space-4) 0;
}

.hero-bio {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 700px;
  line-height: 1.6;
  margin-bottom: var(--space-8);
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: var(--space-4);
  max-width: 500px;
}

.metric-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  text-align: center;
}

.metric-value {
  display: block;
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-primary);
}

.metric-label {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.section-header {
  margin-bottom: var(--space-8);
}

.section-tag {
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-primary);
  font-weight: 700;
}

.section-title {
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-text);
  margin: var(--space-1) 0 0 0;
}

.grid-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-6);
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}

.card h3 {
  font-size: var(--text-lg);
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.card p {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.clubs-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.badge {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  font-size: var(--text-xs);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.site-footer {
  border-top: 1px solid var(--color-border);
  padding: var(--space-8) 0;
  background: var(--color-surface);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-links a {
  color: var(--color-primary);
  text-decoration: none;
}
</style>
