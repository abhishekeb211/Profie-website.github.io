---
// src/pages/professor/index.astro — Professor / Educator Persona
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import TelemetryMetrics from '../../components/TelemetryMetrics.astro';
import ResearchKnowledgeGraph from '../../components/ResearchKnowledgeGraph.astro';
import profile from '../../data/profile.json';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Abhishek S. Raut — Educator & Faculty In-charge"
  description="Educator, Researcher & Faculty In-charge at PCCOE Pune. Mentoring 500+ student developers across AI, Systems, and Motorsports."
  persona="professor"
>
  <Header slot="header" activePersona="professor" />

  <section id="about" class="section hero-section">
    <div class="container hero-grid">
      <div class="hero-content" data-reveal>
        <div class="badge-pill">
          <span>Pune, India · PCCOE Faculty &amp; Student Mentor</span>
        </div>
        <h1 class="hero-title">
          Inspiring Engineers to Build<br/>
          <span class="text-gradient">Systems That Matter</span>
        </h1>
        <p class="hero-subtitle">Educator · Researcher · Student Mentor</p>
        <p class="hero-bio">
          Dedicated to hands-on engineering pedagogy, bridging theoretical computer science with real-world prototypes. As Faculty In-charge of the PCCOE Coding Club and Institute Motorsports Club, I guide over 500 student developers to turn classroom concepts into working systems, research publications, and national competition victories.
        </p>

        <div class="hero-actions" style="display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-6);">
          <a href="#teaching" class="contact-btn contact-btn-primary">
            Courses &amp; Labs ↓
          </a>
          <a href="#leadership" class="contact-btn">
            Mentorship &amp; Clubs ↓
          </a>
          <a href="#research" class="contact-btn">
            Research &amp; Publications ↓
          </a>
        </div>

        <div data-reveal data-reveal-delay="2" style="margin-top: var(--space-4);">
          <TelemetryMetrics variant="professor" />
        </div>
      </div>

      <div class="hero-image-wrap" data-reveal data-reveal-delay="1">
        <div class="portrait-container">
          <picture>
            <source srcset={`${base}/images/abhishek-portrait.webp`} type="image/webp" />
            <img
              src={`${base}/images/abhishek-portrait.png`}
              alt="Abhishek S. Raut — Educator and Faculty In-charge"
              class="portrait-img"
              width="640"
              height="800"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Courses & Pedagogy -->
  <section id="teaching" class="section section-courses">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag">Teaching & Academics</span>
        <h2 class="section-title">Courses & Practical Labs</h2>
      </div>

      <div class="grid-cards">
        <div class="card" data-reveal data-reveal-delay="1">
          <h3>Theory of Computation (TOC)</h3>
          <p>Automata theory, formal grammars, computability, Turing machines, and complexity fundamentals.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="2">
          <h3>Data Exploration & Analytics Lab</h3>
          <p>Statistical reasoning, exploratory data pipelines, hypothesis testing, and exploratory visual analysis.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="3">
          <h3>Full Stack Development Lab</h3>
          <p>Modern frontend systems, REST/GraphQL APIs, distributed persistence, and cloud container deployment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Student Clubs & Mentorship -->
  <section id="leadership" class="section section-clubs">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag">Leadership</span>
        <h2 class="section-title">Institutional Leadership & Student Clubs</h2>
      </div>

      <div class="clubs-list">
        <div class="card" data-reveal data-reveal-delay="1">
          <div class="card-head">
            <h3>PCCOE Coding Club</h3>
            <span class="badge">Faculty In-charge</span>
          </div>
          <p>
            Mentoring 500+ active students in competitive programming (ICPC, Codeforces), hackathons (Smart India Hackathon, GSoC), open-source contributions, and AI systems development.
          </p>
        </div>

        <div class="card" data-reveal data-reveal-delay="2">
          <div class="card-head">
            <h3>Institute-Level Motorsports Club</h3>
            <span class="badge">Faculty In-charge</span>
          </div>
          <p>
            Guiding student engineers in mechanical-electrical integration, onboard telemetry data acquisition, real-time sensor analytics, and competitive engineering strategy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Supervision -->
  <section id="research" class="section section-research">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-tag">Research &amp; Publications</span>
        <h2 class="section-title">Active Investigation Tracks &amp; Research Monograph</h2>
        <p class="section-desc" style="color: var(--color-text-secondary); max-width: 720px; margin-top: var(--space-2);">
          Empirical systems research across Affective Computing, Agentic Security, Post-Quantum Cryptography, and Decentralized Healthcare. Backed by 708 live passing automated test suites (99.44% pass rate).
        </p>
      </div>

      <!-- Featured Research Monograph Card -->
      <div class="card forensic-hero-card" data-reveal data-reveal-delay="1" style="margin-bottom: var(--space-8); border: 1px solid var(--color-primary); background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(30, 41, 59, 0.2) 100%);">
        <div class="badge" style="margin-bottom: var(--space-2); display: inline-block;">Research Monograph // Systems &amp; Evidence</div>
        <h3 style="font-size: var(--text-xl); margin-bottom: var(--space-2); color: var(--color-text);">Comprehensive Portfolio Forensic Master Report</h3>
        <p style="color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
          79-page comprehensive research monograph covering 70 repositories (86,727 files, 59.4 GB), 16 deep project dossiers, 45 evidence journal entries, and 708 live passing unit and integration tests across 6 engineering pillars. Verification Status: <strong>708 Automated Tests Passing (99.44%)</strong>.
        </p>
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
          <a href={`${base}/COMPREHENSIVE_PORTFOLIO_FORENSIC_MASTER_REPORT.pdf`} target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn-primary">
            Download 79-Page Report (PDF) ↗
          </a>
          <span style="font-size: var(--text-xs); color: var(--color-text-secondary); font-family: var(--font-mono);">
            1.06 MB · 708/712 Tests Verified
          </span>
        </div>
      </div>

      <div class="grid-cards">
        <div class="card" data-reveal data-reveal-delay="1">
          <h3>Affective Computing & Neural Transformers</h3>
          <p>MC-CTViT quad-branch architecture for multi-channel EEG emotion classification with 99.9% attention compute reduction across DEAP, SEED, and MAHNOB-HCI.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="2">
          <h3>Agentic Runtime Security & Zero-Trust</h3>
          <p>Host-side least-privilege mediation proxies with 8-tuple HMAC-SHA256 capability tokens clocking 0.0377 ms verification and 0.0% replay attack success.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="3">
          <h3>Post-Quantum Lattice Cryptography & QRFL</h3>
          <p>Lattice-based Learning With Errors (LWE/Ring-LWE) and Byzantine-resilient Proof-of-Convergence (PoCC) consensus for quantum-safe federated learning.</p>
        </div>
      </div>

      <!-- Interactive Ecosystem R&D Knowledge Graph -->
      <div data-reveal data-reveal-delay="2" style="margin-top: var(--space-8);">
        <ResearchKnowledgeGraph />
      </div>
    </div>
  </section>

  <!-- Contact & Collaboration -->
  <section id="contact" class="section section-contact">
    <div class="container">
      <div class="card" data-reveal style="text-align: center; padding: var(--space-12);">
        <span class="badge" style="margin-bottom: var(--space-2); display: inline-block;">Academic Inquiries & Research</span>
        <h2 style="font-size: var(--text-2xl); margin: var(--space-2) 0; color: var(--color-text);">Faculty Office & Collaboration</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 600px; margin-left: auto; margin-right: auto;">
          For academic mentorship, club advisory, or collaborative research publications at PCCOE Pune:
        </p>
        <div style="display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap;">
          <a href={`mailto:${profile.identity.email}`} class="contact-btn contact-btn-primary">
            <Icon name="mail" />
            {profile.identity.email}
          </a>
          <a href={profile.identity.linkedin} target="_blank" rel="noopener noreferrer" class="contact-btn">
            <Icon name="linkedin" />
            LinkedIn Profile ↗
          </a>
          <a href={profile.identity.github} target="_blank" rel="noopener noreferrer" class="contact-btn">
            <Icon name="github" />
            GitHub Profile ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer slot="footer" class="site-footer">
    <div class="container footer-content">
      <p>© {new Date().getFullYear()} Abhishek S. Raut. Professor & Faculty Persona.</p>
      <div class="footer-links">
        <a href="#about">Top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
.container {
  width: 100%;
  max-width: min(96vw, 1720px);
  margin: 0 auto;
  padding: 0 var(--space-4);
}

.section {
  padding: var(--space-8) 0;
}

.hero-section {
  padding-top: var(--space-6);
  padding-bottom: var(--space-8);
  background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-6);
  align-items: center;
}

@media (min-width: 860px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }
}

.hero-image-wrap {
  display: flex;
  justify-content: center;
}

.portrait-container {
  width: 100%;
  max-width: 320px;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--color-border);
  background: radial-gradient(circle at 50% 35%, var(--color-surface-raised) 0%, var(--color-surface) 80%);
  box-shadow: var(--shadow-lg);
}

:root[data-theme="dark"] .portrait-container,
:root[data-theme="hacker"] .portrait-container {
  background: radial-gradient(circle at 50% 30%, rgb(30 51 40 / 0.6) 0%, #080D0B 85%);
}

.portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.contact-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  max-width: 100%;
  overflow-wrap: anywhere;
  text-align: center;
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-sm);
  font-weight: 600;
  border-radius: var(--radius-md);
  text-decoration: none;
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.contact-btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-color: var(--color-primary);
}

.badge-pill {
  display: inline-block;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-4);
}

.hero-title {
  font-size: var(--text-4xl);
  font-weight: 800;
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.hero-subtitle {
  font-size: var(--text-xl);
  color: var(--color-primary);
  font-weight: 600;
  margin: 0 0 var(--space-4) 0;
}

.hero-bio {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  max-width: 700px;
  line-height: 1.6;
  margin-bottom: var(--space-8);
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: var(--space-4);
  max-width: 500px;
  min-width: 0;
  width: 100%;
}

.metric-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  text-align: center;
}

.metric-value {
  display: block;
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-primary);
}

.metric-label {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.section-header {
  margin-bottom: var(--space-8);
}

.section-tag {
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-primary);
  font-weight: 700;
}

.section-title {
  font-size: var(--text-2xl);
  font-weight: 800;
  color: var(--color-text);
  margin: var(--space-1) 0 0 0;
}

.grid-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: var(--space-6);
}

.grid-cards > * {
  min-width: 0;
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}

.card h3 {
  font-size: var(--text-lg);
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.card p {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.clubs-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.badge {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  font-size: var(--text-xs);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.site-footer {
  border-top: 1px solid var(--color-border);
  padding: var(--space-8) 0;
  background: var(--color-surface);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-links a {
  color: var(--color-primary);
  text-decoration: none;
}
</style>
