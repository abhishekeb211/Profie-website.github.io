---
/**
 * Hero3DScene.astro — Meaningful 3D Agent Reasoning Directed Graph (Three.js)
 * Visualizes the 4-stage Agentic Reasoning Loop:
 *   [PERCEIVE] -> [PLAN] -> [EXECUTE] -> [VERIFY]
 *
 * Capabilities:
 * - 4 interactive 3D nodes with live glowing state pulses
 * - Curved spline execution pipelines with orbiting data packets
 * - Dynamic theme color lerping (Light Blueprint vs Dark Cyber-Intelligence)
 * - Interactive pointer tracking & damping
 * - Performance guardrails: Capped DPR (max 2.0), pause offscreen/hidden, reduced-motion fallback, WebGL context loss handling
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`hero-3d-container ${className}`} id="hero-3d-scene-wrapper">
  <!-- Interactive WebGL Canvas Container -->
  <div class="canvas-mount" id="hero-3d-canvas-mount" aria-hidden="true"></div>

  <!-- Telemetry Overlay Badge -->
  <div class="telemetry-badge" id="telemetry-badge">
    <span class="live-dot"></span>
    <span class="telemetry-text">Agent Loop: PERCEIVE ➔ PLAN ➔ EXECUTE ➔ VERIFY</span>
  </div>

  <!-- Interactive Node Detail Tooltip -->
  <div class="node-tooltip" id="node-tooltip" hidden>
    <div class="node-tooltip-title" id="node-tooltip-title">Agent State</div>
    <div class="node-tooltip-desc" id="node-tooltip-desc">State description</div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  function initHero3D() {
    const mount = document.getElementById('hero-3d-canvas-mount');
    const wrapper = document.getElementById('hero-3d-scene-wrapper');
    const tooltip = document.getElementById('node-tooltip');
    const tooltipTitle = document.getElementById('node-tooltip-title');
    const tooltipDesc = document.getElementById('node-tooltip-desc');
    if (!mount || !wrapper) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      wrapper.classList.add('reduced-motion-fallback');
      return;
    }

    // Clean up previous renderer if re-navigating via ClientRouter
    while (mount.firstChild) {
      mount.removeChild(mount.firstChild);
    }

    const isDark = () => document.documentElement.dataset.theme === 'dark' || document.documentElement.dataset.theme === 'hacker';

    const getColors = () => {
      if (isDark()) {
        return {
          nodeDefault: 0x38bdf8,   // Cyan
          nodeActive: 0xef4444,    // Crimson
          curve: 0x1e3a8a,         // Deep navy
          packet: 0x22c55e,        // Terminal green
          lattice: 0x1e293b,
          pointLight: 0x38bdf8,
          pointLight2: 0xef4444
        };
      } else {
        return {
          nodeDefault: 0x2563eb,   // Royal blue
          nodeActive: 0x7c3aed,    // Violet
          curve: 0xcbd5e1,         // Slate light
          packet: 0x0f766e,        // Teal
          lattice: 0xe2e8f0,
          pointLight: 0x2563eb,
          pointLight2: 0x7c3aed
        };
      }
    };

    let colors = getColors();

    // Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, mount.clientWidth / mount.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 8.5);

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance'
      });
    } catch (e) {
      wrapper.classList.add('webgl-unavailable');
      return;
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    renderer.setSize(mount.clientWidth, mount.clientHeight);
    mount.appendChild(renderer.domElement);

    // 4 Core Agent Reasoning Loop Nodes
    const agentNodesData = [
      { id: 'perceive', name: '1. PERCEIVE', desc: 'Environment telemetry, multimodal feeds & DOM parsing', pos: new THREE.Vector3(-2.6, 1.4, 0) },
      { id: 'plan', name: '2. PLAN', desc: 'Formal contract evaluation, task-DAG decomposition & checkpointing', pos: new THREE.Vector3(2.6, 1.4, 0) },
      { id: 'execute', name: '3. EXECUTE', desc: 'Sandboxed code execution, tool broker invocation & API dispatch', pos: new THREE.Vector3(2.6, -1.4, 0) },
      { id: 'verify', name: '4. VERIFY', desc: 'AST regression audit, safety checks & transactional commit', pos: new THREE.Vector3(-2.6, -1.4, 0) },
    ];

    const nodeMeshes: THREE.Mesh[] = [];
    const nodeGeo = new THREE.IcosahedronGeometry(0.55, 1);

    agentNodesData.forEach((nodeData, idx) => {
      const nodeMat = new THREE.MeshStandardMaterial({
        color: idx === 0 ? colors.nodeActive : colors.nodeDefault,
        roughness: 0.2,
        metalness: 0.8,
        wireframe: false,
      });
      const mesh = new THREE.Mesh(nodeGeo, nodeMat);
      mesh.position.copy(nodeData.pos);
      mesh.userData = nodeData;
      scene.add(mesh);
      nodeMeshes.push(mesh);

      // Node Halo Wireframe
      const haloGeo = new THREE.DodecahedronGeometry(0.85, 0);
      const haloMat = new THREE.MeshBasicMaterial({
        color: colors.nodeDefault,
        wireframe: true,
        transparent: true,
        opacity: 0.35,
      });
      const halo = new THREE.Mesh(haloGeo, haloMat);
      halo.position.copy(nodeData.pos);
      scene.add(halo);
      (mesh as any)._halo = halo;
    });

    // Spline Curves Connecting Loop (0->1->2->3->0)
    const curvePoints = [
      new THREE.Vector3(-2.6, 1.4, 0),
      new THREE.Vector3(0, 2.2, 0.8),
      new THREE.Vector3(2.6, 1.4, 0),
      new THREE.Vector3(3.2, 0, -0.6),
      new THREE.Vector3(2.6, -1.4, 0),
      new THREE.Vector3(0, -2.2, 0.8),
      new THREE.Vector3(-2.6, -1.4, 0),
      new THREE.Vector3(-3.2, 0, -0.6),
      new THREE.Vector3(-2.6, 1.4, 0),
    ];
    const curve = new THREE.CatmullRomCurve3(curvePoints, true, 'centripetal');
    const tubeGeo = new THREE.TubeGeometry(curve, 100, 0.03, 8, true);
    const tubeMat = new THREE.MeshBasicMaterial({
      color: colors.curve,
      transparent: true,
      opacity: 0.5,
    });
    const tubeMesh = new THREE.Mesh(tubeGeo, tubeMat);
    scene.add(tubeMesh);

    // Orbiting Data Packets
    const packetCount = 8;
    const packetGeo = new THREE.SphereGeometry(0.09, 12, 12);
    const packetMat = new THREE.MeshStandardMaterial({
      color: colors.packet,
      emissive: colors.packet,
      emissiveIntensity: 0.8,
      roughness: 0.2,
    });
    const packets: THREE.Mesh[] = [];
    for (let i = 0; i < packetCount; i++) {
      const p = new THREE.Mesh(packetGeo, packetMat);
      scene.add(p);
      packets.push(p);
    }

    // Ambient & Point Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const light1 = new THREE.PointLight(colors.pointLight, 2.8, 25);
    light1.position.set(4, 5, 4);
    scene.add(light1);

    const light2 = new THREE.PointLight(colors.pointLight2, 2.2, 25);
    light2.position.set(-4, -5, 3);
    scene.add(light2);

    // Parallax tracking
    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      let clientX = 0;
      let clientY = 0;
      if ('touches' in e && e.touches.length > 0) {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      } else if ('clientX' in e) {
        clientX = (e as MouseEvent).clientX;
        clientY = (e as MouseEvent).clientY;
      }
      const rect = wrapper.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      targetMouseX = (x / rect.width - 0.5) * 1.5;
      targetMouseY = (y / rect.height - 0.5) * 1.5;
    };

    window.addEventListener('mousemove', onPointerMove, { passive: true });
    window.addEventListener('touchmove', onPointerMove, { passive: true });

    // Node click/hover raycasting
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2(-100, -100);

    const handlePointerHover = (e: MouseEvent) => {
      const rect = mount.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(nodeMeshes);

      if (intersects.length > 0) {
        const hit = intersects[0].object as THREE.Mesh;
        const data = hit.userData;
        if (tooltip && tooltipTitle && tooltipDesc) {
          tooltipTitle.textContent = data.name;
          tooltipDesc.textContent = data.desc;
          tooltip.hidden = false;
          tooltip.style.left = `${e.clientX - rect.left + 15}px`;
          tooltip.style.top = `${e.clientY - rect.top + 15}px`;
        }
      } else if (tooltip) {
        tooltip.hidden = true;
      }
    };
    mount.addEventListener('mousemove', handlePointerHover);

    // Theme changes
    const onThemeChange = () => {
      colors = getColors();
      nodeMeshes.forEach(mesh => {
        (mesh.material as THREE.MeshStandardMaterial).color.setHex(colors.nodeDefault);
        if ((mesh as any)._halo) {
          ((mesh as any)._halo.material as THREE.MeshBasicMaterial).color.setHex(colors.nodeDefault);
        }
      });
      tubeMat.color.setHex(colors.curve);
      packetMat.color.setHex(colors.packet);
      packetMat.emissive.setHex(colors.packet);
      light1.color.setHex(colors.pointLight);
      light2.color.setHex(colors.pointLight2);
    };
    document.documentElement.addEventListener('atlas:theme-applied', onThemeChange);

    // Viewport Intersection Observer & Visibility
    let isVisible = true;
    let animId: number | null = null;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
        if (isVisible && !animId) {
          lastTime = performance.now();
          animId = requestAnimationFrame(animate);
        }
      });
    }, { threshold: 0.05 });
    observer.observe(wrapper);

    const onVisibilityChange = () => {
      if (document.hidden) {
        if (animId) {
          cancelAnimationFrame(animId);
          animId = null;
        }
      } else if (isVisible && !animId) {
        lastTime = performance.now();
        animId = requestAnimationFrame(animate);
      }
    };
    document.addEventListener('visibilitychange', onVisibilityChange);

    // Resize Handler
    const onResize = () => {
      if (!mount) return;
      const width = mount.clientWidth;
      const height = mount.clientHeight;
      if (width === 0 || height === 0) return;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };
    window.addEventListener('resize', onResize);

    // Main Animation Loop
    let lastTime = performance.now();
    let clock = 0;

    function animate(time: number) {
      if (!isVisible || document.hidden) {
        animId = null;
        return;
      }

      animId = requestAnimationFrame(animate);

      const delta = Math.min((time - lastTime) / 1000, 0.1);
      lastTime = time;
      clock += delta;

      // Parallax easing
      currentMouseX += (targetMouseX - currentMouseX) * 0.06;
      currentMouseY += (targetMouseY - currentMouseY) * 0.06;

      // Animate node rotations & state pulses
      nodeMeshes.forEach((mesh, idx) => {
        mesh.rotation.y = clock * 0.4;
        mesh.rotation.x = clock * 0.25;

        // Sequential active stage pulse
        const activeStage = Math.floor((clock * 0.7) % 4);
        const isActive = activeStage === idx;
        const scale = isActive ? 1 + Math.sin(clock * 6) * 0.12 : 1.0;
        mesh.scale.set(scale, scale, scale);

        (mesh.material as THREE.MeshStandardMaterial).color.setHex(
          isActive ? colors.nodeActive : colors.nodeDefault
        );

        if ((mesh as any)._halo) {
          const halo = (mesh as any)._halo;
          halo.rotation.z = -clock * 0.3;
          halo.rotation.y = -clock * 0.2;
        }
      });

      // Move data packets along spline
      packets.forEach((packet, idx) => {
        const offset = idx / packetCount;
        const t = (clock * 0.18 + offset) % 1;
        const pos = curve.getPointAt(t);
        packet.position.copy(pos);
      });

      // Camera parallax
      camera.position.x = currentMouseX * 1.2;
      camera.position.y = -currentMouseY * 1.2;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);
    }

    animId = requestAnimationFrame(animate);

    // Teardown
    const cleanup = () => {
      if (animId) cancelAnimationFrame(animId);
      observer.disconnect();
      window.removeEventListener('mousemove', onPointerMove);
      window.removeEventListener('touchmove', onPointerMove);
      window.removeEventListener('resize', onResize);
      mount.removeEventListener('mousemove', handlePointerHover);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      document.documentElement.removeEventListener('atlas:theme-applied', onThemeChange);

      renderer.dispose();
      nodeGeo.dispose();
      tubeGeo.dispose();
      tubeMat.dispose();
      packetGeo.dispose();
      packetMat.dispose();
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  document.addEventListener('astro:page-load', initHero3D);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero3D);
  } else {
    initHero3D();
  }
</script>

<style>
.hero-3d-container {
  position: relative;
  width: 100%;
  height: 480px;
  max-height: 520px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: radial-gradient(circle at center, rgb(37 99 235 / 0.05) 0%, transparent 70%);
  display: flex;
  align-items: center;
  justify-content: center;
}

:root[data-theme="dark"] .hero-3d-container,
:root[data-theme="hacker"] .hero-3d-container {
  background: radial-gradient(circle at center, rgb(56 189 248 / 0.08) 0%, transparent 75%);
}

.canvas-mount {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}

.telemetry-badge {
  position: absolute;
  bottom: var(--space-4);
  right: var(--space-4);
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 4px 12px;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 11px;
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
  backdrop-filter: blur(8px);
  pointer-events: none;
  z-index: 2;
  box-shadow: var(--shadow-sm);
}

.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 8px var(--color-success);
  animation: pulse-dot 2s infinite ease-in-out;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.node-tooltip {
  position: absolute;
  pointer-events: none;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-2) var(--space-3);
  font-size: 11px;
  color: var(--color-text);
  box-shadow: var(--shadow-md);
  z-index: 10;
  max-width: 220px;
}

.node-tooltip-title {
  font-weight: 700;
  color: var(--color-primary);
  font-family: var(--font-mono);
}

.node-tooltip-desc {
  color: var(--color-text-secondary);
  margin-top: 2px;
  font-size: 10px;
  line-height: 1.4;
}

@media (max-width: 768px) {
  .hero-3d-container {
    height: 360px;
  }
}
</style>
