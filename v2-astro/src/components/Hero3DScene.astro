---
/**
 * Hero3DScene.astro — Meaningful 3D Agent Reasoning Directed Graph (Three.js)
 * Visualizes the 4-stage Agentic Reasoning Loop:
 *   [PERCEIVE] -> [PLAN] -> [EXECUTE] -> [VERIFY]
 *
 * Capabilities:
 * - 4 interactive 3D nodes with live glowing state pulses
 * - Curved spline execution pipelines with orbiting data packets
 * - Dynamic theme color lerping (Light Blueprint vs Dark Cyber-Intelligence)
 * - Interactive pointer tracking & damping
 * - Performance guardrails: Capped DPR (max 2.0), pause offscreen/hidden, reduced-motion fallback, WebGL context loss handling
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`hero-3d-container ${className}`} id="hero-3d-scene-wrapper">
  <!-- Interactive WebGL Canvas Container -->
  <div class="canvas-mount" id="hero-3d-canvas-mount" aria-hidden="true"></div>

  <!-- Named stages. Visible over the canvas, and the whole diagram when WebGL is off. -->
  <ol class="agent-loop-legend">
    <li class="loop-step loop-perceive">
      <strong>PERCEIVE</strong>
      <span>Environment telemetry and multimodal feeds</span>
    </li>
    <li class="loop-step loop-plan">
      <strong>PLAN</strong>
      <span>Contract evaluation and task-DAG checkpoints</span>
    </li>
    <li class="loop-step loop-verify">
      <strong>VERIFY</strong>
      <span>Safety checks and transactional commit</span>
    </li>
    <li class="loop-step loop-execute">
      <strong>EXECUTE</strong>
      <span>Sandboxed tools and API dispatch</span>
    </li>
  </ol>

  <!-- Telemetry Overlay Badge -->
  <div class="telemetry-badge" id="telemetry-badge">
    <span class="live-dot"></span>
    <span class="telemetry-text">Agent Loop: PERCEIVE ➔ PLAN ➔ EXECUTE ➔ VERIFY</span>
  </div>

  <!-- Screen reader accessible live narration of active stage -->
  <div class="sr-only" aria-live="polite" id="hero-3d-aria-status">
    Agent Loop active: Stage 1 PERCEIVE
  </div>

  <!-- Interactive Node Detail Tooltip -->
  <div class="node-tooltip" id="node-tooltip" hidden>
    <div class="node-tooltip-title" id="node-tooltip-title">Agent State</div>
    <div class="node-tooltip-desc" id="node-tooltip-desc">State description</div>
  </div>
</div>

<script>
  import {
    Scene,
    PerspectiveCamera,
    WebGLRenderer,
    Vector2,
    Vector3,
    Mesh,
    IcosahedronGeometry,
    DodecahedronGeometry,
    TubeGeometry,
    SphereGeometry,
    CatmullRomCurve3,
    MeshStandardMaterial,
    MeshBasicMaterial,
    AmbientLight,
    PointLight,
    Raycaster,
    type Material,
  } from 'three';

  function initHero3D() {
    const mount = document.getElementById('hero-3d-canvas-mount');
    const wrapper = document.getElementById('hero-3d-scene-wrapper');
    const tooltip = document.getElementById('node-tooltip');
    const tooltipTitle = document.getElementById('node-tooltip-title');
    const tooltipDesc = document.getElementById('node-tooltip-desc');
    const ariaStatus = document.getElementById('hero-3d-aria-status');
    if (!mount || !wrapper) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      wrapper.classList.add('reduced-motion-fallback');
      return;
    }

    // Clean up previous renderer if re-navigating via ClientRouter
    while (mount.firstChild) {
      mount.removeChild(mount.firstChild);
    }

    const cssHex = (varName: string, fallback: number) => {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
      const body = raw.startsWith('#') ? raw.slice(1) : '';
      const expanded = body.length === 3 ? body.split('').map((c) => c + c).join('') : body;
      const parsed = expanded.length === 6 ? Number.parseInt(expanded, 16) : Number.NaN;
      return Number.isNaN(parsed) ? fallback : parsed;
    };

    const getColors = () => ({
      nodeDefault: cssHex('--cluster-agentic', 0x2563eb),
      nodeActive: cssHex('--cluster-security', 0xb91c1c),
      curve: cssHex('--cluster-agentic', 0x2563eb),
      packet: cssHex('--cluster-knowledge', 0x0f766e),
      lattice: cssHex('--color-border', 0xe2e8f0),
      pointLight: cssHex('--cluster-agentic', 0x2563eb),
      pointLight2: cssHex('--cluster-memory', 0x7c3aed),
    });

    let colors = getColors();

    // Scene, Camera, Renderer
    const scene = new Scene();
    const camera = new PerspectiveCamera(45, mount.clientWidth / mount.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 8.5);

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance'
      });
    } catch (e) {
      wrapper.classList.add('webgl-unavailable');
      return;
    }

    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    let isLowPower = isTouch;
    if ('getBattery' in navigator) {
      (navigator as any).getBattery().then((battery: any) => {
        if (battery.level < 0.25 && !battery.charging) {
          isLowPower = true;
        }
      }).catch(() => {});
    }

    const maxDpr = isTouch ? 1.5 : 2.0;
    const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
    renderer.setPixelRatio(dpr);
    renderer.setSize(mount.clientWidth, mount.clientHeight);
    mount.appendChild(renderer.domElement);

    // WebGL Context Loss & Recovery Handling
    const handleContextLost = (e: Event) => {
      e.preventDefault();
      if (animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    };
    const handleContextRestored = () => {
      lastTime = performance.now();
      if (isVisible && !document.hidden && !animId) {
        animId = requestAnimationFrame(animate);
      }
    };
    renderer.domElement.addEventListener('webglcontextlost', handleContextLost, false);
    renderer.domElement.addEventListener('webglcontextrestored', handleContextRestored, false);

    // 4 Core Agent Reasoning Loop Nodes
    const agentNodesData = [
      { id: 'perceive', name: '1. PERCEIVE', desc: 'Environment telemetry, multimodal feeds & DOM parsing', pos: new Vector3(-2.6, 1.4, 0) },
      { id: 'plan', name: '2. PLAN', desc: 'Formal contract evaluation, task-DAG decomposition & checkpointing', pos: new Vector3(2.6, 1.4, 0) },
      { id: 'execute', name: '3. EXECUTE', desc: 'Sandboxed code execution, tool broker invocation & API dispatch', pos: new Vector3(2.6, -1.4, 0) },
      { id: 'verify', name: '4. VERIFY', desc: 'AST regression audit, safety checks & transactional commit', pos: new Vector3(-2.6, -1.4, 0) },
    ];

    const nodeMeshes: Mesh[] = [];
    const haloMeshes: Mesh[] = [];
    const nodeGeo = new IcosahedronGeometry(0.55, 1);
    const haloGeo = new DodecahedronGeometry(0.85, 0);
    const haloMat = new MeshBasicMaterial({
      color: colors.nodeDefault,
      wireframe: true,
      transparent: true,
      opacity: 0.35,
    });

    agentNodesData.forEach((nodeData, idx) => {
      const nodeMat = new MeshStandardMaterial({
        color: idx === 0 ? colors.nodeActive : colors.nodeDefault,
        roughness: 0.2,
        metalness: 0.8,
        wireframe: false,
      });
      const mesh = new Mesh(nodeGeo, nodeMat);
      mesh.position.copy(nodeData.pos);
      mesh.userData = nodeData;
      scene.add(mesh);
      nodeMeshes.push(mesh);

      // Node Halo Wireframe (Shared geometry & material)
      const halo = new Mesh(haloGeo, haloMat);
      halo.position.copy(nodeData.pos);
      scene.add(halo);
      haloMeshes.push(halo);
      (mesh as any)._halo = halo;
    });

    // Spline Curves Connecting Loop (0->1->2->3->0)
    const curvePoints = [
      new Vector3(-2.6, 1.4, 0),
      new Vector3(0, 2.2, 0.8),
      new Vector3(2.6, 1.4, 0),
      new Vector3(3.2, 0, -0.6),
      new Vector3(2.6, -1.4, 0),
      new Vector3(0, -2.2, 0.8),
      new Vector3(-2.6, -1.4, 0),
      new Vector3(-3.2, 0, -0.6),
      new Vector3(-2.6, 1.4, 0),
    ];
    const curve = new CatmullRomCurve3(curvePoints, true, 'centripetal');
    const tubeGeo = new TubeGeometry(curve, 100, 0.03, 8, true);
    const tubeMat = new MeshBasicMaterial({
      color: colors.curve,
      transparent: true,
      opacity: 0.5,
    });
    const tubeMesh = new Mesh(tubeGeo, tubeMat);
    scene.add(tubeMesh);

    // Orbiting Data Packets
    const packetCount = 8;
    const packetGeo = new SphereGeometry(0.09, 12, 12);
    const packetMat = new MeshStandardMaterial({
      color: colors.packet,
      emissive: colors.packet,
      emissiveIntensity: 0.8,
      roughness: 0.2,
    });
    const packets: Mesh[] = [];
    for (let i = 0; i < packetCount; i++) {
      const p = new Mesh(packetGeo, packetMat);
      scene.add(p);
      packets.push(p);
    }

    // Ambient & Point Lighting
    const ambientLight = new AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const light1 = new PointLight(colors.pointLight, 2.8, 25);
    light1.position.set(4, 5, 4);
    scene.add(light1);

    const light2 = new PointLight(colors.pointLight2, 2.2, 25);
    light2.position.set(-4, -5, 3);
    scene.add(light2);

    // Parallax tracking
    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      let clientX = 0;
      let clientY = 0;
      if ('touches' in e && e.touches.length > 0) {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      } else if ('clientX' in e) {
        clientX = (e as MouseEvent).clientX;
        clientY = (e as MouseEvent).clientY;
      }
      const rect = wrapper.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      targetMouseX = (x / rect.width - 0.5) * 1.5;
      targetMouseY = (y / rect.height - 0.5) * 1.5;
    };

    window.addEventListener('mousemove', onPointerMove, { passive: true });
    window.addEventListener('touchmove', onPointerMove, { passive: true });

    // Node click/hover raycasting
    const raycaster = new Raycaster();
    const mouse = new Vector2(-100, -100);

    const handlePointerHover = (e: MouseEvent) => {
      const rect = mount.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(nodeMeshes);

      if (intersects.length > 0) {
        const hit = intersects[0].object as Mesh;
        const data = hit.userData;
        if (tooltip && tooltipTitle && tooltipDesc) {
          tooltipTitle.textContent = data.name;
          tooltipDesc.textContent = data.desc;
          tooltip.hidden = false;
          const leftOffset = Math.min(e.clientX - rect.left + 15, rect.width - 220);
          const topOffset = Math.min(e.clientY - rect.top + 15, rect.height - 80);
          tooltip.style.left = `${Math.max(10, leftOffset)}px`;
          tooltip.style.top = `${Math.max(10, topOffset)}px`;
        }
      } else if (tooltip) {
        tooltip.hidden = true;
      }
    };
    mount.addEventListener('mousemove', handlePointerHover);

    // Theme changes
    const onThemeChange = () => {
      colors = getColors();
      nodeMeshes.forEach(mesh => {
        (mesh.material as MeshStandardMaterial).color.setHex(colors.nodeDefault);
      });
      haloMeshes.forEach(mesh => {
        (mesh.material as MeshBasicMaterial).color.setHex(colors.nodeDefault);
      });
      tubeMat.color.setHex(colors.curve);
      packetMat.color.setHex(colors.packet);
      packetMat.emissive.setHex(colors.packet);
      light1.color.setHex(colors.pointLight);
      light2.color.setHex(colors.pointLight2);
    };
    document.documentElement.addEventListener('atlas:theme-applied', onThemeChange);

    // Viewport Intersection Observer & Visibility
    let isVisible = true;
    let animId: number | null = null;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
        if (isVisible && !animId) {
          lastTime = performance.now();
          animId = requestAnimationFrame(animate);
        }
      });
    }, { threshold: 0.05 });
    observer.observe(wrapper);

    const onVisibilityChange = () => {
      if (document.hidden) {
        if (animId) {
          cancelAnimationFrame(animId);
          animId = null;
        }
      } else if (isVisible && !animId) {
        lastTime = performance.now();
        animId = requestAnimationFrame(animate);
      }
    };
    document.addEventListener('visibilitychange', onVisibilityChange);

    // Resize Handler
    const onResize = () => {
      if (!mount) return;
      const width = mount.clientWidth;
      const height = mount.clientHeight;
      if (width === 0 || height === 0) return;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };
    window.addEventListener('resize', onResize);

    // Main Animation Loop
    let lastTime = performance.now();
    let lastRenderTime = 0;
    let clock = 0;
    let lastAnnouncedStage = -1;

    function animate(time: number) {
      if (!isVisible || document.hidden) {
        animId = null;
        return;
      }

      animId = requestAnimationFrame(animate);

      // Low-power 30 FPS frame throttle
      if (isLowPower && time - lastRenderTime < 33) {
        return;
      }
      lastRenderTime = time;

      const delta = Math.min((time - lastTime) / 1000, 0.1);
      lastTime = time;
      clock += delta;

      // Parallax easing
      currentMouseX += (targetMouseX - currentMouseX) * 0.06;
      currentMouseY += (targetMouseY - currentMouseY) * 0.06;

      // Sequential active stage pulse
      const activeStage = Math.floor((clock * 0.7) % 4);
      if (activeStage !== lastAnnouncedStage && ariaStatus) {
        lastAnnouncedStage = activeStage;
        ariaStatus.textContent = `Agent Loop active: Stage ${activeStage + 1} ${agentNodesData[activeStage].name} - ${agentNodesData[activeStage].desc}`;
      }

      // Animate node rotations & state pulses
      nodeMeshes.forEach((mesh, idx) => {
        mesh.rotation.y = clock * 0.4;
        mesh.rotation.x = clock * 0.25;

        const isActive = activeStage === idx;
        const scale = isActive ? 1 + Math.sin(clock * 6) * 0.12 : 1.0;
        mesh.scale.set(scale, scale, scale);

        (mesh.material as MeshStandardMaterial).color.setHex(
          isActive ? colors.nodeActive : colors.nodeDefault
        );
      });

      haloMeshes.forEach(halo => {
        halo.rotation.z = -clock * 0.3;
        halo.rotation.y = -clock * 0.2;
      });

      // Move data packets along spline
      packets.forEach((packet, idx) => {
        const offset = idx / packetCount;
        const t = (clock * 0.18 + offset) % 1;
        const pos = curve.getPointAt(t);
        packet.position.copy(pos);
      });

      // Camera parallax
      camera.position.x = currentMouseX * 1.2;
      camera.position.y = -currentMouseY * 1.2;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);
    }

    animId = requestAnimationFrame(animate);

    // Teardown & Complete VRAM Cleanup
    const cleanup = () => {
      if (animId) cancelAnimationFrame(animId);
      observer.disconnect();
      window.removeEventListener('mousemove', onPointerMove);
      window.removeEventListener('touchmove', onPointerMove);
      window.removeEventListener('resize', onResize);
      mount.removeEventListener('mousemove', handlePointerHover);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      document.documentElement.removeEventListener('atlas:theme-applied', onThemeChange);

      renderer.domElement.removeEventListener('webglcontextlost', handleContextLost);
      renderer.domElement.removeEventListener('webglcontextrestored', handleContextRestored);

      nodeMeshes.forEach(m => {
        (m.material as Material).dispose();
      });
      renderer.dispose();
      nodeGeo.dispose();
      haloGeo.dispose();
      haloMat.dispose();
      tubeGeo.dispose();
      tubeMat.dispose();
      packetGeo.dispose();
      packetMat.dispose();
      light1.dispose();
      light2.dispose();
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  document.addEventListener('astro:page-load', initHero3D);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero3D);
  } else {
    initHero3D();
  }
</script>

<style>
.hero-3d-container {
  position: relative;
  width: 100%;
  height: 480px;
  max-height: 520px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: radial-gradient(circle at center, rgb(37 99 235 / 0.05) 0%, transparent 70%);
  display: flex;
  align-items: center;
  justify-content: center;
}

:root[data-theme="dark"] .hero-3d-container,
:root[data-theme="hacker"] .hero-3d-container {
  background: radial-gradient(circle at center, rgb(56 189 248 / 0.08) 0%, transparent 75%);
}

.canvas-mount {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}

.telemetry-badge {
  position: absolute;
  top: var(--space-4);
  left: 50%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 4px 12px;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 11px;
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
  backdrop-filter: blur(8px);
  pointer-events: none;
  z-index: 2;
  box-shadow: var(--shadow-sm);
  max-width: calc(100% - 32px);
}

.agent-loop-legend {
  position: absolute;
  inset: 0;
  z-index: 2;
  margin: 0;
  padding: var(--space-4);
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  pointer-events: none;
}

.loop-step {
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-width: min(190px, 100%);
  min-width: 0;
  padding: 6px 10px;
  background: color-mix(in srgb, var(--color-surface-raised) 88%, transparent);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(6px);
}

.loop-step strong {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
  color: var(--color-text);
}

.loop-step span {
  font-size: 11px;
  line-height: 1.35;
  color: var(--color-text-secondary);
}

.loop-perceive { align-self: start; justify-self: start; }
.loop-plan { align-self: start; justify-self: end; text-align: right; }
.loop-verify { align-self: end; justify-self: start; }
.loop-execute { align-self: end; justify-self: end; text-align: right; }

.hero-3d-container.reduced-motion-fallback .canvas-mount,
.hero-3d-container.webgl-unavailable .canvas-mount,
.hero-3d-container.reduced-motion-fallback .telemetry-badge,
.hero-3d-container.webgl-unavailable .telemetry-badge,
.hero-3d-container.reduced-motion-fallback .node-tooltip,
.hero-3d-container.webgl-unavailable .node-tooltip {
  display: none;
}

.hero-3d-container.reduced-motion-fallback,
.hero-3d-container.webgl-unavailable {
  height: auto;
  min-height: 280px;
}

.hero-3d-container.reduced-motion-fallback .agent-loop-legend,
.hero-3d-container.webgl-unavailable .agent-loop-legend {
  position: relative;
  inset: auto;
  gap: var(--space-3);
  pointer-events: auto;
}

.hero-3d-container.reduced-motion-fallback .loop-step,
.hero-3d-container.webgl-unavailable .loop-step {
  max-width: none;
  align-self: stretch;
  justify-self: stretch;
  text-align: left;
  padding: var(--space-4);
}

.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 8px var(--color-success);
  animation: pulse-dot 2s infinite ease-in-out;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.node-tooltip {
  position: absolute;
  pointer-events: none;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-2) var(--space-3);
  font-size: 11px;
  color: var(--color-text);
  box-shadow: var(--shadow-md);
  z-index: 10;
  max-width: 220px;
}

.node-tooltip-title {
  font-weight: 700;
  color: var(--color-primary);
  font-family: var(--font-mono);
}

.node-tooltip-desc {
  color: var(--color-text-secondary);
  margin-top: 2px;
  font-size: 10px;
  line-height: 1.4;
}

@media (max-width: 768px) {
  .hero-3d-container {
    height: 360px;
  }
  .telemetry-badge {
    display: none;
  }
  .agent-loop-legend {
    padding: var(--space-3);
  }
}
</style>
