---
// src/components/HeroAgenticGraph.astro
// Signature Living Architecture DAG: DATA -> AGENTS -> REASONING -> VERIFICATION -> IMPACT
// Replaces generic floating particles with an interactive, reactive systems engineering DAG.
---

<div class="hero-agentic-wrapper" id="hero-agentic-dag-container">
  <div class="dag-header-telemetry">
    <div class="telemetry-pill-row">
      <span class="pulse-beacon"></span>
      <span class="telemetry-title">LIVE ARCHITECTURE DAG // REASONING PIPELINE</span>
    </div>
    <span class="dag-status-pill">708/712 TESTS VERIFIED</span>
  </div>

  <div class="dag-canvas-stage" id="dag-stage">
    <svg viewBox="0 0 540 320" class="dag-svg" id="dag-svg-elem" preserveAspectRatio="xMidYMid meet" aria-label="Interactive Living Agentic AI Architecture Graph">
      <defs>
        <!-- Glow Filters -->
        <filter id="dag-glow-cyan" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="dag-glow-green" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- Pipeline Line Gradients -->
        <linearGradient id="grad-data-agent" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#818cf8" />
        </linearGradient>
        <linearGradient id="grad-agent-verify" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#818cf8" />
          <stop offset="100%" stop-color="#22c55e" />
        </linearGradient>
      </defs>

      <!-- Background Grid Coordinates (Subtle CAD aesthetics) -->
      <g class="dag-cad-grid">
        <line x1="40" y1="160" x2="500" y2="160" class="cad-line" />
        <line x1="270" y1="20" x2="270" y2="300" class="cad-line" />
        <circle cx="270" cy="160" r="110" class="cad-circle" />
        <circle cx="270" cy="160" r="140" class="cad-circle-outer" />
      </g>

      <!-- Connecting Pathway Filaments (Edges) -->
      <!-- Input Data -> Agent Core -->
      <path d="M 90 90 C 160 90, 190 140, 240 150" class="dag-edge edge-active" id="path-data-agent" />
      <!-- Telemetry Data -> Agent Core -->
      <path d="M 90 230 C 160 230, 190 180, 240 170" class="dag-edge edge-active" id="path-telem-agent" />
      <!-- Agent Core -> RAG Plane -->
      <path d="M 300 150 C 340 130, 360 80, 420 80" class="dag-edge edge-active" id="path-agent-rag" />
      <!-- Agent Core -> Tool Broker -->
      <path d="M 300 170 C 340 190, 360 240, 420 240" class="dag-edge edge-active" id="path-agent-tool" />
      <!-- RAG Plane -> Verification -->
      <path d="M 420 80 C 470 80, 470 140, 440 155" class="dag-edge edge-verified" id="path-rag-ver" />
      <!-- Tool Broker -> Verification -->
      <path d="M 420 240 C 470 240, 470 180, 440 165" class="dag-edge edge-verified" id="path-tool-ver" />
      <!-- Verification -> Trusted Output -->
      <path d="M 440 160 L 500 160" class="dag-edge edge-verified" id="path-ver-out" />

      <!-- Traveling Data Packets -->
      <circle r="3.5" class="dag-packet packet-cyan">
        <animateMotion dur="2.4s" repeatCount="indefinite">
          <mpath href="#path-data-agent" />
        </animateMotion>
      </circle>
      <circle r="3.5" class="dag-packet packet-cyan">
        <animateMotion dur="2.4s" begin="1.2s" repeatCount="indefinite">
          <mpath href="#path-telem-agent" />
        </animateMotion>
      </circle>
      <circle r="3.5" class="dag-packet packet-purple">
        <animateMotion dur="2.0s" begin="0.4s" repeatCount="indefinite">
          <mpath href="#path-agent-rag" />
        </animateMotion>
      </circle>
      <circle r="3.5" class="dag-packet packet-purple">
        <animateMotion dur="2.0s" begin="0.8s" repeatCount="indefinite">
          <mpath href="#path-agent-tool" />
        </animateMotion>
      </circle>
      <circle r="3.5" class="dag-packet packet-green">
        <animateMotion dur="1.8s" begin="1.0s" repeatCount="indefinite">
          <mpath href="#path-rag-ver" />
        </animateMotion>
      </circle>
      <circle r="3.5" class="dag-packet packet-green">
        <animateMotion dur="1.8s" begin="1.4s" repeatCount="indefinite">
          <mpath href="#path-tool-ver" />
        </animateMotion>
      </circle>
      <circle r="4" class="dag-packet packet-green">
        <animateMotion dur="1.2s" begin="0.2s" repeatCount="indefinite">
          <mpath href="#path-ver-out" />
        </animateMotion>
      </circle>

      <!-- Interactive Nodes -->
      <!-- 01: USER / MULTIMODAL DATA -->
      <g class="dag-node-group" transform="translate(90, 90)" data-node-id="data">
        <rect x="-38" y="-18" width="76" height="36" rx="6" class="dag-node-box" />
        <text y="-2" class="dag-node-title">USER / DATA</text>
        <text y="10" class="dag-node-sub">CAN · AUDIO · DOM</text>
        <circle cx="0" cy="0" r="3" class="dag-pin pin-cyan" />
      </g>

      <!-- 02: TELEMETRY STREAM -->
      <g class="dag-node-group" transform="translate(90, 230)" data-node-id="telem">
        <rect x="-38" y="-18" width="76" height="36" rx="6" class="dag-node-box" />
        <text y="-2" class="dag-node-title">TELEMETRY</text>
        <text y="10" class="dag-node-sub">1000Hz SENSORS</text>
        <circle cx="0" cy="0" r="3" class="dag-pin pin-cyan" />
      </g>

      <!-- 03: CENTRAL AGENT CORE (PULSING) -->
      <g class="dag-node-group node-agent-core" transform="translate(270, 160)" data-node-id="agent">
        <!-- Concentric Energy Rings -->
        <circle cx="0" cy="0" r="36" class="agent-energy-ring ring-3" />
        <circle cx="0" cy="0" r="30" class="agent-energy-ring ring-2" />
        <circle cx="0" cy="0" r="24" class="agent-energy-ring ring-1" />
        <rect x="-42" y="-22" width="84" height="44" rx="8" class="dag-node-box node-box-agent" />
        <text y="-4" class="dag-node-title text-glow-cyan">AI AGENT CORE</text>
        <text y="9" class="dag-node-sub">PLANNER & BROKER</text>
      </g>

      <!-- 04: RAG PLANE -->
      <g class="dag-node-group" transform="translate(420, 80)" data-node-id="rag">
        <rect x="-36" y="-18" width="72" height="36" rx="6" class="dag-node-box" />
        <text y="-2" class="dag-node-title">RAG PLANE</text>
        <text y="10" class="dag-node-sub">TRI-ISOLATED</text>
        <circle cx="0" cy="0" r="3" class="dag-pin pin-purple" />
      </g>

      <!-- 05: TOOL BROKER (L2 SANDBOX) -->
      <g class="dag-node-group" transform="translate(420, 240)" data-node-id="tools">
        <rect x="-36" y="-18" width="72" height="36" rx="6" class="dag-node-box" />
        <text y="-2" class="dag-node-title">TOOL BROKER</text>
        <text y="10" class="dag-node-sub">L2 SANDBOX</text>
        <circle cx="0" cy="0" r="3" class="dag-pin pin-purple" />
      </g>

      <!-- 06: VERIFICATION ENGINE (PERIODIC CONFIRMATION RING) -->
      <g class="dag-node-group node-verify-core" transform="translate(440, 160)" data-node-id="verify">
        <circle cx="0" cy="0" r="28" class="verify-beacon-ring" />
        <circle cx="0" cy="0" r="18" class="dag-node-circle circle-verify" />
        <text y="-2" class="dag-node-title text-green">VERIFY</text>
        <text y="9" class="dag-node-sub text-green">HMAC/AST</text>
      </g>

      <!-- 07: TRUSTED OUTPUT -->
      <g class="dag-node-group" transform="translate(500, 160)" data-node-id="output">
        <circle cx="0" cy="0" r="6" fill="#22c55e" filter="url(#dag-glow-green)" />
      </g>
    </svg>
  </div>

  <!-- Live DAG Interactive Caption -->
  <div class="dag-footer-caption">
    <span class="caption-tag">INTERACTIVE DAG</span>
    <span class="caption-text">Dynamic perspective tracks pointer coords (±3° / ±2°) · Click nodes to inspect mathematical invariants</span>
  </div>
</div>

<script>
  function setupHeroAgenticDAG() {
    const container = document.getElementById('hero-agentic-dag-container');
    const stage = document.getElementById('dag-stage');
    const svg = document.getElementById('dag-svg-elem');
    if (!container || !stage || !svg) return;

    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(pointer: coarse)').matches;

    if (isReduced || isTouch) return;

    // Mouse perspective tilt (±3° X, ±2° Y)
    let targetRotX = 0;
    let targetRotY = 0;
    let currentRotX = 0;
    let currentRotY = 0;
    let rafId: number | null = null;

    const handlePointerMove = (e: MouseEvent) => {
      const rect = stage.getBoundingClientRect();
      const xNorm = ((e.clientX - rect.left) / rect.width) * 2 - 1; // [-1, 1]
      const yNorm = ((e.clientY - rect.top) / rect.height) * 2 - 1; // [-1, 1]

      targetRotY = xNorm * 3.5; // ±3.5 deg
      targetRotX = -yNorm * 2.5; // ±2.5 deg
    };

    const handlePointerLeave = () => {
      targetRotX = 0;
      targetRotY = 0;
    };

    const updateTilt = () => {
      currentRotX += (targetRotX - currentRotX) * 0.08;
      currentRotY += (targetRotY - currentRotY) * 0.08;

      svg.style.transform = `perspective(800px) rotateX(${currentRotX.toFixed(2)}deg) rotateY(${currentRotY.toFixed(2)}deg)`;

      rafId = requestAnimationFrame(updateTilt);
    };

    stage.addEventListener('mousemove', handlePointerMove);
    stage.addEventListener('mouseleave', handlePointerLeave);
    rafId = requestAnimationFrame(updateTilt);

    // Teardown for ClientRouter
    document.addEventListener('astro:before-swap', () => {
      if (rafId) cancelAnimationFrame(rafId);
      stage.removeEventListener('mousemove', handlePointerMove);
      stage.removeEventListener('mouseleave', handlePointerLeave);
    }, { once: true });
  }

  setupHeroAgenticDAG();
  document.addEventListener('astro:page-load', setupHeroAgenticDAG);
</script>

<style>
.hero-agentic-wrapper {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  margin-top: var(--space-4);
  position: relative;
  transition: border-color var(--duration-fast) var(--ease-default),
              box-shadow var(--duration-fast) var(--ease-default);
}

.hero-agentic-wrapper:hover {
  border-color: rgba(56, 189, 248, 0.4);
  box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.6), 0 0 24px rgba(56, 189, 248, 0.15);
}

.dag-header-telemetry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px var(--space-4);
  background: rgba(15, 23, 42, 0.95);
  border-bottom: 1px solid rgba(56, 189, 248, 0.2);
  font-family: var(--font-mono);
  font-size: 11px;
}

.telemetry-pill-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pulse-beacon {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 8px #22c55e;
  animation: beacon-pulse 2s infinite ease-in-out;
}

@keyframes beacon-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.8); }
}

.telemetry-title {
  color: #38bdf8;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.dag-status-pill {
  color: #22c55e;
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.3);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-weight: 700;
}

.dag-canvas-stage {
  padding: var(--space-4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #080d17;
  overflow: hidden;
  perspective: 800px;
}

.dag-svg {
  width: 100%;
  max-height: 280px;
  transform-style: preserve-3d;
  will-change: transform;
}

/* CAD Grid Lines */
.cad-line {
  stroke: rgba(56, 189, 248, 0.06);
  stroke-width: 1;
}

.cad-circle {
  fill: none;
  stroke: rgba(56, 189, 248, 0.05);
  stroke-dasharray: 4 4;
}

.cad-circle-outer {
  fill: none;
  stroke: rgba(168, 85, 247, 0.04);
}

/* Filaments / Edges */
.dag-edge {
  fill: none;
  stroke-width: 2;
}

.edge-active {
  stroke: #1e293b;
  stroke-dasharray: 4 3;
  animation: edge-flow 2s linear infinite;
}

.edge-verified {
  stroke: #22c55e;
  stroke-width: 2.5;
  stroke-dasharray: 6 3;
  animation: edge-flow 1.6s linear infinite;
}

@keyframes edge-flow {
  to { stroke-dashoffset: -14; }
}

/* Packets */
.dag-packet {
  will-change: transform;
}

.packet-cyan { fill: #38bdf8; filter: drop-shadow(0 0 5px #38bdf8); }
.packet-purple { fill: #a855f7; filter: drop-shadow(0 0 5px #a855f7); }
.packet-green { fill: #22c55e; filter: drop-shadow(0 0 5px #22c55e); }

/* Node Styling */
.dag-node-group {
  cursor: pointer;
  transition: transform var(--duration-fast) var(--ease-default);
}

.dag-node-group:hover {
  transform: scale(1.05);
}

.dag-node-box {
  fill: #0f172a;
  stroke: #334155;
  stroke-width: 1.5;
  transition: stroke var(--duration-fast) var(--ease-default),
              fill var(--duration-fast) var(--ease-default);
}

.dag-node-group:hover .dag-node-box {
  stroke: #38bdf8;
  fill: rgba(56, 189, 248, 0.12);
}

.node-box-agent {
  stroke: #38bdf8;
  fill: rgba(56, 189, 248, 0.18);
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
}

.dag-node-circle {
  fill: #0f172a;
  stroke: #22c55e;
  stroke-width: 2;
}

.dag-node-title {
  font-family: var(--font-mono);
  font-size: 8px;
  font-weight: 700;
  fill: #f8fafc;
  text-anchor: middle;
}

.dag-node-sub {
  font-family: var(--font-mono);
  font-size: 6.5px;
  font-weight: 600;
  fill: #94a3b8;
  text-anchor: middle;
}

.text-glow-cyan {
  fill: #38bdf8;
  filter: drop-shadow(0 0 4px rgba(56, 189, 248, 0.8));
}

.text-green { fill: #22c55e; }

/* Concentric Agent Core Energy Rings */
.agent-energy-ring {
  fill: none;
  stroke: rgba(56, 189, 248, 0.25);
  animation: energy-pulse 3.2s infinite ease-in-out;
}

.ring-2 { animation-delay: 0.5s; stroke: rgba(129, 140, 248, 0.2); }
.ring-3 { animation-delay: 1.0s; stroke: rgba(168, 85, 247, 0.15); stroke-dasharray: 4 4; }

@keyframes energy-pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.12); opacity: 0.9; }
}

/* Verification Beacon Ring */
.verify-beacon-ring {
  fill: none;
  stroke: #22c55e;
  stroke-width: 1.5;
  animation: verify-beacon 3.5s infinite ease-out;
}

@keyframes verify-beacon {
  0% { transform: scale(0.6); opacity: 1; }
  100% { transform: scale(1.8); opacity: 0; }
}

.dag-footer-caption {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 6px var(--space-4);
  background: rgba(15, 23, 42, 0.95);
  border-top: 1px solid rgba(56, 189, 248, 0.15);
  font-family: var(--font-mono);
  font-size: 10px;
}

.caption-tag {
  color: #38bdf8;
  font-weight: 700;
}

.caption-text {
  color: #64748b;
}

@media (max-width: 768px) {
  .dag-header-telemetry {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
}
</style>
