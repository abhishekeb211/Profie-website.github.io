---
/**
 * SystemsAtlasGraph.astro — Interactive Architecture Knowledge Graph
 * Progressive enhancement: Interactive SVG Canvas with 2D accessible fallback,
 * cluster filtering, node inspection panel, and full Light/Dark theme sync.
 */
import { ATLAS_NODES, ATLAS_LINKS, ATLAS_CLUSTERS } from '../lib/atlas-graph.ts';

const base = import.meta.env.BASE_URL;
---

<div class="atlas-system-widget" id="systems-atlas-widget">
  <!-- Top Control Bar -->
  <div class="atlas-controls-bar">
    <div class="cluster-filters" role="group" aria-label="Filter systems by cluster">
      <button type="button" class="cluster-btn active" data-cluster="all">
        <span class="dot" style="background: var(--color-primary);"></span>
        All Clusters ({ATLAS_NODES.length})
      </button>
      {ATLAS_CLUSTERS.map(c => (
        <button type="button" class="cluster-btn" data-cluster={c.id}>
          <span class="dot" style={`background: ${c.color};`}></span>
          {c.label}
        </button>
      ))}
    </div>

    <div class="view-mode-toggle" role="group" aria-label="View representation mode">
      <button type="button" class="mode-btn active" id="btn-view-graph" aria-pressed="true">
        Graph Map
      </button>
      <button type="button" class="mode-btn" id="btn-view-list" aria-pressed="false">
        List View
      </button>
    </div>
  </div>

  <!-- Map and inspector sit side by side so the card never covers nodes -->
  <div class="atlas-stage" id="graph-wrapper">
    <div class="graph-canvas-wrapper">
    <!-- SVG Graph Layer -->
    <svg 
      id="atlas-svg" 
      viewBox="-200 -140 400 280" 
      preserveAspectRatio="xMidYMid meet" 
      role="img" 
      aria-label="Interactive Systems Atlas Architecture Graph"
    >
      <defs>
        <!-- Gradients for connections -->
        <linearGradient id="link-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--cluster-agentic)" stop-opacity="0.55" />
          <stop offset="100%" stop-color="var(--cluster-knowledge)" stop-opacity="0.55" />
        </linearGradient>

        <!-- Drop Shadow Filter for Nodes -->
        <filter id="node-shadow" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.3" />
        </filter>
        <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Grid lines for engineering visual aesthetic -->
      <g class="graph-grid-lines">
        <circle cx="0" cy="0" r="45" class="radar-circle" />
        <circle cx="0" cy="0" r="85" class="radar-circle" />
        <circle cx="0" cy="0" r="125" class="radar-circle" />
        <line x1="-170" y1="0" x2="170" y2="0" class="axis-line" />
        <line x1="0" y1="-120" x2="0" y2="120" class="axis-line" />
      </g>

      <!-- Links (Edges) -->
      <g class="graph-links" id="svg-links">
        {ATLAS_LINKS.map(link => {
          const s = ATLAS_NODES.find(n => n.id === link.source);
          const t = ATLAS_NODES.find(n => n.id === link.target);
          if (!s || !t) return null;
          return (
            <g class="link-group" data-source={s.id} data-target={t.id}>
              <line 
                x1={s.x} 
                y1={s.y} 
                x2={t.x} 
                y2={t.y} 
                class="graph-edge" 
              />
              <!-- Midpoint relation marker -->
              <circle cx={(s.x + t.x)/2} cy={(s.y + t.y)/2} r="1.5" class="edge-dot" />
            </g>
          );
        })}
      </g>

      <!-- Nodes -->
      <g class="graph-nodes" id="svg-nodes">
        {ATLAS_NODES.map(node => {
          const clusterMeta = ATLAS_CLUSTERS.find(c => c.id === node.cluster);
          const color = clusterMeta?.color || 'var(--color-primary)';
          const r = node.tier === 'Tier A' ? 8 : 6;
          return (
            <g 
              class="node-group" 
              data-node-id={node.id} 
              data-cluster={node.cluster}
              data-tier={node.tier}
              transform={`translate(${node.x}, ${node.y})`}
              tabindex="0"
              role="button"
              aria-label={`${node.name} (${node.tier}) - ${node.cluster}`}
            >
              <!-- Outer pulse ring on hover/focus -->
              <circle r={r + 3} class="node-halo" style={`stroke: ${color};`} />
              
              <!-- Core node circle -->
              <circle 
                r={r} 
                class="node-core" 
                style={`fill: ${color};`} 
              />
              
              <!-- Inner center pin -->
              <circle r="2.5" class="node-pin" />

              <!-- Short label. Full name lives in the inspector. -->
              <text
                y={r + 5}
                class="node-label"
                text-anchor="middle"
              >
                {node.label.map((line, lineIndex) => (
                  <tspan x="0" dy={lineIndex === 0 ? 0 : 4.3}>{line}</tspan>
                ))}
              </text>
            </g>
          );
        })}
      </g>
    </svg>
    </div>

    <aside class="atlas-inspector-card" id="inspector-card" aria-live="polite">
      <p class="inspector-prompt" id="inspector-prompt">Select a node to inspect its architecture.</p>
      <div class="inspector-body" id="inspector-body" hidden>
        <div class="inspector-header">
          <span class="inspector-badge" id="insp-badge">Flagship System</span>
          <button type="button" class="inspector-close" id="insp-close" aria-label="Close inspector">Close</button>
        </div>

        <h3 class="inspector-title" id="insp-title"></h3>
        <div class="inspector-cluster" id="insp-cluster"></div>

        <p class="inspector-desc" id="insp-desc"></p>

        <div class="inspector-diff-box">
          <strong>Key Differentiator:</strong>
          <p id="insp-diff"></p>
        </div>

        <div class="inspector-connections">
          <strong>Architectural Links:</strong>
          <ul id="insp-links-list"></ul>
        </div>

        <div class="inspector-footer">
          <a href={`${base}/projects/`} class="btn-inspect-action" id="insp-cta">
            Explore Technical Case Study →
          </a>
        </div>
      </div>
    </aside>
  </div>

  <!-- Accessible 2D Fallback List View -->
  <div class="atlas-list-view" id="atlas-list-view" hidden>
    <div class="list-grid">
      {ATLAS_NODES.map(node => (
        <article class="list-card" data-cluster={node.cluster}>
          <div class="list-card-top">
            <span class="pill-tier">{node.tier}</span>
            <span class="pill-cluster">{node.cluster}</span>
            <span class="pill-stage">{node.stage}</span>
          </div>
          <h4>{node.name}</h4>
          <p class="desc">{node.shortDesc}</p>
          <div class="diff-block">
            <strong>Differentiator:</strong> {node.differentiator}
          </div>
          {node.slug && (
            <a href={`${base}/projects/${node.slug}/`} class="card-link">
              Read Case Study →
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  import { ATLAS_NODES, ATLAS_LINKS } from '../lib/atlas-graph.ts';

  function initAtlasGraph() {
    const base = '/Profie-website.github.io';
    const widget = document.getElementById('systems-atlas-widget');
    if (!widget) return;

    const svg = document.getElementById('atlas-svg');
    const nodeGroups = widget.querySelectorAll<SVGGElement>('.node-group');
    const linkGroups = widget.querySelectorAll<SVGGElement>('.link-group');
    const clusterBtns = widget.querySelectorAll<HTMLButtonElement>('.cluster-btn');
    const btnGraph = widget.querySelector<HTMLButtonElement>('#btn-view-graph');
    const btnList = widget.querySelector<HTMLButtonElement>('#btn-view-list');
    const graphWrapper = widget.querySelector<HTMLElement>('#graph-wrapper');
    const listView = widget.querySelector<HTMLElement>('#atlas-list-view');

    // Inspector elements
    const inspector = widget.querySelector<HTMLElement>('#inspector-card');
    const inspectorPrompt = widget.querySelector<HTMLElement>('#inspector-prompt');
    const inspectorBody = widget.querySelector<HTMLElement>('#inspector-body');
    const inspBadge = widget.querySelector<HTMLElement>('#insp-badge');
    const inspTitle = widget.querySelector<HTMLElement>('#insp-title');
    const inspCluster = widget.querySelector<HTMLElement>('#insp-cluster');
    const inspDesc = widget.querySelector<HTMLElement>('#insp-desc');
    const inspDiff = widget.querySelector<HTMLElement>('#insp-diff');
    const inspLinksList = widget.querySelector<HTMLElement>('#insp-links-list');
    const inspCta = widget.querySelector<HTMLAnchorElement>('#insp-cta');
    const inspClose = widget.querySelector<HTMLElement>('#insp-close');

    function showInspector(nodeId: string) {
      const node = ATLAS_NODES.find(n => n.id === nodeId);
      if (!node || !inspector) return;

      inspectorPrompt?.setAttribute('hidden', '');
      inspectorBody?.removeAttribute('hidden');
      if (inspBadge) inspBadge.textContent = `${node.tier} · ${node.stage}`;
      if (inspTitle) inspTitle.textContent = node.name;
      if (inspCluster) inspCluster.textContent = node.cluster;
      if (inspDesc) inspDesc.textContent = node.shortDesc;
      if (inspDiff) inspDiff.textContent = node.differentiator;

      if (inspCta) {
        if (node.slug) {
          inspCta.href = `${base}/projects/${node.slug}/`;
          inspCta.textContent = 'Explore Technical Case Study →';
          inspCta.style.display = 'inline-flex';
        } else {
          inspCta.href = `${base}/projects/`;
          inspCta.textContent = 'View in Systems Catalog →';
          inspCta.style.display = 'inline-flex';
        }
      }

      // Populate links
      if (inspLinksList) {
        inspLinksList.innerHTML = '';
        const connected = ATLAS_LINKS.filter(l => l.source === nodeId || l.target === nodeId);
        if (connected.length === 0) {
          inspLinksList.innerHTML = '<li>Standalone system cluster node</li>';
        } else {
          connected.forEach(link => {
            const otherId = link.source === nodeId ? link.target : link.source;
            const otherNode = ATLAS_NODES.find(n => n.id === otherId);
            const li = document.createElement('li');
            li.textContent = `${otherNode?.name || otherId}: ${link.relation}`;
            inspLinksList.appendChild(li);
          });
        }
      }

      inspector.classList.add('visible');

      // Highlight active node and connected links in SVG
      nodeGroups.forEach(g => {
        const isSelf = g.dataset.nodeId === nodeId;
        g.classList.toggle('selected', isSelf);
      });

      linkGroups.forEach(lg => {
        const isConnected = lg.dataset.source === nodeId || lg.dataset.target === nodeId;
        lg.classList.toggle('highlighted', isConnected);
      });
    }

    // Node Click and Keyboard Enter/Space
    nodeGroups.forEach(g => {
      const id = g.dataset.nodeId;
      if (!id) return;

      g.onclick = (e) => {
        e.stopPropagation();
        showInspector(id);
      };

      g.onkeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          showInspector(id);
        }
      };

      g.onmouseenter = () => {
        linkGroups.forEach(lg => {
          const isConnected = lg.dataset.source === id || lg.dataset.target === id;
          lg.classList.toggle('hovered', isConnected);
        });
      };

      g.onmouseleave = () => {
        linkGroups.forEach(lg => lg.classList.remove('hovered'));
      };
    });

    // Close inspector
    if (inspClose) {
      inspClose.onclick = () => {
        inspector?.classList.remove('visible');
        inspectorBody?.setAttribute('hidden', '');
        inspectorPrompt?.removeAttribute('hidden');
        nodeGroups.forEach(g => g.classList.remove('selected'));
        linkGroups.forEach(lg => lg.classList.remove('highlighted'));
      };
    }

    // Cluster Filter Buttons
    clusterBtns.forEach(btn => {
      btn.onclick = () => {
        clusterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cluster = btn.dataset.cluster;
        nodeGroups.forEach(g => {
          const match = cluster === 'all' || g.dataset.cluster === cluster;
          g.style.opacity = match ? '1' : '0.15';
          g.style.pointerEvents = match ? 'auto' : 'none';
        });

        linkGroups.forEach(lg => {
          const s = ATLAS_NODES.find(n => n.id === lg.dataset.source);
          const t = ATLAS_NODES.find(n => n.id === lg.dataset.target);
          const match = cluster === 'all' || (s?.cluster === cluster || t?.cluster === cluster);
          lg.style.opacity = match ? '1' : '0.1';
        });

        // Filter list view items as well
        const listCards = widget.querySelectorAll<HTMLElement>('.list-card');
        listCards.forEach(c => {
          const match = cluster === 'all' || c.dataset.cluster === cluster;
          c.style.display = match ? 'flex' : 'none';
        });
      };
    });

    // Toggle View Mode (Graph vs List)
    if (btnGraph) {
      btnGraph.onclick = () => {
        btnGraph.classList.add('active');
        btnGraph.setAttribute('aria-pressed', 'true');
        btnList?.classList.remove('active');
        btnList?.setAttribute('aria-pressed', 'false');
        if (graphWrapper) graphWrapper.hidden = false;
        if (listView) listView.hidden = true;
      };
    }

    if (btnList) {
      btnList.onclick = () => {
        btnList.classList.add('active');
        btnList.setAttribute('aria-pressed', 'true');
        btnGraph?.classList.remove('active');
        btnGraph?.setAttribute('aria-pressed', 'false');
        if (graphWrapper) graphWrapper.hidden = true;
        if (listView) listView.hidden = false;
      };
    }
  }

  // Register on both standard load and astro:page-load
  document.addEventListener('astro:page-load', initAtlasGraph);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAtlasGraph);
  } else {
    initAtlasGraph();
  }
</script>

<style>
.atlas-system-widget {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-md);
  margin: var(--space-8) 0;
  overflow: hidden;
}

/* Control Bar */
.atlas-controls-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--color-border);
}

.cluster-filters {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.cluster-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: var(--space-1) var(--space-3);
  font-size: 11px;
  font-weight: 600;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
}

.cluster-btn .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.cluster-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-text);
}

.cluster-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-on-primary);
}

.view-mode-toggle {
  display: flex;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 2px;
}

.mode-btn {
  padding: 3px 12px;
  font-size: 11px;
  font-weight: 600;
  background: transparent;
  border: none;
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: color var(--duration-fast), background-color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
}

.mode-btn.active {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

/* Map + docked inspector. The canvas clips the SVG only, never the card. */
.atlas-stage {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: var(--space-4);
  margin-top: var(--space-4);
  align-items: stretch;
}

/* Graph Canvas Area */
.graph-canvas-wrapper {
  position: relative;
  width: 100%;
  height: 560px;
  min-width: 0;
  background: radial-gradient(circle at 50% 50%, var(--color-surface-raised) 0%, var(--color-bg) 95%);
  border-radius: var(--radius-md);
  overflow: hidden;
}

#atlas-svg {
  width: 100%;
  height: 100%;
  cursor: grab;
}

/* SVG Elements */
.radar-circle {
  fill: none;
  stroke: var(--color-border);
  stroke-width: 0.8;
  stroke-dasharray: 2 2;
  opacity: 0.6;
}

.axis-line {
  stroke: var(--color-border);
  stroke-width: 0.7;
  opacity: 0.4;
}

.graph-edge {
  stroke: var(--color-border-hover);
  stroke-width: 1.8;
  stroke-dasharray: 3 1.5;
  transition: stroke var(--duration-fast), stroke-width var(--duration-fast);
}

.edge-dot {
  fill: var(--color-border-hover);
  opacity: 0.7;
}

.link-group.hovered .graph-edge,
.link-group.highlighted .graph-edge {
  stroke: var(--color-primary);
  stroke-width: 2.2;
  stroke-dasharray: none;
}

.link-group.highlighted .edge-dot {
  fill: var(--color-primary);
  r: 2.5;
}

/* Nodes */
.node-group {
  cursor: pointer;
  outline: none;
  transition: transform var(--duration-fast);
}

.node-halo {
  fill: transparent;
  stroke-width: 1.5;
  opacity: 0;
  transition: opacity var(--duration-fast), r var(--duration-fast);
}

.node-core {
  stroke: var(--color-surface);
  stroke-width: 1.5;
  transition: filter var(--duration-fast), r var(--duration-fast);
}

.node-pin {
  fill: #FFFFFF;
}

.node-label {
  font-family: var(--font-sans);
  font-size: 3.6px;
  font-weight: 700;
  fill: var(--color-text);
  paint-order: stroke;
  stroke: var(--color-bg);
  stroke-width: 0.35;
  stroke-linejoin: round;
  pointer-events: none;
  transition: fill var(--duration-fast);
}

.node-group:hover .node-halo,
.node-group:focus-visible .node-halo,
.node-group.selected .node-halo {
  opacity: 0.8;
  r: 12;
}

.node-group:hover .node-core,
.node-group:focus-visible .node-core,
.node-group.selected .node-core {
  filter: url(#node-glow);
}

.node-group.selected .node-label {
  fill: var(--color-primary);
  font-weight: 800;
  font-size: 3.8px;
}

/* Inspector dock — always in flow, never over the SVG */
.atlas-inspector-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-height: 0;
}

.inspector-prompt {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
  line-height: 1.5;
}

.inspector-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.inspector-body[hidden] {
  display: none;
}

.inspector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.inspector-badge {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-primary);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: 2px 8px;
  border-radius: var(--radius-full);
}

.inspector-close {
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  cursor: pointer;
  font-size: 14px;
}

.inspector-title {
  margin: 0;
  font-size: var(--text-base);
  font-weight: 800;
  color: var(--color-text);
}

.inspector-cluster {
  font-size: var(--text-xs);
  color: var(--color-primary);
  font-weight: 600;
}

.inspector-desc {
  margin: 0;
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.inspector-diff-box {
  background: var(--color-surface-raised);
  border-left: 3px solid var(--color-primary);
  padding: var(--space-2) var(--space-3);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 11px;
}

.inspector-diff-box p {
  margin: 2px 0 0;
  color: var(--color-text-secondary);
}

.inspector-connections {
  font-size: 11px;
}

.inspector-connections ul {
  margin: 4px 0 0;
  padding-left: var(--space-4);
  color: var(--color-text-secondary);
}

.inspector-footer {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1px solid var(--color-border);
}

.btn-inspect-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: var(--space-2);
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--color-on-primary);
  background: var(--color-primary);
  border-radius: var(--radius-sm);
  text-decoration: none;
  transition: background-color var(--duration-fast);
}

.btn-inspect-action:hover {
  background: var(--color-primary-hover);
}

/* List View (2D Fallback) */
.atlas-list-view {
  margin-top: var(--space-4);
}

.list-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-4);
}

.list-card {
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.list-card-top {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.pill-tier, .pill-cluster, .pill-stage {
  font-size: 10px;
  padding: 1px 6px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text-secondary);
}

.pill-tier {
  font-weight: 700;
  color: var(--color-primary);
}

.list-card h4 {
  margin: 0;
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text);
}

.list-card .desc {
  margin: 0;
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  line-height: 1.5;
  flex-grow: 1;
}

.diff-block {
  font-size: 11px;
  color: var(--color-text-secondary);
  border-left: 2px solid var(--color-primary);
  padding-left: var(--space-2);
}

.list-card .card-link {
  font-size: var(--text-xs);
