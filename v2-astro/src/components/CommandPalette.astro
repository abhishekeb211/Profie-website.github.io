---
/**
 * CommandPalette.astro — Terminal-grade hacker command palette (Cmd+K / Ctrl+K / '/')
 * Keyboard-first navigation:
 * - Jump between sections (#projects, #teaching, #atlas-graph, #experience, #contact)
 * - Switch persona (AI Architect <-> Professor)
 * - Toggle theme (Light <-> Dark <-> System Auto)
 * - Quick utilities (Copy official email, view resume, view GitHub)
 */
const base = import.meta.env.BASE_URL;
const architectHref = `${base}/`;
const profHref = `${base}/professor/`;
const resumeHref = `${base}/resume.pdf`;
---

<!-- Trigger Button floating indicator for mobile & quick access -->
<button 
  type="button" 
  class="palette-trigger-btn" 
  id="open-command-palette-btn" 
  aria-label="Open Command Palette (Cmd+K or /)"
  title="Press Cmd+K or / to open Command Palette"
>
  <span class="palette-kbd">⌘K</span>
  <span class="palette-label">Terminal</span>
</button>

<!-- Modal Overlay -->
<div id="command-palette-modal" class="palette-modal" hidden role="dialog" aria-modal="true" aria-label="Command Palette">
  <div class="palette-backdrop" id="palette-backdrop"></div>
  <div class="palette-window">
    <div class="palette-search-row">
      <span class="terminal-prompt">$</span>
      <input 
        type="text" 
        id="palette-input" 
        class="palette-input" 
        placeholder="Type a command or jump to section... (e.g. 'projects', 'dark', 'resume')"
        autocomplete="off" 
        spellcheck="false" 
      />
      <span class="palette-close-hint">ESC</span>
    </div>

    <div class="palette-results" id="palette-results" role="listbox">
      <!-- Section: Navigation -->
      <div class="palette-group-title">Navigation & Sections</div>
      <a href="#about" class="palette-item" data-action="nav" data-keywords="about hero intro bio">
        <span class="item-icon">⚡</span>
        <span class="item-title">About & Research Summary</span>
        <span class="item-shortcut">#about</span>
      </a>
      <a href="#projects" class="palette-item" data-action="nav" data-keywords="projects case studies code paradox sanjaya">
        <span class="item-icon">📁</span>
        <span class="item-title">Engineering Projects & Flagships</span>
        <span class="item-shortcut">#projects</span>
      </a>
      <a href="#atlas-graph" class="palette-item" data-action="nav" data-keywords="atlas graph 3d constellation architecture">
        <span class="item-icon">🕸️</span>
        <span class="item-title">Systems Atlas Constellation</span>
        <span class="item-shortcut">#atlas-graph</span>
      </a>
      <a href="#experience" class="palette-item" data-action="nav" data-keywords="experience leadership timeline clubs">
        <span class="item-icon">💼</span>
        <span class="item-title">Experience & Leadership</span>
        <span class="item-shortcut">#experience</span>
      </a>
      <a href="#contact" class="palette-item" data-action="nav" data-keywords="contact email pccoe collaborate message">
        <span class="item-icon">✉️</span>
        <span class="item-title">Contact & Faculty Office</span>
        <span class="item-shortcut">#contact</span>
      </a>

      <!-- Section: Persona Switching -->
      <div class="palette-group-title">Persona View</div>
      <a href={architectHref} class="palette-item" data-action="persona" data-keywords="architect ai engineering r&d">
        <span class="item-icon">🤖</span>
        <span class="item-title">Switch to AI Architect Persona</span>
        <span class="item-shortcut">/</span>
      </a>
      <a href={profHref} class="palette-item" data-action="persona" data-keywords="professor educator teaching pccoe faculty">
        <span class="item-icon">🎓</span>
        <span class="item-title">Switch to Professor & Faculty Persona</span>
        <span class="item-shortcut">/professor/</span>
      </a>

      <!-- Section: Appearance & Themes -->
      <div class="palette-group-title">System & Theme Controls</div>
      <button type="button" class="palette-item" data-action="theme" data-theme="dark" data-keywords="dark mode black cyber terminal">
        <span class="item-icon">🌙</span>
        <span class="item-title">Set Dark Mode</span>
        <span class="item-shortcut">Theme: Dark</span>
      </button>
      <button type="button" class="palette-item" data-action="theme" data-theme="light" data-keywords="light mode day bright">
        <span class="item-icon">☀️</span>
        <span class="item-title">Set Professional Light Mode</span>
        <span class="item-shortcut">Theme: Light</span>
      </button>
      <button type="button" class="palette-item" data-action="theme" data-theme="system" data-keywords="auto system os reset">
        <span class="item-icon">⚙️</span>
        <span class="item-title">Follow Device / OS Appearance</span>
        <span class="item-shortcut">Theme: Auto</span>
      </button>

      <!-- Section: Utilities -->
      <div class="palette-group-title">Utilities & Quick Links</div>
      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="palette-item" data-action="util" data-keywords="resume cv pdf download">
        <span class="item-icon">📄</span>
        <span class="item-title">View / Download Resume (PDF)</span>
        <span class="item-shortcut">resume.pdf ↗</span>
      </a>
      <button type="button" class="palette-item" id="copy-email-item" data-action="copy" data-keywords="copy email address mail abhishek">
        <span class="item-icon">📋</span>
        <span class="item-title">Copy Official Email (abhishek.raut@pccoepune.org)</span>
        <span class="item-shortcut">Copy</span>
      </button>
      <a href="https://github.com/abhishekeb211" target="_blank" rel="noopener noreferrer" class="palette-item" data-action="util" data-keywords="github code repos open source">
        <span class="item-icon">💻</span>
        <span class="item-title">GitHub Profile (@abhishekeb211)</span>
        <span class="item-shortcut">GitHub ↗</span>
      </a>
    </div>

    <div class="palette-footer">
      <span>Use <kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>Enter</kbd> to select</span>
      <span><kbd>Esc</kbd> to close</span>
    </div>
  </div>
</div>

<script>
  function setupCommandPalette() {
    const triggerBtn = document.getElementById('open-command-palette-btn');
    const modal = document.getElementById('command-palette-modal');
    const backdrop = document.getElementById('palette-backdrop');
    const input = document.getElementById('palette-input') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLElement>('.palette-item');
    const copyEmailBtn = document.getElementById('copy-email-item');

    if (!modal || !input) return;

    let activeIndex = -1;

    const getVisibleItems = () => {
      return Array.from(items).filter(item => item.style.display !== 'none');
    };

    const updateActiveItem = (newIndex: number) => {
      const visible = getVisibleItems();
      visible.forEach(item => item.classList.remove('active'));
      if (visible.length === 0) {
        activeIndex = -1;
        return;
      }
      activeIndex = Math.max(0, Math.min(newIndex, visible.length - 1));
      visible[activeIndex].classList.add('active');
      visible[activeIndex].scrollIntoView({ block: 'nearest' });
    };

    const openModal = () => {
      modal.hidden = false;
      input.value = '';
      items.forEach(item => item.style.display = 'flex');
      document.querySelectorAll('.palette-group-title').forEach(t => (t as HTMLElement).style.display = 'block');
      input.focus();
      updateActiveItem(0);
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
      triggerBtn?.focus();
    };

    triggerBtn?.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);

    // Filter input
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      items.forEach(item => {
        const text = (item.textContent || '').toLowerCase();
        const keywords = item.dataset.keywords || '';
        const match = q === '' || text.includes(q) || keywords.includes(q);
        item.style.display = match ? 'flex' : 'none';
      });

      // Hide headers if no matching children
      document.querySelectorAll('.palette-group-title').forEach(header => {
        let sibling = header.nextElementSibling as HTMLElement | null;
        let hasVisible = false;
        while (sibling && !sibling.classList.contains('palette-group-title')) {
          if (sibling.style.display !== 'none') hasVisible = true;
          sibling = sibling.nextElementSibling as HTMLElement | null;
        }
        (header as HTMLElement).style.display = hasVisible ? 'block' : 'none';
      });

      updateActiveItem(0);
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      // Open with Cmd+K or Ctrl+K
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.hidden) openModal();
        else closeModal();
        return;
      }

      // Open with '/' only when explicitly focused outside any text field or active content
      if (
        e.key === '/' && 
        modal.hidden && 
        document.activeElement?.tagName !== 'INPUT' && 
        document.activeElement?.tagName !== 'TEXTAREA' &&
        !(document.activeElement as HTMLElement)?.isContentEditable
      ) {
        // Do not intercept if user was typing
        e.preventDefault();
        openModal();
        return;
      }

      if (modal.hidden) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateActiveItem(activeIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateActiveItem(activeIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const visible = getVisibleItems();
        if (visible[activeIndex]) {
          visible[activeIndex].click();
          closeModal();
        }
      }
    });

    // Wire actions inside items
    items.forEach(item => {
      item.addEventListener('click', () => {
        const action = item.dataset.action;
        if (action === 'theme') {
          const theme = item.dataset.theme;
          window.dispatchEvent(new CustomEvent('atlas:theme-selection', { detail: theme }));
        }
        closeModal();
      });
    });

    // Copy official email
    copyEmailBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.clipboard?.writeText('abhishek.raut@pccoepune.org').then(() => {
        const title = copyEmailBtn.querySelector('.item-title');
        if (title) title.textContent = '✓ Copied abhishek.raut@pccoepune.org!';
        setTimeout(() => {
          if (title) title.textContent = 'Copy Official Email (abhishek.raut@pccoepune.org)';
        }, 2000);
      });
    });
  }

  // Register on both standard load and astro:page-load
  document.addEventListener('astro:page-load', setupCommandPalette);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCommandPalette);
  } else {
    setupCommandPalette();
  }
</script>

<style>
/* Floating Trigger Button */
.palette-trigger-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 4px 10px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  cursor: pointer;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}

.palette-trigger-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-text);
}

.palette-kbd {
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 1px 5px;
  font-weight: 700;
  color: var(--color-primary);
}

/* Modal Overlay */
.palette-modal {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 12vh;
}

.palette-backdrop {
  position: absolute;
  inset: 0;
  background: rgb(15 23 42 / 0.65);
  backdrop-filter: blur(6px);
}

.palette-window {
  position: relative;
  width: 90%;
  max-width: 620px;
  max-height: 72vh;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg), 0 20px 40px rgb(0 0 0 / 0.25);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: modalIn var(--duration-fast) var(--ease-out);
}

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.96) translateY(-10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.palette-search-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
}

.terminal-prompt {
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--color-primary);
  font-size: var(--text-base);
}

.palette-input {
  flex-grow: 1;
  background: transparent;
  border: none;
  outline: none;
  font-size: var(--text-sm);
  color: var(--color-text);
  font-family: var(--font-mono);
}

.palette-close-hint {
  font-size: 10px;
  font-family: var(--font-mono);
  padding: 2px 6px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
}

.palette-results {
  overflow-y: auto;
  padding: var(--space-2) var(--space-3);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.palette-group-title {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
  color: var(--color-text-secondary);
  padding: var(--space-3) var(--space-3) var(--space-1);
}

.palette-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  text-decoration: none;
  color: var(--color-text);
  font-size: var(--text-xs);
  cursor: pointer;
  background: transparent;
  border: none;
  width: 100%;
  text-align: left;
  transition: background-color var(--duration-fast);
}

.palette-item:hover,
.palette-item.active {
  background: var(--color-surface);
  color: var(--color-primary);
}

.item-icon {
  font-size: 14px;
}

.item-title {
  flex-grow: 1;
  font-weight: 500;
}

.item-shortcut {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--color-text-secondary);
}

.palette-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-4);
  padding: var(--space-2) var(--space-4);
  border-top: 1px solid var(--color-border);
  background: var(--color-surface);
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
}

.palette-footer kbd {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  padding: 1px 4px;
  border-radius: 3px;
  font-weight: 600;
}
</style>
