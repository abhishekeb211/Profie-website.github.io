---
// ProjectCard.astro — Accessible project card conforming to contrast rules and linking to deep-dive case studies
import { getShowcaseForProject, getProjectIdentity } from '../data/showcaseRegistry';
import AnimatedProjectSVG from './AnimatedProjectSVG.astro';

interface Props {
  project: {
    id: string;
    title: string;
    domain: string;
    summary?: string;
    tagline?: string;
    role: string;
    stack: string[];
    status?: string;
    stage?: string;
    outcome?: string;
    metrics?: Array<{ label: string; value: string; unit?: string }>;
    github?: string;
    link?: string;
  };
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const desc = project.tagline || project.summary || '';
const stageBadge = project.stage || project.status || 'Prototype';
const showcase = getShowcaseForProject(project.id);
const heroImage = showcase?.heroImage;
const identity = getProjectIdentity(project.id);
const displayTitle = identity.publicTitle;
const displaySubtitle = identity.engineeringSubtitle;
const displaySummary = identity.humanSummary || desc;
const displayMetric = identity.humanMetric;

const svgVariantMap: Record<string, 'codeagent' | 'samanvay' | 'swasthya' | 'zerotrust' | 'cli-terminal'> = {
  'codeagent': 'codeagent',
  'vulrag-security': 'codeagent',
  'agentic-browser-defense': 'zerotrust',
  'hierarchical-ids': 'zerotrust',
  'swasthya-health-network': 'swasthya',
  'blockchain-ehr-bcfl': 'swasthya',
  'supper-ide': 'cli-terminal',
  'operon-extension': 'cli-terminal',
  'mc-ctvit-eeg-transformer': 'samanvay',
  'sanjaya-ai': 'samanvay'
};
const svgVariant = svgVariantMap[project.id];
---
<article class="project-card" data-domain={identity.domainKey || 'systems'} style={`--card-accent: ${identity.domainColor || 'var(--color-primary)'};`}>
  {svgVariant ? (
    <a href={`${base}/projects/${project.id}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
      <div class="card-thumb-wrap card-svg-wrap">
        <AnimatedProjectSVG variant={svgVariant} title={`${project.title} Architecture Flow`} />
        <div class="card-thumb-overlay">
          <span class="card-thumb-badge">Live Architecture DAG</span>
        </div>
      </div>
    </a>
  ) : heroImage ? (
    <a href={`${base}/projects/${project.id}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
      <div class="card-thumb-wrap">
        <img
          src={heroImage}
          alt=""
          loading="lazy"
          class="card-thumb-img"
        />
        <div class="card-thumb-overlay">
          <span class="card-thumb-badge">System Blueprint</span>
        </div>
      </div>
    </a>
  ) : null}

  <div class="card-meta">
    <span class="card-domain">{identity.domainLabel || project.domain}</span>
    {identity.highlightTag ? (
      <span class="card-highlight">{identity.highlightTag}</span>
    ) : (
      <span class="card-status">{stageBadge}</span>
    )}
  </div>

  <h3 class="card-title">
    <a href={`${base}/projects/${project.id}/`}>{displayTitle}</a>
  </h3>

  <p class="card-tech-sub" title={project.title}>
    <span class="tech-sub-prefix">Architecture:</span> {displaySubtitle}
  </p>
  
  <p class="card-summary">{displaySummary}</p>

  {displayMetric && (
    <div class="card-metrics-row">
      <span class="metric-badge">
        <strong class="metric-val">{displayMetric.value}</strong> <span class="metric-lbl">{displayMetric.label}</span>
      </span>
    </div>
  )}

  <div class="card-tags" aria-label="Key Technologies">
    {project.stack.slice(0, 3).map(tech => (
      <span class="tag-chip">{tech}</span>
    ))}
  </div>

  <div class="card-footer">
    <div class="card-actions-left">
      <a href={`${base}/projects/${project.id}/`} class="case-study-link">
        Explore System →
      </a>
      <button
        type="button"
        class="arch-explore-trigger"
        data-project-id={project.id}
        data-project-title={displayTitle}
        data-project-tagline={displaySummary}
        data-project-url={`${base}/projects/${project.id}/`}
        data-dossier-id={showcase?.deepArchitecture.dossierId || 'DOS-AUDITED'}
        data-pass-rate={showcase?.deepArchitecture.testPassRate || '100% Passed'}
        data-docker-services={JSON.stringify(showcase?.deepArchitecture.dockerServices || ['service-core', 'service-api'])}
        aria-label={`Inspect ${project.title} Architecture Flow`}
      >
        Architecture ⊕
      </button>
    </div>
    <div class="card-external-links">
      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`${project.title} GitHub repository`}>
          GitHub ↗
        </a>
      )}
    </div>
  </div>
</article>

<style>
.card-thumb-link {
  display: block;
  text-decoration: none;
  margin: calc(var(--space-6) * -1) calc(var(--space-6) * -1) var(--space-4) calc(var(--space-6) * -1);
  border-top-left-radius: calc(var(--radius-lg) - 1px);
  border-top-right-radius: calc(var(--radius-lg) - 1px);
  overflow: hidden;
}

.card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 160px;
  overflow: hidden;
  background: var(--color-surface-sunken);
}

.card-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform var(--duration-normal) var(--ease-default);
}

.project-card:hover .card-thumb-img {
  transform: scale(1.05);
}

.card-thumb-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.0) 30%, rgba(15, 23, 42, 0.8) 100%);
  display: flex;
  align-items: flex-end;
  padding: var(--space-2) var(--space-4);
}

.card-thumb-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #38bdf8;
  background: rgba(15, 23, 42, 0.85);
  padding: 2px 8px;
  border-radius: 9999px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.project-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-top: 3px solid var(--card-accent, var(--color-primary));
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  height: 100%;
  transition: transform var(--duration-fast) var(--ease-default), border-color var(--duration-fast), box-shadow var(--duration-fast);
  overflow: hidden;
}

.project-card:hover,
.project-card:focus-within {
  transform: translateY(-4px);
  border-color: var(--card-accent, var(--color-primary));
  box-shadow: 0 14px 28px -4px color-mix(in srgb, var(--card-accent, var(--color-primary)) 22%, transparent), 0 0 16px color-mix(in srgb, var(--card-accent, var(--color-primary)) 12%, transparent);
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
  font-size: var(--text-xs);
}

.card-domain {
  color: var(--card-accent, var(--color-primary));
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 11px;
}

.card-status {
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  font-size: 11px;
  font-weight: 600;
}

.card-highlight {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  color: var(--card-accent, #10b981);
  background: color-mix(in srgb, var(--card-accent, #10b981) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--card-accent, #10b981) 35%, transparent);
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.card-title {
  font-size: var(--text-lg);
  font-weight: 700;
  margin: 0 0 var(--space-1) 0;
  line-height: 1.3;
}

.card-title a {
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.card-title a:hover {
  color: var(--card-accent, var(--color-primary));
}

.card-tech-sub {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--card-accent, var(--color-primary));
  opacity: 0.88;
  margin: 0 0 var(--space-3) 0;
  line-height: 1.4;
}

.tech-sub-prefix {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 9px;
  opacity: 0.7;
}

.card-summary {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: var(--space-4);
  flex-grow: 1;
}

.card-metrics-row {
  margin-bottom: var(--space-4);
}

.metric-badge {
  font-size: var(--text-xs);
  color: var(--color-text);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  display: inline-block;
  line-height: 1.4;
}

.metric-val {
  color: var(--card-accent, var(--color-primary));
  font-weight: 800;
  font-family: var(--font-mono);
}

.metric-lbl {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.outcome-label {
  color: var(--card-accent, var(--color-primary));
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.tag-chip {
  font-size: var(--text-xs);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  padding: 2px var(--space-2);
  border-radius: var(--radius-full);
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-3);
  font-size: var(--text-xs);
  margin-top: auto;
  gap: var(--space-3);
}

.card-external-links {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.case-study-link {
  color: var(--card-accent, var(--color-primary));
  text-decoration: none;
  font-weight: 700;
}

.case-study-link:hover {
  text-decoration: underline;
}

.card-link {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-weight: 500;
}

.card-link:hover {
  color: var(--color-primary);
}
.card-actions-left {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.arch-explore-trigger {
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #38bdf8;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-default),
              border-color var(--duration-fast) var(--ease-default),
              color var(--duration-fast) var(--ease-default);
}

.arch-explore-trigger:hover {
  background: rgba(56, 189, 248, 0.2);
  border-color: #38bdf8;
  color: #fff;
}
</style>

<script>
  function setupCardTriggers() {
    document.querySelectorAll<HTMLButtonElement>('.arch-explore-trigger').forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        e.preventDefault();
        const data = {
          id: btn.getAttribute('data-project-id'),
          title: btn.getAttribute('data-project-title'),
          tagline: btn.getAttribute('data-project-tagline'),
          url: btn.getAttribute('data-project-url'),
          dossierId: btn.getAttribute('data-dossier-id'),
          passRate: btn.getAttribute('data-pass-rate'),
          dockerServices: JSON.parse(btn.getAttribute('data-docker-services') || '[]')
        };
        if (typeof (window as any).openArchitectureExplorer === 'function') {
          (window as any).openArchitectureExplorer(data);
        } else if (data.url) {
          window.location.href = data.url;
        }
      };
    });
  }
  setupCardTriggers();
  document.addEventListener('astro:page-load', setupCardTriggers);
</script>
