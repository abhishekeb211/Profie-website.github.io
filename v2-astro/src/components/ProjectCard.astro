---
// ProjectCard.astro — Accessible project card conforming to contrast rules and linking to deep-dive case studies
import { getShowcaseForProject } from '../data/showcaseRegistry';

interface Props {
  project: {
    id: string;
    title: string;
    domain: string;
    summary?: string;
    tagline?: string;
    role: string;
    stack: string[];
    status?: string;
    stage?: string;
    outcome?: string;
    metrics?: Array<{ label: string; value: string; unit?: string }>;
    github?: string;
    link?: string;
  };
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const desc = project.tagline || project.summary || '';
const stageBadge = project.stage || project.status || 'Prototype';
const showcase = getShowcaseForProject(project.id);
const heroImage = showcase?.heroImage;
---
<article class="project-card">
  {heroImage && (
    <a href={`${base}/projects/${project.id}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
      <div class="card-thumb-wrap">
        <img
          src={heroImage}
          alt=""
          loading="lazy"
          class="card-thumb-img"
        />
        <div class="card-thumb-overlay">
          <span class="card-thumb-badge">System Blueprint</span>
        </div>
      </div>
    </a>
  )}

  <div class="card-meta">
    <span class="card-domain">{project.domain}</span>
    <span class="card-status">{stageBadge}</span>
  </div>

  <h3 class="card-title">
    <a href={`${base}/projects/${project.id}/`}>{project.title}</a>
  </h3>
  
  <p class="card-summary">{desc}</p>

  {project.outcome && (
    <div class="card-outcome">
      <strong class="outcome-label">Key Outcome:</strong> {project.outcome}
    </div>
  )}

  {project.metrics && project.metrics.length > 0 && (
    <div class="card-metrics-row">
      <span class="metric-badge">
        <strong>{project.metrics[0].value}{project.metrics[0].unit || ''}</strong> {project.metrics[0].label}
      </span>
    </div>
  )}

  <div class="card-tags" aria-label="Technologies used">
    {project.stack.slice(0, 4).map(tech => (
      <span class="tag-chip">{tech}</span>
    ))}
  </div>

  <div class="card-footer">
    <a href={`${base}/projects/${project.id}/`} class="case-study-link">
      Read Case Study →
    </a>
    <div class="card-external-links">
      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`${project.title} GitHub repository`}>
          GitHub ↗
        </a>
      )}
      {project.link && (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="card-link" aria-label={`${project.title} External Resource`}>
          Resource ↗
        </a>
      )}
    </div>
  </div>
</article>

<style>
.card-thumb-link {
  display: block;
  text-decoration: none;
  margin: calc(var(--space-6) * -1) calc(var(--space-6) * -1) var(--space-4) calc(var(--space-6) * -1);
  border-top-left-radius: calc(var(--radius-lg) - 1px);
  border-top-right-radius: calc(var(--radius-lg) - 1px);
  overflow: hidden;
}

.card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 160px;
  overflow: hidden;
  background: var(--color-surface-sunken);
}

.card-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform var(--duration-normal) var(--ease-default);
}

.project-card:hover .card-thumb-img {
  transform: scale(1.05);
}

.card-thumb-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.0) 30%, rgba(15, 23, 42, 0.8) 100%);
  display: flex;
  align-items: flex-end;
  padding: var(--space-2) var(--space-4);
}

.card-thumb-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #38bdf8;
  background: rgba(15, 23, 42, 0.85);
  padding: 2px 8px;
  border-radius: 9999px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.project-card {
  display: flex;
  flex-direction: column;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  height: 100%;
  transition: transform var(--duration-fast) var(--ease-default), border-color var(--duration-fast), box-shadow var(--duration-fast);
}

.project-card:hover,
.project-card:focus-within {
  transform: translateY(-3px);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
  font-size: var(--text-xs);
}

.card-domain {
  color: var(--color-primary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.card-status {
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  font-size: 11px;
  font-weight: 600;
}

.card-title {
  font-size: var(--text-lg);
  font-weight: 700;
  margin: 0 0 var(--space-2) 0;
}

.card-title a {
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--duration-fast);
}

.card-title a:hover {
  color: var(--color-primary);
}

.card-summary {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: var(--space-4);
  flex-grow: 1;
}

.card-outcome {
  font-size: var(--text-xs);
  color: var(--color-text);
  background: var(--color-surface-raised);
  border-left: 3px solid var(--color-primary);
  padding: var(--space-2) var(--space-3);
  margin-bottom: var(--space-4);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

.card-metrics-row {
  margin-bottom: var(--space-4);
}

.metric-badge {
  font-size: var(--text-xs);
  color: var(--color-primary);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  display: inline-block;
}

.outcome-label {
  color: var(--color-primary);
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.tag-chip {
  font-size: var(--text-xs);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  padding: 2px var(--space-2);
  border-radius: var(--radius-full);
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-3);
  font-size: var(--text-xs);
  margin-top: auto;
  gap: var(--space-3);
}

.card-external-links {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.case-study-link {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 700;
}

.case-study-link:hover {
  text-decoration: underline;
}

.card-link {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-weight: 500;
}

.card-link:hover {
  color: var(--color-primary);
}
</style>
