    </div>
  </div>

  <div class="hud-live-tag">
    <span class="hud-tag-text">VERIFIED</span>
  </div>
</div>

<style>
.hud-ticker-wrap {
  display: flex;
  align-items: center;
  width: 100%;
  background: rgba(10, 15, 29, 0.95);
  border-top: 1px solid rgba(56, 189, 248, 0.2);
  border-bottom: 1px solid rgba(56, 189, 248, 0.2);
  font-family: var(--font-mono);
  font-size: 11px;
  overflow: hidden;
  position: relative;
  z-index: 20;
  backdrop-filter: blur(8px);
}

@media (max-width: 768px) {
  .hud-ticker-wrap {
    display: none;
  }
}

.hud-ticker-label {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: rgba(15, 23, 42, 0.95);
  border-right: 1px solid rgba(56, 189, 248, 0.25);
  white-space: nowrap;
  font-weight: 700;
  color: #38bdf8;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.hud-beacon {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 8px #22c55e;
  animation: hud-beacon-pulse 1.8s infinite ease-in-out;
}

@keyframes hud-beacon-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.hud-ticker-viewport {
  flex: 1;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
}

.hud-ticker-track {
  display: flex;
  align-items: center;
  gap: 16px;
  white-space: nowrap;
  animation: hud-scroll-loop 55s linear infinite;
  will-change: transform;
}

.hud-ticker-wrap:hover .hud-ticker-track {
  animation-play-state: paused;
}

@keyframes hud-scroll-loop {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.hud-item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.hud-key {
  color: #94a3b8;
  font-weight: 600;
}

.hud-val {
  font-weight: 700;
  letter-spacing: 0.04em;
}

.hud-val-cyan {
  color: #38bdf8;
  text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
}

.hud-val-green {
  color: #4ade80;
  text-shadow: 0 0 10px rgba(74, 222, 128, 0.4);
}

.hud-val-purple {
  color: #c084fc;
  text-shadow: 0 0 10px rgba(192, 132, 252, 0.4);
}

.hud-sep {
  color: #475569;
  font-weight: 800;
}

.hud-live-tag {
  padding: 8px 14px;
  background: rgba(15, 23, 42, 0.95);
  border-left: 1px solid rgba(56, 189, 248, 0.25);
  color: #22c55e;
  font-weight: 800;
  letter-spacing: 0.08em;
  flex-shrink: 0;
  display: none;
}

@media (min-width: 860px) {
  .hud-live-tag {
    display: block;
  }
}
</style>
