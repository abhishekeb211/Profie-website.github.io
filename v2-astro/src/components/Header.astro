---
// Header.astro — Sticky responsive header supporting persona switch, theme toggle, mobile drawer, and resume link
interface Props {
  activePersona: 'architect' | 'professor';
}

const { activePersona } = Astro.props;
const base = import.meta.env.BASE_URL;
const architectHref = `${base}/`;
const profHref = `${base}/professor/`;
const resumeHref = `${base}/Abhishek%20Raut%20Resume%200226.pdf`;
---
<header class="site-header">
  <div class="header-inner">
    <a href={activePersona === 'architect' ? architectHref : profHref} class="brand-link" aria-label="Abhishek S. Raut - Home">
      <span class="brand-name">Abhishek S. Raut</span>
      <span class="brand-tag">AI Research Engineer</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="#about" class="nav-item">About</a>
      <a href="#projects" class="nav-item">Projects</a>
      <a href="#experience" class="nav-item">Experience</a>
      {activePersona === 'professor' && <a href="#teaching" class="nav-item">Teaching</a>}
      <a href="#contact" class="nav-item">Contact</a>
    </nav>

    <!-- Controls: Persona Switch + Theme Toggle + Resume + Mobile Hamburger -->
    <div class="header-actions">
      <!-- Persona Segmented Control -->
      <div class="persona-switch" role="group" aria-label="Persona view">
        <a 
          href={architectHref} 
          class={`persona-btn ${activePersona === 'architect' ? 'active' : ''}`}
          aria-current={activePersona === 'architect' ? 'page' : undefined}
        >
          AI Architect
        </a>
        <a 
          href={profHref} 
          class={`persona-btn ${activePersona === 'professor' ? 'active' : ''}`}
          aria-current={activePersona === 'professor' ? 'page' : undefined}
        >
          Professor
        </a>
      </div>

      <!-- Theme Button -->
      <button 
        type="button" 
        class="theme-toggle-btn" 
        data-theme-toggle 
        aria-label="Switch to Console appearance"
        title="Toggle Light / Console appearance"
      >
        <span class="theme-icon light-icon" aria-hidden="true">☀️</span>
        <span class="theme-icon hacker-icon" aria-hidden="true">📟</span>
        <span class="theme-label">Theme</span>
      </button>

      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="resume-btn desktop-only">
        Resume ↗
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        type="button" 
        class="mobile-menu-btn" 
        id="mobile-menu-toggle" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer" hidden>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="#about" class="mobile-nav-item">About</a>
      <a href="#projects" class="mobile-nav-item">Projects</a>
      <a href="#experience" class="mobile-nav-item">Experience</a>
      {activePersona === 'professor' && <a href="#teaching" class="mobile-nav-item">Teaching</a>}
      <a href="#contact" class="mobile-nav-item">Contact</a>
      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="mobile-nav-item mobile-resume">
        View Resume ↗
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        drawer.hidden = true;
      } else {
        drawer.hidden = false;
      }
    });

    // Close drawer when clicking any link inside
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.hidden = true;
      });
    });
  }
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: var(--z-nav);
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  backdrop-filter: blur(8px);
  transition: background-color var(--duration-base) var(--ease-default), border-color var(--duration-base) var(--ease-default);
}

.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--space-3) var(--space-6);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.brand-link {
  text-decoration: none;
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-weight: 700;
  font-size: var(--text-base);
  color: var(--color-text);
}

.brand-tag {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.nav-links {
  display: none;
  gap: var(--space-6);
}

@media (min-width: 860px) {
  .nav-links {
    display: flex;
  }
}

.nav-item {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 500;
  transition: color var(--duration-fast) var(--ease-default);
}

.nav-item:hover {
  color: var(--color-primary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

/* Persona Switch */
.persona-switch {
  display: flex;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 2px;
}

.persona-btn {
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: 600;
  text-decoration: none;
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  transition: background-color var(--duration-fast), color var(--duration-fast);
}

.persona-btn.active {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

/* Theme Toggle Button */
.theme-toggle-btn {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: 600;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  color: var(--color-text);
  cursor: pointer;
  transition: border-color var(--duration-fast), background-color var(--duration-fast);
}

.theme-toggle-btn:hover {
  border-color: var(--color-primary);
}

:root[data-theme="light"] .hacker-icon { display: none; }
:root[data-theme="hacker"] .light-icon { display: none; }

.resume-btn {
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: 600;
  text-decoration: none;
  border: 1px solid var(--color-primary);
  color: var(--color-primary);
  border-radius: var(--radius-full);
  transition: background-color var(--duration-fast), color var(--duration-fast);
}

.resume-btn:hover {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.desktop-only {
  display: inline-block;
}

/* Mobile Hamburger Button */
.mobile-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: space-around;
  width: 32px;
  height: 32px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 4px;
}

.hamburger-bar {
  width: 100%;
  height: 2px;
  background-color: var(--color-text);
  border-radius: 1px;
  transition: all var(--duration-fast);
}

/* Mobile Drawer */
.mobile-drawer {
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-4) var(--space-6);
  animation: slideDown var(--duration-fast) var(--ease-out);
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

.mobile-nav {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.mobile-nav-item {
  color: var(--color-text);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 600;
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
}

.mobile-nav-item:last-child {
  border-bottom: none;
}

.mobile-resume {
  color: var(--color-primary);
}

@media (max-width: 860px) {
  .mobile-menu-btn {
    display: flex;
  }
  .desktop-only {
    display: none;
  }
}

@media (max-width: 600px) {
  .brand-tag { display: none; }
  .theme-label { display: none; }
  .persona-btn {
    padding: var(--space-1) var(--space-2);
    font-size: 11px;
  }
}
</style>
