---
// Header.astro — Sticky responsive header supporting persona switch, theme toggle, mobile drawer, and resume link
import Icon from './Icon.astro';

interface Props {
  activePersona: 'architect' | 'professor';
}

const { activePersona } = Astro.props;
const base = import.meta.env.BASE_URL;
const architectHref = `${base}/`;
const profHref = `${base}/professor/`;
const resumeHref = `${base}/resume.pdf`;

// Determine whether we are directly on the persona root page or a deep route
const currentPath = Astro.url.pathname;
const isArchitectHome = currentPath === `${base}/` || currentPath === base || currentPath === '/';
const isProfessorHome = currentPath.endsWith('/professor/') || currentPath.endsWith('/professor');

const homePrefix = activePersona === 'professor'
  ? (isProfessorHome ? '' : profHref)
  : (isArchitectHome ? '' : architectHref);

const onProjects = currentPath.includes('/projects');

const navItems = activePersona === 'professor'
  ? [
      { label: 'About', href: `${homePrefix}#about`, current: false },
      { label: 'Teaching', href: `${homePrefix}#teaching`, current: false },
      { label: 'Leadership', href: `${homePrefix}#leadership`, current: false },
      { label: 'Research', href: `${homePrefix}#research`, current: false },
      { label: 'Contact', href: `${homePrefix}#contact`, current: false },
    ]
  : [
      { label: 'About', href: `${homePrefix}#about`, current: false },
      { label: 'Cockpit', href: `${homePrefix}#cockpit`, current: false },
      { label: 'Atlas', href: `${homePrefix}#atlas-graph`, current: false },
      { label: 'Forensic Audit', href: `${homePrefix}#forensic-audit`, current: false },
      { label: 'Projects', href: `${base}/projects/`, current: onProjects },
      { label: 'Experience', href: `${homePrefix}#experience`, current: false },
      { label: 'Contact', href: `${homePrefix}#contact`, current: false },
    ];
---
<header class="site-header">
  <div class="header-inner">
    <a href={activePersona === 'architect' ? architectHref : profHref} class="brand-link" aria-label="Abhishek S. Raut - Home">
      <span class="brand-beacon" aria-hidden="true"></span>
      <span class="brand-name">Abhishek S. Raut</span>
      <span class="brand-tag">{activePersona === 'professor' ? 'Educator & Faculty' : 'AI Research Engineer'}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} class="nav-item" aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <!-- Controls: Persona Switch + Theme Controls + Resume + Mobile Hamburger -->
    <div class="header-actions">
      <!-- Persona Segmented Control -->
      <div class="persona-switch" role="group" aria-label="Persona view">
        <a 
          href={architectHref} 
          class={`persona-btn ${activePersona === 'architect' ? 'active' : ''}`}
          aria-current={activePersona === 'architect' ? 'page' : undefined}
        >
          AI Architect
        </a>
        <a 
          href={profHref} 
          class={`persona-btn ${activePersona === 'professor' ? 'active' : ''}`}
          aria-current={activePersona === 'professor' ? 'page' : undefined}
        >
          Professor
        </a>
      </div>

      <!-- Theme Actions: One-click Light/Dark Toggle + Device Auto Reset -->
      <div class="theme-actions" role="group" aria-label="Appearance controls">
        <button 
          type="button" 
          class="theme-toggle-btn" 
          data-theme-toggle 
          aria-label="Switch color theme"
          title="Switch Light/Dark"
        >
          <span class="theme-icon theme-icon-light" aria-hidden="true"><Icon name="sun" /></span>
          <span class="theme-icon theme-icon-dark" aria-hidden="true"><Icon name="moon" /></span>
        </button>
        <button 
          type="button" 
          class="theme-auto-btn" 
          data-theme-auto 
          aria-label="Use device appearance" 
          title="Follow device appearance"
        >
          Auto
        </button>
      </div>

      <a href={`${base}/COMPREHENSIVE_PORTFOLIO_FORENSIC_MASTER_REPORT.pdf`} target="_blank" rel="noopener noreferrer" class="report-btn desktop-only" title="79-Page Doctoral-Grade Master Forensic Report">
        Forensic Audit ↗
      </a>

      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="resume-btn desktop-only">
        Resume ↗
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        type="button" 
        class="mobile-menu-btn" 
        id="mobile-menu-toggle" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer" hidden>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navItems.map(item => (
        <a href={item.href} class="mobile-nav-item" aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={`${base}/COMPREHENSIVE_PORTFOLIO_FORENSIC_MASTER_REPORT.pdf`} target="_blank" rel="noopener noreferrer" class="mobile-nav-item mobile-report">
        Forensic Master Report (79p PDF) ↗
      </a>
      <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="mobile-nav-item mobile-resume">
        View Resume ↗
      </a>
      <a href={activePersona === 'architect' ? profHref : architectHref} class="mobile-nav-item">
        {activePersona === 'architect' ? 'Professor view' : 'AI Architect view'}
      </a>
    </nav>
  </div>
</header>

<script>
  function closeMobileDrawer() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    if (!toggleBtn || !drawer) return;
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.setAttribute('aria-label', 'Open navigation menu');
    drawer.hidden = true;
    document.body.style.overflow = '';
  }

  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    if (!toggleBtn || !drawer) return;

    closeMobileDrawer();

    toggleBtn.onclick = (e) => {
      e.stopPropagation();
      const willOpen = toggleBtn.getAttribute('aria-expanded') !== 'true';
      toggleBtn.setAttribute('aria-expanded', String(willOpen));
      toggleBtn.setAttribute('aria-label', willOpen ? 'Close navigation menu' : 'Open navigation menu');
      drawer.hidden = !willOpen;
      document.body.style.overflow = willOpen ? 'hidden' : '';
    };

    drawer.querySelectorAll('a').forEach(link => {
      link.onclick = () => closeMobileDrawer();
    });
  }

  if (!document.documentElement.dataset.mobileNavBound) {
    document.documentElement.dataset.mobileNavBound = 'true';
    document.addEventListener('click', (e) => {
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-drawer');
      if (!toggleBtn || !drawer || drawer.hidden) return;
      const target = e.target as Node | null;
      if (target && (drawer.contains(target) || toggleBtn.contains(target))) return;
      closeMobileDrawer();
    });
    document.addEventListener('keydown', (e) => {
      const drawer = document.getElementById('mobile-drawer');
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      if (e.key === 'Escape' && drawer && !drawer.hidden) {
        closeMobileDrawer();
        toggleBtn?.focus();
      }
    });
  }

  // Support both classic load and Astro ClientRouter page-load
  document.addEventListener('astro:page-load', setupMobileMenu);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: var(--z-nav);
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  backdrop-filter: blur(8px);
  transition: background-color var(--duration-base) var(--ease-default), border-color var(--duration-base) var(--ease-default);
}

.header-inner {
  max-width: min(96vw, 1720px);
  width: 100%;
  margin: 0 auto;
  padding: var(--space-2) var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.brand-link {
  text-decoration: none;
  display: flex;
  flex-direction: column;
  position: relative;
}

.brand-beacon {
  position: absolute;
  top: 7px;
  left: -12px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 8px #22c55e;
  animation: beacon-pulse 2s infinite ease-in-out;
}

@keyframes beacon-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.8); }
}

.brand-name {
  font-weight: 700;
  font-size: var(--text-base);
  color: var(--color-text);
}

.brand-tag {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}

.nav-links {
  display: none;
  gap: var(--space-6);
}

@media (min-width: 860px) {
  .nav-links {
    display: flex;
  }
}

.nav-item {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 500;
  transition: color var(--duration-fast) var(--ease-default);
}

.nav-item:hover,
.nav-item[aria-current="page"] {
  color: var(--color-primary);
}

.nav-item[aria-current="page"] {
  font-weight: 700;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

/* Persona Switch */
.persona-switch {
  display: flex;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 2px;
}

.persona-btn {
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: 600;
  text-decoration: none;
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  transition: background-color var(--duration-fast), color var(--duration-fast);
}

.persona-btn.active {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

/* Theme Controls */
.theme-actions {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 2px;
  gap: 2px;
}

.theme-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: var(--radius-full);
  color: var(--color-text);
  cursor: pointer;
  font-size: 14px;
  transition: background-color var(--duration-fast);
}

.theme-toggle-btn:hover {
  background: var(--color-surface-raised);
}

.theme-auto-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 8px;
  height: 28px;
  background: transparent;
  border: none;
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  cursor: pointer;
  font-size: 11px;
  font-weight: 600;
  transition: background-color var(--duration-fast), color var(--duration-fast);
}

.theme-auto-btn:hover {
  color: var(--color-text);
}

.theme-auto-btn.active,
.theme-auto-btn[aria-pressed="true"] {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

:root[data-theme="light"] .theme-icon-light { display: inline-block; }
:root[data-theme="light"] .theme-icon-dark  { display: none; }
:root[data-theme="dark"] .theme-icon-light  { display: none; }
:root[data-theme="dark"] .theme-icon-dark   { display: inline-block; }
:root[data-theme="hacker"] .theme-icon-light { display: none; }
:root[data-theme="hacker"] .theme-icon-dark  { display: inline-block; }

.report-btn {
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: 600;
  text-decoration: none;
  border: 1px solid var(--color-primary);
  background: rgba(var(--color-primary-rgb, 59, 130, 246), 0.08);
  color: var(--color-primary);
  border-radius: var(--radius-full);
  transition: background-color var(--duration-fast) var(--ease-default), color var(--duration-fast) var(--ease-default), border-color var(--duration-fast) var(--ease-default);
}

.report-btn:hover {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.resume-btn {
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: 600;
  text-decoration: none;
  border: 1px solid var(--color-primary);
  color: var(--color-primary);
  border-radius: var(--radius-full);
  transition: background-color var(--duration-fast), color var(--duration-fast);
}

.resume-btn:hover {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

/* Mobile Menu Button */
.mobile-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  background: transparent;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 10px;
  cursor: pointer;
}

.mobile-menu-btn[aria-expanded="true"] .hamburger-bar:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.mobile-menu-btn[aria-expanded="true"] .hamburger-bar:nth-child(2) {
  opacity: 0;
}

.mobile-menu-btn[aria-expanded="true"] .hamburger-bar:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

.hamburger-bar {
  width: 100%;
  height: 2px;
  background: var(--color-text);
  border-radius: 1px;
  transition: transform var(--duration-fast) var(--ease-default), opacity var(--duration-fast) var(--ease-default), background-color var(--duration-fast) var(--ease-default);
}

/* Mobile Drawer */
.mobile-drawer {
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-4) var(--space-6);
  animation: slideDown var(--duration-fast) var(--ease-out);
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

.mobile-nav {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.mobile-nav-item {
  color: var(--color-text);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 600;
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
}

.mobile-nav-item[aria-current="page"] {
  color: var(--color-primary);
}

.mobile-nav-item:last-child {
  border-bottom: none;
}

.mobile-resume {
  color: var(--color-primary);
}

@media (max-width: 860px) {
  .mobile-menu-btn {
    display: flex;
  }
  .desktop-only {
    display: none;
  }
}

@media (max-width: 720px) {
  .header-inner {
    padding-inline: var(--space-4);
    gap: var(--space-2);
  }
  .header-actions {
    gap: var(--space-2);
  }
  .persona-switch {
    display: none;
  }
  .brand-tag {
    display: none;
  }
  .brand-name {
    font-size: var(--text-sm);
  }
}
</style>
