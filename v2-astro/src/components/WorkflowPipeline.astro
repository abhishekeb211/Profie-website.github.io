---
// src/components/WorkflowPipeline.astro
// Executive Engineering Pipeline: Continuous illuminated SVG circuit replacing ASCII arrows
// Responsive: Horizontal illuminated bus on desktop -> Vertical continuous rail on mobile

interface PipelineStep {
  num: string;
  title: string;
  tag: string;
  desc: string;
  accent: string;
  glow: string;
  tint: string;
  border: string;
}

const steps: PipelineStep[] = [
  {
    num: "01",
    title: "Identify Problem",
    tag: "Friction Analysis",
    desc: "Focus on real-world friction: cloud leaks, emergency map occlusions, or vehicle packet loss.",
    accent: "#F59E0B",
    glow: "rgba(245, 158, 11, 0.28)",
    tint: "rgba(245, 158, 11, 0.08)",
    border: "rgba(245, 158, 11, 0.35)",
  },
  {
    num: "02",
    title: "Research & Math",
    tag: "Algorithmic Novelty",
    desc: "Formulate algorithmic novelties: decoupled quad-branch attention or Lipschitz bounds.",
    accent: "#8B5CF6",
    glow: "rgba(139, 92, 246, 0.28)",
    tint: "rgba(139, 92, 246, 0.08)",
    border: "rgba(139, 92, 246, 0.35)",
  },
  {
    num: "03",
    title: "Build & Prototype",
    tag: "Deterministic Core",
    desc: "Implement in C++20, Python, and local AI engines with strict memory and power ceilings.",
    accent: "#06B6D4",
    glow: "rgba(6, 182, 212, 0.28)",
    tint: "rgba(6, 182, 212, 0.08)",
    border: "rgba(6, 182, 212, 0.35)",
  },
  {
    num: "04",
    title: "Verify & Audit",
    tag: "Forensic Gates",
    desc: "Run rigorous automated regression suites (708 passing checks, hardware test benches).",
    accent: "#F43F5E",
    glow: "rgba(244, 63, 94, 0.28)",
    tint: "rgba(244, 63, 94, 0.08)",
    border: "rgba(244, 63, 94, 0.35)",
  },
  {
    num: "05",
    title: "Deploy & Mentor",
    tag: "Real Impact",
    desc: "Ship field pilots, open-source repositories, and mentor student engineers on the codebase.",
    accent: "#10B981",
    glow: "rgba(16, 185, 129, 0.28)",
    tint: "rgba(16, 185, 129, 0.08)",
    border: "rgba(16, 185, 129, 0.35)",
  },
];
---

<div class="pipeline-circuit-container" aria-label="5-Stage Research-to-Impact Pipeline">
  <!-- Desktop Continuous SVG Circuit Rail -->
  <div class="desktop-rail-wrap" aria-hidden="true">
    <svg class="desktop-rail-svg" viewBox="0 0 1000 48" preserveAspectRatio="none">
      <defs>
        <linearGradient id="pipeline-rail-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#F59E0B" />
          <stop offset="25%" stop-color="#8B5CF6" />
          <stop offset="50%" stop-color="#06B6D4" />
          <stop offset="75%" stop-color="#F43F5E" />
          <stop offset="100%" stop-color="#10B981" />
        </linearGradient>
        <filter id="rail-glow" x="-20%" y="-50%" width="140%" height="200%">
          <feGaussianBlur stdDeviation="3" result="glow" />
          <feMerge>
            <feMergeNode in="glow" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Background Ambient Rail Guide -->
      <path d="M 60 24 L 940 24" class="rail-path-bg" />

      <!-- Glowing Illuminated Gradient Bus Wire -->
      <path d="M 60 24 L 940 24" class="rail-path-glow" filter="url(#rail-glow)" />

      <!-- Junction Pins aligned with step centers (100, 300, 500, 700, 900) -->
      <circle cx="100" cy="24" r="5" class="junction-dot junction-1" />
      <circle cx="300" cy="24" r="5" class="junction-dot junction-2" />
      <circle cx="500" cy="24" r="5" class="junction-dot junction-3" />
      <circle cx="700" cy="24" r="5" class="junction-dot junction-4" />
      <circle cx="900" cy="24" r="5" class="junction-dot junction-5" />

      <!-- Traveling Data Energy Packets -->
      <circle r="4" class="traveling-packet packet-primary">
        <animateMotion path="M 60 24 L 940 24" dur="4.2s" repeatCount="indefinite" />
      </circle>
      <circle r="3" class="traveling-packet packet-secondary">
        <animateMotion path="M 60 24 L 940 24" dur="4.2s" begin="2.1s" repeatCount="indefinite" />
      </circle>
    </svg>
  </div>

  <!-- Interactive Step Cards Grid (Desktop Horizontal, Mobile Vertical Timeline) -->
  <div class="pipeline-steps-grid">
    {steps.map((stg, idx) => (
      <div 
        class={`pipeline-step-card step-${idx + 1}`} 
        style={`--step-accent: ${stg.accent}; --step-glow: ${stg.glow}; --step-tint: ${stg.tint}; --step-border: ${stg.border};`}
      >
        <!-- Top Visual Node Anchor (Desktop) / Left Indicator (Mobile) -->
        <div class="step-node-anchor">
          <div class="step-orb-ring">
            <span class="step-num-text">{stg.num}</span>
          </div>
          <div class="step-anchor-stem" aria-hidden="true"></div>
        </div>

        <!-- Card Content Body -->
        <div class="step-card-body">
          <div class="step-header-meta">
            <span class="step-tag-pill">{stg.tag}</span>
          </div>
          <h3 class="step-card-title">{stg.title}</h3>
          <p class="step-card-desc">{stg.desc}</p>
        </div>

        <!-- Subtle Bottom Luminous Reflection Line -->
        <div class="step-accent-edge" aria-hidden="true"></div>
      </div>
    ))}
  </div>
</div>

<style>
.pipeline-circuit-container {
  position: relative;
  width: 100%;
  margin-top: var(--space-8);
}

/* ─── DESKTOP RAIL ──────────────────────────────────────────────────────── */
.desktop-rail-wrap {
  position: relative;
  width: 100%;
  height: 48px;
  margin-bottom: -18px;
  z-index: 1;
}

.desktop-rail-svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.rail-path-bg {
  stroke: var(--color-border);
  stroke-width: 3;
  stroke-linecap: round;
  fill: none;
}

.rail-path-glow {
  stroke: url(#pipeline-rail-grad);
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-dasharray: 6 3;
  fill: none;
  animation: railPulse 12s linear infinite;
}

@keyframes railPulse {
  to { stroke-dashoffset: -108; }
}

.junction-dot {
  stroke-width: 2.5;
  fill: var(--color-surface);
}
.junction-1 { stroke: #F59E0B; }
.junction-2 { stroke: #8B5CF6; }
.junction-3 { stroke: #06B6D4; }
.junction-4 { stroke: #F43F5E; }
.junction-5 { stroke: #10B981; }

.traveling-packet {
  fill: #FFFFFF;
  filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.9));
}
.packet-secondary {
  fill: #F59E0B;
  filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.8));
}

/* ─── STEP CARDS GRID (DESKTOP) ─────────────────────────────────────────── */
.pipeline-steps-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-4);
  position: relative;
  z-index: 2;
}

.pipeline-step-card {
  position: relative;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  padding: var(--space-5) var(--space-4) var(--space-4);
  transition: transform var(--duration-base) var(--ease-out),
              box-shadow var(--duration-base) var(--ease-out),
              border-color var(--duration-base) var(--ease-out);
  overflow: hidden;
}

.pipeline-step-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-card-elevated), 0 0 20px var(--step-glow);
  border-color: var(--step-border);
}

/* Node Orb Anchor */
.step-node-anchor {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-3);
}

.step-orb-ring {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 2px solid var(--step-accent);
  box-shadow: 0 0 12px var(--step-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.pipeline-step-card:hover .step-orb-ring {
  transform: scale(1.1);
  box-shadow: 0 0 18px var(--step-glow);
  background: var(--step-tint);
}

.step-num-text {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: 800;
  color: var(--step-accent);
  letter-spacing: -0.02em;
}

.step-anchor-stem {
  width: 2px;
  height: 8px;
  background: var(--step-border);
  margin-top: 4px;
}

/* Card Body */
.step-card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-header-meta {
  margin-bottom: var(--space-2);
}

.step-tag-pill {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  color: var(--step-accent);
  background: var(--step-tint);
  border: 1px solid var(--step-border);
}

.step-card-title {
  font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem);
  font-weight: 700;
  color: var(--color-text);
  margin: 0 0 var(--space-2) 0;
  line-height: 1.3;
}

.step-card-desc {
  font-size: 0.85rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin: 0;
  flex: 1;
}

/* Subtle Edge Accent */
.step-accent-edge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--step-accent);
  opacity: 0.4;
  transition: opacity var(--duration-fast) var(--ease-out),
              height var(--duration-fast) var(--ease-out);
}

.pipeline-step-card:hover .step-accent-edge {
  opacity: 1;
  height: 4px;
  box-shadow: 0 0 10px var(--step-glow);
}

/* ─── RESPONSIVE: MOBILE VERTICAL TIMELINE CIRCUIT (<= 768px) ─────────────── */
@media (max-width: 900px) {
  .pipeline-steps-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .desktop-rail-wrap {
    display: none;
  }
}

@media (max-width: 640px) {
  .pipeline-steps-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    padding-left: var(--space-8);
  }

  /* Vertical Bus Rail on Mobile */
  .pipeline-steps-grid::before {
    content: "";
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 17px;
    width: 3px;
    background: linear-gradient(180deg, #F59E0B 0%, #8B5CF6 25%, #06B6D4 50%, #F43F5E 75%, #10B981 100%);
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
  }

  .pipeline-step-card {
    padding: var(--space-4);
    overflow: visible;
  }

  .step-node-anchor {
    position: absolute;
    left: calc(-1 * var(--space-8) + 1px);
    top: 20px;
    margin-bottom: 0;
  }

  .step-orb-ring {
    width: 34px;
    height: 34px;
    background: var(--color-surface);
  }

  .step-num-text {
    font-size: 0.75rem;
  }

  .step-anchor-stem {
    display: none;
  }
}

/* ─── ACCESSIBILITY: REDUCED MOTION ─────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .rail-path-glow {
    animation: none;
  }
  .traveling-packet {
    display: none;
  }
  .pipeline-step-card,
  .step-orb-ring,
  .step-accent-edge {
    transition: none !important;
  }
}
</style>
