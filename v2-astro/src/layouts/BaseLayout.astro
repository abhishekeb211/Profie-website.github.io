---
// BaseLayout.astro — shared shell for all Atlas v2.2 pages and personas
// Props:
//   title: page <title>
//   description: meta description
//   persona: 'architect' | 'professor'
//   ogImage: OG image path (optional)

import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  persona?: 'architect' | 'professor';
  ogImage?: string;
}

const { title, description, persona = 'architect', ogImage } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = ogImage ?? `${base}/images/og-${persona}.png`;
---
<!doctype html>
<html lang="en-IN" data-persona={persona}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />

  <!-- Client-side navigation & route transitions -->
  <ClientRouter />

  <!-- No-flash parser-blocking theme bootstrap — loaded before CSS -->
  <script is:inline>
    (() => {
      const KEY = 'atlas-theme-preference';
      const root = document.documentElement;
      const query = matchMedia('(prefers-color-scheme: dark)');
      let override = null;
      const valid = value => value === 'light' || value === 'dark';
      try {
        const saved = localStorage.getItem(KEY);
        if (valid(saved)) override = saved;
      } catch (_) { /* storage may be unavailable */ }

      const apply = () => {
        const resolved = override || (query.matches ? 'dark' : 'light');
        root.dataset.theme = resolved;
        root.dataset.themePreference = override || 'system';
        root.style.colorScheme = resolved;
        root.dispatchEvent(new CustomEvent('atlas:theme-applied', {
          detail: { theme: resolved, preference: override || 'system' }
        }));
      };
      apply();
      query.addEventListener?.('change', () => { if (!override) apply(); });
      addEventListener('storage', event => {
        if (event.key !== KEY) return;
        override = valid(event.newValue) ? event.newValue : null;
        apply();
      });
      addEventListener('atlas:theme-selection', event => {
        const next = event.detail;
        if (next !== 'system' && !valid(next)) return;
        override = valid(next) ? next : null;
        try {
          if (override) localStorage.setItem(KEY, override);
          else localStorage.removeItem(KEY);
        } catch (_) { /* apply in memory anyway */ }
        apply();
      });
    })();
  </script>

  <!-- Theme color synced to active theme -->
  <meta name="theme-color" content="#FFFFFF" id="meta-theme-color" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(defaultOgImage, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(defaultOgImage, Astro.site)} />

  <!-- JSON-LD Person -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Abhishek S. Raut",
    "jobTitle": "AI Research Engineer",
    "email": "mailto:abhishek.raut@pccoepune.org",
    "url": "https://abhishekeb211.github.io/Profie-website.github.io/",
    "sameAs": [
      "https://www.linkedin.com/in/abhishek-raut-087138171/",
      "https://github.com/abhishekeb211"
    ]
  }
  </script>

  <!-- Styles -->
  <link rel="stylesheet" href={`${base}/styles/tokens.css`} />
  <link rel="stylesheet" href={`${base}/styles/motion.css`} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

  <!-- Sitemap -->
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
</head>
<body>
  <!-- Skip navigation -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <slot name="header" />

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <slot name="footer" />

  <!-- Theme + motion controllers with ClientRouter lifecycle management -->
  <script>
    import { initTheme, syncThemeControls } from '../scripts/theme.ts';
    import { initScrollReveals, initCountUps, initAmbientCanvas, cleanupMotion } from '../scripts/reveals.js';

    function setupPage() {
      initTheme();
      syncThemeControls();
      initScrollReveals();
      initCountUps();
      initAmbientCanvas();
    }

    // Initial setup on boot
    setupPage();

    // Re-initialize interactive effects when navigating via ClientRouter
    document.addEventListener('astro:page-load', () => {
      setupPage();
    });

    // Clean up observers and rAF loops before DOM swap
    document.addEventListener('astro:before-swap', () => {
      cleanupMotion();
    });
  </script>
</body>
</html>
